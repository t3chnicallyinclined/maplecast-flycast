# MapleCast Node — flycast headless + relay in one container
#
# Build:   docker build -f Dockerfile.node -t maplecast-node:latest .
# Run:     docker run -d --shm-size=1g -p 7201:7201/tcp -p 7100:7100/udp \
#            -v /path/to/mvc2-folder:/data:ro \
#            -v maplecast-node:/opt/maplecast/.maplecast \
#            ghcr.io/t3chnicallyinclined/maplecast-node:latest
#
# The ROM folder must hold the .gdi + its track files + a Dreamcast BIOS
# (dc_boot.bin). --shm-size=1g is required (flycast maps memory via /dev/shm).
#
# OVERKILL IS NECESSARY.

# ─── Stage 1: build flycast headless ───
FROM debian:12-slim AS flycast-build
RUN apt-get update && apt-get install --no-install-recommends -y \
        build-essential cmake ninja-build git pkg-config \
        libcurl4-openssl-dev libssl-dev libzip-dev zlib1g-dev \
        libxdp-dev libbpf-dev libelf-dev libudev-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN cmake -B build-headless -G Ninja \
        -DMAPLECAST_HEADLESS=ON -DCMAKE_BUILD_TYPE=Release -DUSE_HOST_LIBZIP=ON \
    && cmake --build build-headless -- -j"$(nproc)" \
    && strip build-headless/flycast && ls -lh build-headless/flycast

# ─── Stage 2: build relay ───
FROM rust:1-slim AS relay-build
RUN apt-get update && apt-get install --no-install-recommends -y pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src/relay
COPY relay/ .
RUN cargo build --release && strip target/release/maplecast-relay

# ─── Stage 3: runtime ───
FROM debian:12-slim
RUN apt-get update && apt-get install --no-install-recommends -y \
        libcurl4 libssl3 libstdc++6 libgmp10 libzstd1 libzip4 zlib1g libgomp1 \
        ca-certificates netcat-openbsd \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --home-dir /opt/maplecast --shell /usr/sbin/nologin maplecast
COPY --from=flycast-build /src/build-headless/flycast /usr/local/bin/flycast
COPY --from=relay-build /src/relay/target/release/maplecast-relay /usr/local/bin/maplecast-relay
COPY deploy/node-entrypoint.sh /usr/local/bin/node-entrypoint.sh
RUN chmod +x /usr/local/bin/node-entrypoint.sh /usr/local/bin/flycast /usr/local/bin/maplecast-relay \
    && mkdir -p /opt/maplecast/savestates /opt/maplecast/cfg \
                /opt/maplecast/.local/share/flycast /opt/maplecast/.maplecast /data \
    && chown -R maplecast:maplecast /opt/maplecast
USER maplecast
WORKDIR /opt/maplecast
ENV MAPLECAST=1 MAPLECAST_MIRROR_SERVER=1 MAPLECAST_HEADLESS=1 \
    MAPLECAST_PORT=7100 MAPLECAST_SERVER_PORT=7200 \
    XDG_CONFIG_HOME=/opt/maplecast/cfg HOME=/opt/maplecast
EXPOSE 7100/udp 7200/tcp 7201/tcp 7202/tcp
ENTRYPOINT ["/usr/local/bin/node-entrypoint.sh"]
CMD ["/data/mvc2.gdi"]
