-- 114: RECEIPT RUNNER GATE 1 -- the NATIVE runner (mvc-live-skins-quarters/d3dcap/receipt/runner/rr_runner.cpp) ticks the real
-- Steam MvC2 sim tick FUN_140118950 on the dump_live/anchor images at their live addresses (Delta = 0) and is BYTE-EXACT
-- against the p-code harness (emu_frame.py / EmuGate.java) on blk after every tick: 20 idle ticks + 60 and 300 real-input
-- ticks (stage 9 offline receipt run receipt-20260903-stage9-anchor, clock 1716). Timing ~0.08 ms per tick (budget 16.7 ms).
-- Source doc: mvc-live-skins-quarters/docs/RECEIPT-RUNNER-GATE1.md. Corrections to 111/112 carried below (TlsSetValue slot,
-- UCRT lazy-resolver cache, host device object). Apply with tools/re_kb/apply_seed.py (per statement) after the README export
-- backup. Idempotent: UPSERT for nodes, RELATE with explicit edge ids. No apostrophes inside string literals.
-- Do NOT re-run 07_dedup_edges.surql afterwards.
USE NS re DB kb;

UPSERT source:receipt_runner_gate1_20260903 SET kind='measurement', strength='reproduction', ref='mvc-live-skins-quarters/d3dcap/receipt/runner/{rr_runner.cpp,runner_gate.py}; run d3dcap/ttd/runs/receipt-20260903-stage9-anchor (gitignored); oracle dumps %TEMP%/rrcap_emu/multitick_stage9_20.* and receipt_receipt-20260903-stage9-anchor_1716_{60,300}.*; runner dumps %TEMP%/rrcap_runner/*', note='Native x64 process maps exe_image.bin at 0x140000000 (section-table protections), reserves the 256 MiB arena at game_state+0 (0x07FC1000), restores blk/blk2/ctx/dcram, replaces the 5 IAT slots + 2 UCRT cached pointers the tick calls, traps the other 252 import slots and 4 cached pointers, forces the seat map {0,1,-1,-1}, ticks FUN_140118950(&DAT_142d10b90, inputs, 0). Gate: blk after tick k == harness dump k byte for byte: idle 20/20, tape inputs 60/60 and 300/300. One-variable variants gs=anchor page, DAT_142eefbd8=1, whole-image RWX: all 300/300. Same-boot export resolution named every dumped IAT value (kernel32/ntdll/KERNELBASE bases are per boot).';

-- routines (roles CONFIRMED by disassembly + the byte gate)
UPSERT steam_routine:FUN_140820798 SET addr='0x140820798', name='FUN_140820798', role='UCRT try_get_function: lazy WinAPI resolver with an encoded pointer cache at 0x142eefca0 + id*8 (encode = rol(p, cookie & 0x3f) ^ cookie, cookie = __security_cookie 0x140ab12d8; decoded -1 = unavailable, 0 = not yet resolved; resolves via LoadLibrary/GetProcAddress through IAT slots when 0). Module handle cache at 0x142eefc00 + mid*8.', note='CONFIRMED by disassembly 2026-09-03. On the tick path only ids 5 (FlsGetValue, caller 0x140820b80) and 6 (FlsSetValue, caller 0x140820bd8) are used; the image also caches 3 FlsAlloc, 15 GetSystemTimePreciseAsFileTime, 20 InitializeCriticalSectionEx, 22 LCMapStringEx. The runner rewrites entries 5/6 to its own functions (re-encoded) and traps the rest.', matched=false;
UPSERT steam_routine:FUN_140820b80 SET addr='0x140820b80', name='FUN_140820b80', role='UCRT __acrt_FlsGetValue thunk: try_get_function(5) then call the cached pointer (0x140820bbe: call rdi), fallback TlsGetValue via IAT.', note='CONFIRMED by disassembly 2026-09-03; the trace kind-3 record at return 0x140820bc0 is this call (not an IAT call).', matched=false;
UPSERT steam_routine:FUN_140820bd8 SET addr='0x140820bd8', name='FUN_140820bd8', role='UCRT __acrt_FlsSetValue thunk: try_get_function(6) then call the cached pointer (0x140820c21: call rsi), fallback TlsSetValue via IAT slot 0x1408db218.', note='CONFIRMED by disassembly 2026-09-03; under the harness extstub the cached call returns 0 (FlsSetValue fails) so the CRT frees its fresh ptd -> the 4x HeapFree per frame; with a REAL FlsSetValue the CRT continues ptd initialisation and calls ntdll!RtlEnterCriticalSection through IAT slot 0x1408db190 from RVA 0x81e478 (runner --crt real trapped it at tick 1) -- the sprintf path must be stubbed, not emulated, or the C6 import set grows.', matched=false;
UPSERT steam_routine:FUN_14004d400 SET addr='0x14004d400', name='FUN_14004d400', role='PAL4 -> 32-bit expansion loop (each 4-bit nibble * 0x11 into a byte lane) writing into the NaomiLib host device object (PALETTE_RAM at dev+0xD8D04); reached from FUN_1408456a0 <- 0x140612685 (texture slot fill after FUN_140845fa0 slot search).', note='INFERRED role (loop body read; the write target 0x2a2b5154 = *(0x140acd3a8) + 0xD9144 = PALETTE_RAM + 0x440 on the stage-9 anchor frame). Not executed on the traced training-stage idle frame; executed on tick 1 of the stage-9 receipt. The runner backs the page lazily with zero memory (the harness sparse-memory model) and the blk gate still passes 300/300: render-side, write-only from the tick.', matched=false;

-- globals
UPSERT global:iat_slot_1408db218 SET addr='0x1408db218', steam_off='0x1408db218', type='IAT qword', note='CORRECTION to 111 / emu_frame.CRT_SLOTS: this slot is kernel32!TlsSetValue (same-boot export resolution of the dumped value 0x7ffc8a9d8040), NOT FlsSetValue. The harness extret on it never fired (trace kind-3 records show no call through it). CONFIRMED 2026-09-03.';
UPSERT global:iat_tick_set SET addr='0x1408db000', steam_off='0x1408db000..0x1408db880', type='IAT (257 qwords)', note='THE IMPORT SET OF THE SIM TICK (contract C6, CONFIRMED by kind-3 trace records + 300 native ticks with every other slot trapped): RtlAllocateHeap *0x1408db240 (ntdll), RtlReAllocateHeap *0x1408db140 (never called), HeapFree *0x1408db238 (kernel32), GetLastError *0x1408db2d8, SetLastError *0x1408db510; plus FlsGetValue/FlsSetValue through the UCRT cache 0x142eefca0[5]/[6]. 252 other slots + 4 other cached pointers trapped: 0 hits over 380 ticks.';
UPSERT global:ucrt_function_cache SET addr='0x142eefca0', steam_off='0x142eefca0', type='u64[32] encoded pointers', note='UCRT try_get_function cache (FUN_140820798). Live entries: 3 FlsAlloc, 5 FlsGetValue, 6 FlsSetValue, 15 GetSystemTimePreciseAsFileTime, 20 InitializeCriticalSectionEx, 22 LCMapStringEx (KERNELBASE). Process-specific: a loader must rewrite 5 and 6. CONFIRMED 2026-09-03.';
UPSERT global:naomi_host_device SET addr='0x140acd3a8', steam_off='0x140acd3a8', type='ptr', note='Host heap object pointer (0x2a1dc010 in the stage-9 dump; emu_frame labels it session ptr -- the label is INFERRED wrong: the tick writes PALETTE_RAM at +0xD8D04 (FUN_140613390 palrows upload, PALETTE-SOURCE) through it). Process-specific heap object, WRITE-ONLY from the tick on 300 stage-9 ticks (a zero page suffices for a byte-exact blk). Size UNKNOWN. Other .data pointers into the same 64 KiB page: 0x140ad3b30, 0x140bd3bb8.';
UPSERT global:ctx_pagetable_uninit_field SET addr='ctx+0x108FC0..0x116000', steam_off='ctx+0x10DE24 / ctx+0x10E5CC (0x130-B records)', type='u32 fields', note='Beyond-blk residual of Gate 1: after 300 ticks the runner and the harness differ in 86 dwords of the ctx texture-page-table area (record stride 0x130, fields +0x6C / +0x114), harness 0, runner a run-varying value; the live image holds floats there. Not read by the traced tick; blk/gs/exe_dat/exe_str/ggpo identical. MECHANISM CONFIRMED by the stage-9 traced tick: the records are memcpy-d (0x14080062e, 95 records x 0x130 B) from a STACK buffer (harness stack 0x313fed40..0x313feebf) whose fields +0x6C/+0x114 hold stale stack content -- zero in the zero-filled harness, leftover values natively and floats in the live image. Never read by the tick. DETERMINISM s5.2 (uninitialised stack on a real-stage frame): reaches ctx render-side records, not blk.';

-- findings
UPSERT finding:runner_gate1_byte_exact SET status='confirmed', text='Native runner blk after k ticks == p-code harness dump k byte for byte: idle 20/20 (clock 1716->1736), tape inputs 60/60 and 300/300 (clock 1716->2016); gs page, exe 0x142edf300 page, sprintf scratch and GGPO counter identical after 300 ticks. Per tick 0.04-0.24 ms (p50 0.08 ms) vs the harness 3-7 s and the 16.7 ms real-time budget.';
UPSERT finding:runner_gs_page_irrelevant SET status='confirmed', text='The 23 bytes by which the tape anchor game_state page differs from the exe-embedded (post-match) page (+0x280, +0x520, +0x530, +0x578/57C, +0x598/59C, +0x5E8/5EC, +0x768, +0x778, +0x780, +0x798, +0x7AC/7B0, +0x7D0, +0x7DC..7E4) do not reach blk: --gs file vs --gs exe both 300/300 byte-exact.';
UPSERT finding:runner_fma_flag_irrelevant SET status='confirmed', text='DAT_142eefbd8 = 1 (FMA3 CRT path, native) gives the same 300 blk dumps as the harness SSE2 path: contract C3 holds on the whole tick, not only on the CRT routines in isolation.';
UPSERT finding:runner_real_fls_falsified SET status='confirmed', text='Providing a working FlsGetValue/FlsSetValue (RECEIPT-RUNNER-RE s3.1 design) makes the UCRT continue its ptd initialisation and call RtlEnterCriticalSection (IAT 0x1408db190 from RVA 0x81e478) on tick 1: the import set is only C6-sized under the stub semantics (Fls* -> 0). Runner default = stub.';
UPSERT finding:runner_host_heap_objects SET status='confirmed', text='On the stage-9 anchor frame the tick writes one host-heap page of the dumping process through *(0x140acd3a8) (PALETTE_RAM upload, FUN_14004d400 loop); the traced training-stage idle frame touched only the debug ring *(DAT_142ebc010). The runner reproduces the harness sparse-memory model by lazy zero-commit on first touch, logged per page with the touching PC; a --lazy off run reports the exact site (RIP 0x14004d460, WRITE 0x2a2b5154, caller 0x14061268a).';
UPSERT finding:multitick_job_register_bug SET status='confirmed', text='determinism_gate.py multitick set RCX/RDX/R8 only before the first run; EmuGate run keeps registers, so runs 2..N ticked with stale RCX/RDX (GGPO counter ended at 1 after 20 runs, inputs read from sparse zero memory = idle by accident). blk dumps were still correct (counter is wrapper-only). Fixed 2026-09-03 (registers re-set before every run).';

-- edges
RELATE steam_routine:FUN_140820b80->calls->steam_routine:FUN_140820798 SET id=calls:FUN_140820b80_FUN_140820798, note='id 5 FlsGetValue';
RELATE steam_routine:FUN_140820bd8->calls->steam_routine:FUN_140820798 SET id=calls:FUN_140820bd8_FUN_140820798, note='id 6 FlsSetValue';
RELATE steam_routine:FUN_140820798->reads->global:ucrt_function_cache SET id=reads:FUN_140820798_ucrt_function_cache;
RELATE steam_routine:FUN_14004d400->writes->global:naomi_host_device SET id=writes:FUN_14004d400_naomi_host_device, note='PALETTE_RAM +0xD8D04.. (INFERRED)';
RELATE finding:runner_gate1_byte_exact->cites->source:receipt_runner_gate1_20260903 SET id=cites:runner_gate1_byte_exact_src;
RELATE finding:runner_gs_page_irrelevant->cites->source:receipt_runner_gate1_20260903 SET id=cites:runner_gs_page_irrelevant_src;
RELATE finding:runner_fma_flag_irrelevant->cites->source:receipt_runner_gate1_20260903 SET id=cites:runner_fma_flag_irrelevant_src;
RELATE finding:runner_real_fls_falsified->cites->source:receipt_runner_gate1_20260903 SET id=cites:runner_real_fls_falsified_src;
RELATE finding:runner_host_heap_objects->cites->source:receipt_runner_gate1_20260903 SET id=cites:runner_host_heap_objects_src;
RELATE finding:multitick_job_register_bug->cites->source:receipt_runner_gate1_20260903 SET id=cites:multitick_job_register_bug_src;
RELATE finding:runner_real_fls_falsified->about->steam_routine:FUN_140820bd8 SET id=about:runner_real_fls_falsified_FUN_140820bd8;
RELATE finding:runner_host_heap_objects->about->global:naomi_host_device SET id=about:runner_host_heap_objects_naomi_host_device;
RELATE finding:runner_gate1_byte_exact->about->global:iat_tick_set SET id=about:runner_gate1_byte_exact_iat_tick_set;
