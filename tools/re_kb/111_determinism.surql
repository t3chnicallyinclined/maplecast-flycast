-- 111: DETERMINISM CONTRACT -- what a host must preserve so that the Steam MvC2 frame function FUN_140607d60 (via the GGPO
-- tick FUN_140118950) produces the same bytes everywhere. Measured 2026-09-03 on the live dump_live images
-- d3dcap/ttd/runs/20260903-000941/pre (offline match, clock 2239, roster cids 42/52/44/23/52/53) with the p-code harness
-- (emu_gate.py / emu_frame.py / EmuGate.java + new commands fma, probe, nudge), d3dcap/replay/determinism_gate.py
-- (perturb / multitick / native / dispatch) and d3dcap/replay/receipt_gate.py. Source doc:
-- mvc-live-skins-quarters/docs/DETERMINISM-CONTRACT.md. Apply with tools/re_kb/apply_seed.py (per statement) after the
-- README export backup. Idempotent: UPSERT for nodes, RELATE with explicit edge ids. No apostrophes inside string literals.
-- Do NOT re-run 07_dedup_edges.surql afterwards (it strips confidence/evidence from edges).
USE NS re DB kb;

UPSERT source:determinism_gate_20260903 SET kind='ghidra', strength='code', ref='mvc-live-skins-quarters/d3dcap/replay/determinism_gate.py + receipt_gate.py + re_map/ghidra_emu/EmuGate.java (fma/probe/nudge); images d3dcap/ttd/runs/20260903-000941/pre (gitignored); results %TEMP%/rrcap_emu/pert_*.result.txt', note='One-variable-per-run perturbation of every location the tick FUN_140118950 reads before it writes outside blk (classification of the 313,754-record access trace by first access), 20 consecutive emulated ticks, a native oracle that maps the exe image at its link base inside a Python process and calls the game CRT tanf/sinf/cosf/atanf/sqrtf/floorf/powf with DAT_142eefbd8 = 0 and = 1 (bitwise compare, dispatch proven with a UD2 patch), stack pre-fill 0xCC, and the receipt gate tool. Results in docs/DETERMINISM-CONTRACT.md.';

-- routines
UPSERT steam_routine:FUN_14060fa40 SET addr='0x14060fa40', name='FUN_14060fa40', role='THE STEAM SIM RNG (16-bit draw): state = 2 bytes blk+0x32BD4 (hi) / blk+0x32BD5 (lo); two steps of x = hi*256+lo; c = (3x)>>8; lo += c; hi = c; returns ((lo_prev<<8)|lo) & 0x7FFF. 75 callers / 203 call sites (character programs, effects, AI). NOT the DC LCG.', note='CONFIRMED by decompile 2026-09-03 (reads/writes only blk+0x32BD4/5). Pairing with the DC Rng_function loc_8c11e730: FUN_1407491d0 <-> loc_8c10235c (map high) loads r9 = Rng_function and calls it four times; FUN_1407491d0 calls FUN_14060fa40 four times. The generator ALGORITHM differs from the DC LCG (s*0x41C64E6D+0x3039 >>16 &0x7FFF at 0x8C16BC2C); the DC LCG survives on Steam only as the dead object of FUN_1400298c0. The previous map pair FUN_14060fa40 <-> loc_8c1294c8 (low) is wrong.', matched=true, sh4_pair='loc_8c11e730', sh4_conf='confirmed';
UPSERT steam_routine:FUN_14060f990 SET addr='0x14060f990', name='FUN_14060f990', role='8-bit RNG draw on the same state blk+0x32BD4/5: one step, returns lo. ~300 call sites, mostly character-program caseD_* handlers.', note='CONFIRMED by decompile 2026-09-03. The map pair FUN_14060f990 <-> loc_8c05c02e (high) is wrong: loc_8c05c02e takes three arguments and indexes a table.', matched=true, sh4_pair='loc_8c11e730', sh4_conf='inferred';
UPSERT steam_routine:FUN_14060fae0 SET addr='0x14060fae0', name='FUN_14060fae0', role='float RNG draw: FUN_14060fa40-style 15-bit draw converted to float and divided by DAT_140926114 (= DC loc_8C11E750: bsr Rng_function; float; fmul const).', note='CONFIRMED by decompile 2026-09-03; pair by structure.', matched=true, sh4_pair='loc_8C11E750', sh4_conf='high';
UPSERT steam_routine:FUN_14060f9e0 SET addr='0x14060f9e0', name='FUN_14060f9e0', role='RNG seeder: writes blk+0x32BD4 = 1, blk+0x32BD5 = 0xC3 (= DC loc_8C11E770 srand(1) writing RngVal = 1). One caller: caseD_0 <-> loc_8c075fe8 (low).', note='CONFIRMED by decompile 2026-09-03.', matched=true, sh4_pair='loc_8C11E770', sh4_conf='high';
UPSERT steam_routine:FUN_1400298c0 SET addr='0x1400298c0', name='FUN_1400298c0', role='static initialiser of a DEAD parameterised LCG object at 0x140a5c7d8: InitializeCriticalSection(0x140a5c7d8) then state 0x140a5c800 = 1, A 0x140a5c804 = 0x41C64E6D, C 0x140a5c808 = 0x3039, shift 0x140a5c80c = 0x10, mask 0x140a5c810 = 0x7FFF, then atexit(0x1408d7980). The DC Rng_function constants survive here and nowhere else.', note='CONFIRMED 2026-09-03: byte-level RIP-relative scan of the whole image finds no reference to 0x140a5c7d8..0x140a5c814 besides this initialiser and the atexit thunk; no pointer to the object in exe/ctx/game_state/blk/blk2; live state still 1 at clock 2239. Not on the sim path.', matched=false;
UPSERT steam_routine:FUN_140611f70 SET addr='0x140611f70', name='FUN_140611f70', role='animation-script stepper: fighter+0x186 (anim_timer)--; at zero advances the 8-byte script pointer fighter+0x198 inside the PL image (jump when byte 0x80: ptr = *(fighter+0x1C0) + offset), latches the record at fighter+0x184, clears +0x18C/+0x194. The record it read this frame lives at PL slot +0x137B94 (loader-built tail beyond the AFS entry).', note='CONFIRMED by decompile + trace 2026-09-03; perturbing that 8-byte record changes 28 blk bytes (node anim timers +0x184..0x18B, depth +0x12C, G+0x24, blk+0x6D1C): the PL images are sim input.', matched=false;
UPSERT steam_routine:FUN_1406163e0 SET addr='0x1406163e0', name='FUN_1406163e0', role='29-case HUD texture re-upload state machine on two exe bytes: 0x142edf543 = pending flag, 0x142edf546 = step; re-uploads slots 0x811/0x816/0x817/0x81B/0x81C/0x81D from DC 0x0CDD0000 / 0x0CDF4800 / G+0x94 via FUN_140845830.', note='CONFIRMED by decompile 2026-09-03; perturbing 0x142edf543 changes no blk byte (render only). Resolves the UNKNOWN role of 0x142edf543/546 in FRAME-READSET.', matched=false;
UPSERT steam_routine:FUN_14060b7d0 SET addr='0x14060b7d0', name='FUN_14060b7d0', role='per-frame input translation loop (G+0x10 clock++, blk+0x3C66 array cur/prev/pressed/released via FUN_140048630) that ends by zeroing the three exe words 0x142edf538 / 0x142edf31C / 0x142edf318.', note='CONFIRMED by disasm 2026-09-03: those three words are write-only in a frame (not hidden state). Resolves the UNKNOWN role of 0x142edf318/31C/538.', matched=false;
UPSERT steam_routine:FUN_14006b5d0 SET addr='0x14006b5d0', name='FUN_14006b5d0', role='debug/event ring append: obj = *(DAT_142ebc010); if (obj+0x34AAC < 0x40) { ring[obj+0x346AC + n*16] = {a,b,c,d}; n++ }. Heap object (0x28B5EF9C live), never read back by the frame.', note='CONFIRMED by disasm 2026-09-03; perturbing the counter changes nothing in blk/ctx.', matched=false;
UPSERT steam_routine:FUN_140634920 SET addr='0x140634920', name='FUN_140634920', role='per-frame HUD/entity walk gated by game_state+0x828 and game_state+0x520 (calls FUN_140634600 over the entity list DAT_142edf628).', note='INFERRED role (disasm read); game_state+0x520 is read before FUN_140607e90 rewrites it and perturbing it changes nothing in blk (2026-09-03).', matched=false;
UPSERT steam_routine:FUN_140118f00 SET addr='0x140118f00', name='FUN_140118f00', role='GGPO advance_frame callback = the thread boundary: FUN_140119a60(session, &inputs, 0x10, &flags) [ggpo_synchronize_input] -> FUN_140118950(&DAT_142d10b90, inputs, flags) [the tick] -> DAT_142e111a8 = counter (every 90 frames also DAT_142e111b0) -> FUN_1401198d0(session) [ggpo_advance_frame].', note='CONFIRMED by decompile 2026-09-03 (cached decompile); nothing inside FUN_140118950 waits, locks or reads another thread.', matched=false;
UPSERT steam_routine:FUN_1407491d0 SET note_rng='2026-09-03: pair loc_8c10235c (high) is the anchor of the RNG identification: the DC routine loads r9 = Rng_function and jsr @r9 four times; this routine calls FUN_14060fa40 four times.';

-- globals
UPSERT global:steam_rng_state SET addr='0x8C289CDC', steam_off='blk+0x32BD4', type='u8[2]', note='THE STEAM SIM RNG STATE: hi byte blk+0x32BD4, lo byte blk+0x32BD5 (DC-mapped address 0x8C289CDC is unreferenced in the DC disasm: the recompile moved the RNG INTO the rollback block and changed the generator). Inside the GGPO save region -> rolled back with the block, carried by any snapshot, never reseeded per frame (seeder FUN_14060f9e0 at battle init only). Observed c038 at clock 2239, 51b0 at clock 2476, untouched over 20 idle emulated ticks. CONFIRMED 2026-09-03.';
UPSERT global:dead_lcg_object SET addr='0x140a5c7d8', steam_off='0x140a5c7d8 (state 0x140a5c800)', type='CRITICAL_SECTION + u32[5]', note='Dead library LCG object carrying the DC Rng_function constants (A 0x41C64E6D, C 0x3039, shift 16, mask 0x7FFF, seed 1). Zero references outside its initialiser FUN_1400298c0. Not hidden state. CONFIRMED 2026-09-03.';
UPSERT global:exe_counters_142edf318 SET note_resolved='2026-09-03: 0x142edf318/31C/538 are zeroed by FUN_14060b7d0 every frame (write-only); 0x142edf543 (pending) / 0x142edf546 (step) belong to the HUD re-upload state machine FUN_1406163e0 (render only). Role no longer UNKNOWN; carry the 0x142edf300 page in a snapshot for the HUD re-upload sequence only.';
UPSERT global:ctx_matrix_state SET addr='ctx+0x1f80a4', steam_off='ctx+0x1f80a4..0x1f8600', type='NaomiLib matrix state', note='mode +0x1f80a4, four 64-B slots from +0x1f80ac, push storage ptr +0x1f81b0 (= blk), depth +0x1f81b8/+0x1f81bc (0x40), composite +0x1f8200, near +0x1f82b0 (1.0). Read before written by the frame (the sim projection FUN_14060fb90 -> FUN_14061d7e0 runs before the dispatcher rewrites it). The frame is a FIXED POINT on the whole region (0 bytes differ after a tick). A wrong entry state (mode 3, garbage slot 1) changes 49 blk bytes = the walker screen x/y (+0x124/+0x128) and push slot 0. Contract invariant C4. CONFIRMED 2026-09-03.';
UPSERT global:pl_slot_images SET addr='0x0C420000', steam_off='ctx[1]+0x420000 + pos*0x150000', type='6 x 0x150000 B', note='PL slot image pos (order 0,2,4,1,3,5 = fighter slots) = AFS entry 209 + (fighter+0x6C0 & 0xFF) byte-exact for the entry length (six of six on runs/20260903-000941: cids 42/44/52/52/23/53 -> AFS 251/253/261/261/232/262), followed by a LOADER-BUILT tail from +0x130000 (fighter pointers +0x1C8.. at +0x130000/+0x13C000/+0x13D000/+0x13E000/+0x140000/+0x141000/+0x145000/+0x148000). Two images of the same character (cid 52 in slots 1 and 4) differ in 67,205 tail bytes but in 0 of the bytes the frame reads for that character. The 0x100 bit of +0x6C0 is a flag, not part of the id. The loader routine building the tail is UNKNOWN; dump-once per character is the cache rule. CONFIRMED 2026-09-03.';
UPSERT global:pl_tail_137b94 SET addr='PL slot +0x137B94', steam_off='0x0C420000 + pos*0x150000 + 0x137B94', type='u8[8]', note='8 bytes of the PL tail: real animation-script record in slot 0 (00 00 02 00 5A 03 00 00, read by FUN_140611f70), 0xCDCDCDCD (MSVC uninitialised-heap fill) in the three P2-side images (positions 3,4,5). Perturbing the P1 copies changes 28 blk bytes; perturbing the P2 copies changes nothing on this frame (not read). Whether a live loader produces identical tails on two boots is UNKNOWN (gate: dump the same character twice on two boots, diff over a whole-match read set). 2026-09-03.';
UPSERT global:crt_fma_flag SET addr='0x142eefbd8', steam_off='DAT_142eefbd8', type='u32', note='UCRT FMA3 dispatch flag (1 on the capture machine). The four FMA-capable CRT routines the frame calls (tanf FUN_140817230, sinf FUN_1408121d0, cosf FUN_140811cd0, powf FUN_140803be0) return bit-identical results on both paths: 0 differing of 155,001 (each trig sweep) + 65,536 (every u16 camera angle through tanf/atanf/sinf/cosf) + 5,064 (powf), measured natively on the game code with the image mapped at its link base; FMA3 execution proven by patching the SSE2 fall-throughs (0x140817241/0x1408121e1/0x140811ce1/0x140803bfd) to UD2. No game function contains FMA or x87. CONFIRMED 2026-09-03.';

-- findings
UPSERT finding:determinism_hidden_state_inventory SET status='confirmed', confidence='high', date='2026-09-03', contribution_candidate=true, note='Every byte outside blk that the tick FUN_140118950 reads BEFORE it writes (classified from the 313,754-record trace by first access) and its measured effect (one perturbation run each, blk hash compared): pad words game_state+0x218..0x227 = the inputs; game_state+0x520 (render gate, no effect); DAT_142d10b90 GGPO counter (wrapper only, no effect); 0x142edf543 (HUD re-upload state, no effect); heap ring *(DAT_142ebc010)+0x34AAC (no effect); ctx matrix state +0x1f80a4/+0x1f80ec/+0x1f81b0/+0x1f81bc (fixed point; wrong entry state corrupts walker screen x/y only); ctx+0x1f82b0 near and +0x1f855c (render only); 123 texture-slot flags ctx+0x1e2624+n*0x18 (render only; all-0xFFFF hangs the slot search); 4,320 B of the previous frame tile table 0x0CE60040.. (render only, copied to the write-only staging buffer); the six PL slot images (sim INPUT: the animation-script records are read by FUN_140611f70). Everything else the frame touches outside blk is rebuilt before use or static. Therefore the per-frame sim state that changes is entirely inside blk[0..0x33B18).';
UPSERT finding:determinism_rng_in_blk SET status='confirmed', confidence='high', date='2026-09-03', contribution_candidate=true, note='The Steam sim RNG is the 2-byte state blk+0x32BD4/0x32BD5 with generator FUN_14060fa40 (16-bit *3 byte mixer, 15-bit result), 8-bit draw FUN_14060f990, float draw FUN_14060fae0, seeder FUN_14060f9e0 ({1, 0xC3}); it is NOT the DC LCG at 0x8C16BC2C (s*0x41C64E6D+0x3039), whose constants survive only in the dead object initialised by FUN_1400298c0 (0x140a5c800, zero references). Being inside the GGPO region it is rolled back with the block and carried by any snapshot; not reseeded per frame; it moved c038 -> 51b0 over the 237 live frames pre->post and stayed c038 over 20 idle emulated ticks (0 draws). Consistent with the DC-resim divergence at the first RNG event (RENDER-ACCURACY-PROGRAM.md).';
UPSERT finding:determinism_external_calls SET status='confirmed', confidence='high', date='2026-09-03', note='The tick leaves the image 24 times, all inside the UCRT sprintf path of FUN_14003a4c0: GetLastError, FlsGetValue, RtlAllocateHeap (0x3C8 B, HEAP_ZERO_MEMORY), FlsSetValue, HeapFree, SetLastError (4x each). No import reads time, ticks, performance counters, rand(), thread ids or Steam. 0 RDTSC/RDTSCP/RDRAND/RDSEED/CPUID/SYSCALL/XGETBV in the 634 executed functions; the only RDTSC user in the image (FUN_1405c0010) is not on the path. __security_check_cookie compares 0x140ab12d8 with its own stack copy (value-independent).';
UPSERT finding:determinism_fma_bit_exact SET status='confirmed', confidence='high', date='2026-09-03', contribution_candidate=true, note='FMA verdict: BIT-EXACT. Static: all 16 FMA-bearing functions are the UCRT (0x140803be0..0x14082b700), all 13 x87 users are >= 0x1408d6c50; no game function uses FMA or x87; LDMXCSR only inside powf (balanced). The frame calls tanf x10, sinf x10, cosf x10, atanf x16 (no FMA branch), sqrtf x18 (SQRTSS), floorf x10, powf x1. Native oracle (determinism_gate.py native: exe image mapped at 0x140000000 in-process, DAT_142eefbd8 forced 0 then 1): 0 differing results over 155,001-point sweeps (tanf/sinf/cosf), all 65,536 u16 camera angles through the chain tanf -> atanf(0.75t) -> sinf/cosf, atanf 70,001, sqrtf 50,000, floorf 50,000, powf 5,064. Dispatch proof: SSE2 fall-throughs patched to UD2 -> flag=0 children die (0xC000001D / 0xC0000409), flag=1 children return the correct values. Sensitivity (+1 ulp on every return): tanf/atanf/powf change nothing; sinf/cosf change ctx only; sqrtf changes 9 blk bytes (walker screen x/y) -- the only CRT result reaching blk is the exact SQRTSS. p-code cannot finish the FMA3 variant (28 FMAs computed via Math.fma, then vpunpckldq_avx CALLOTHER in powf); flag=0 repeat is trace- and blk-identical (a5942b68.., 03db6732..).';
UPSERT finding:determinism_uninitialised_reads SET status='confirmed', confidence='high', date='2026-09-03', note='Stack: 1,518 bytes touched, 12 read before written (FUN_1406101b0 @0x1406103cf 4 B, FUN_140607e90 @0x140608688 8 B); pre-filling the 4 MB stack with 0xCC leaves blk / game_state / ctx / staging hashes identical. Heap arena: 0 read-before-write (the CRT ptd is calloc-zeroed). DC-RAM: the 8 bytes 0xCDCDCDCD at PL slot +0x137B94 in the P2-side images are not read on this frame (split perturbation p2: no change; p1: 28 blk bytes because slot 0 holds a real script record there). TEB-relative reads (0x18/0x28/0xA0/0x20A/0x1380..0x15C0) are UCRT-only and value-independent.';
UPSERT finding:determinism_threading SET status='confirmed', confidence='high', date='2026-09-03', note='No game function on the tick path contains LOCK-prefixed instructions, XCHG, CMPXCHG, PAUSE, fences or GS:/FS: accesses (only the UCRT try_get_function XCHG and memcpy SFENCE); no wait/sleep/thread import is reached. The GGPO synchronisation is outside the tick: FUN_140118f00 = ggpo_synchronize_input (FUN_140119a60) -> FUN_140118950 -> ggpo_advance_frame (FUN_1401198d0); save/load callbacks FUN_140119380 / FUN_140118fa0 run outside it.';
UPSERT finding:determinism_multitick_gate SET status='confirmed', confidence='high', date='2026-09-03', note='Gate (b): 20 consecutive emulated ticks from the pre image with its own seat words (0,0): blk+0x3CC8 2239 -> 2259 by exactly 1 per tick (= the live clock_value_after of the dump), 104-231 B change per tick (input array, G, fighters, camera, pool nodes, draw counts, battle state, and on alternate ticks 54-104 B of the unmapped blk+0x1000.. records), 323 distinct bytes over 20 ticks; versus the post image 237 frames later: 7,785 B differ pre->post, 231 touched by the 20 ticks, 7,554 never touched in 20 idle frames (eye/look-at, 146 fighter B, 280 node B, RNG bytes, battle state 0x3254C..0x32586), 92 changed by ticks but equal in pre/post (cycling countdowns).';
UPSERT finding:determinism_pl_image_rule SET status='confirmed', confidence='high', date='2026-09-03', contribution_candidate=true, note='PL slot -> character mapping, CONFIRMED byte-exact on all six slots of runs/20260903-000941: position pos (0,2,4,1,3,5 = fighter slots) of 0x0C420000 + pos*0x150000 holds AFS entry 209 + (fighter+0x6C0 & 0xFF) (= fighter+0x1) for the entry length (0x10E3E0 / 0x116E80 / 0x126140 x2 / 0x10C100 / 0x1274A0). The 0x100 bit of +0x6C0 is a flag. Beyond the entry a loader-built tail (+0x130000..) that the frame reads (~40 B per drawn fighter: script/cell records); two loads of the same character (cid 52, slots 1 and 4) are identical in every byte the frame reads for it. A per-character image cache = AFS entry + dumped tail; the loader routine is UNKNOWN. receipt_gate.py checks the rule before ticking.';
UPSERT finding:determinism_receipt_gate_tool SET status='confirmed', confidence='medium', date='2026-09-03', note='d3dcap/replay/receipt_gate.py --run <dump> --tape <tape>: anchors at the dump clock (tape row frame == blk+0x3CC8), checks roster and PL images, ticks N frames feeding seat_in[k] of row frame+k, compares blk+0x3CC8, px/py (fighter+0x50/+0x54 f32 bit-exact) and hp (fighter+0x578 & 0xFFFF) of all six slots per frame, prints the first divergence per field. --selftest builds a synthetic tape from the 20-tick dumps; --selftest --negative flips a pad bit and must diverge. A tape AND a same-match dump do not exist together yet (live dumps roster 42/52/44/23/52/53 vs the capgate tapes); the tool is ready for the first pair.';
UPSERT finding:determinism_contract SET status='confirmed', confidence='high', date='2026-09-03', contribution_candidate=true, note='THE CONTRACT a loader / thin client must preserve (docs/DETERMINISM-CONTRACT.md s7, each with a check): C1 memory layout (blk at *(0x142edf560), G = blk+0x3CB8, game_state page 0x140ac6d40, ctx at *(0x142ef0ab0) with ctx+8 = DC-RAM base, the 0x142edf300 page, exe image at 0x140000000 unrelocated); C2 input timing (one FUN_140118950(&DAT_142d10b90, inputs[4] & 0xFFFFFF, 0) per frame, seat map as in the anchor; clock +1 per call); C3 float environment (MXCSR 0x1F80, DAT_142eefbd8 either value, no x87); C4 ctx at entry = the balanced NaomiLib state (mode 1, depth 0x40, storage = blk, slots identity, near 1.0; the frame is a fixed point on it); C5 DC-RAM per roster (six PL images = AFS 209+cid + dumped tail; effects/HUD/stage banks by AFS entry; the 0x0CE60000 table is rebuilt); C6 stubbed imports (FlsGetValue 0, RtlAllocateHeap zeroed writable memory, FlsSetValue 1, HeapFree 1); C7 exe mutable pages in the snapshot (game_state 0x1000 and 0x142edf300..0x600); C8 RNG travels with the block (blk+0x32BD4/5); C9 single thread, no waits. Falsification = the receipt gate on two different hosts with a same-match tape + dump. Status: CONFIRMED on one host, one roster, one idle-ish frame + 20 idle ticks; INFERRED beyond.';
UPSERT finding:frame_minimum_tape SET note_determinism='2026-09-03: the 8 UNKNOWN exe bytes are resolved (0x142edf318/31C/538 write-only zeros from FUN_14060b7d0; 0x142edf543/546 = HUD re-upload state machine FUN_1406163e0, render only); the PL loader table remains UNKNOWN but the slot->AFS rule is CONFIRMED (finding:determinism_pl_image_rule).';

