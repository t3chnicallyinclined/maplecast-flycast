-- 31: texture BANKS -- how the Steam MvC2 recompile numbers texture slots (TCW) and where each bank's
-- pixels live on disk (game_50.arc -> AFS entry), so effects / HUD / stage pages are derivable OFFLINE.
-- Source doc: mvc-live-skins-quarters/docs/TEXTURE-BANKS-GHIDRA.md (2026-09-02). Ripper + byte-exact gate:
-- mvc-live-skins-quarters/d3dcap/replay/rip_texbank.py. Tags: CONFIRMED = function decompiled/disassembled
-- and read on the side(s) named; INFERRED = derived, not read. Idempotent (UPSERT / RELATE with explicit ids).
-- APPLY WITH tools/re_kb/apply_seed.py (one statement per request).
USE NS re DB kb;

UPSERT source:doc_texture_banks_ghidra SET kind='doc', strength='code', ref='mvc-live-skins-quarters/docs/TEXTURE-BANKS-GHIDRA.md', note='Ghidra read-set of the Steam texture-slot registrar, the bank loaders, the archive->DC map and the host PVR decode (2026-09-02); every CONFIRMED claim was decompiled/disassembled and read; the decode was gated byte-exact against captured D3D pages.';
UPSERT source:tool_rip_texbank SET kind='tool', strength='code', ref='mvc-live-skins-quarters/d3dcap/replay/rip_texbank.py', note='Offline bank ripper (game_50.arc -> AFS -> POL texture records -> host-exact RGBA8 PNGs keyed by TCW) with a sha256 gate against d3dcap/replay/tcw_pages/index.json (captured pages).';

-- ---------------------------------------------------------------- SH4 routines (marvelous2)
UPSERT routine:loc_8c11b800 SET label='loc_8c11b800', pc='0x8C11B800', bank='bank11', role='texture-slot BASE registrar', summary='mov.l r4,@0x8C2DEE54; rts -- stores the TCW base every following texture registration adds to (Steam FUN_1408458a0).';
UPSERT routine:loc_8c0322d4 SET label='loc_8c0322d4', pc='0x8C0322D4', bank='bank03', role='POL/TEX relocation', summary='r4=POL r5=TEX: delta=*POL-POL-0x10; *POL-=delta; *(POL+8)-=delta; model table[i]-=delta; then every 16-B TEX record: loc -= (firstLoc - TEX). Identical algorithm to Steam FUN_14060d770.';
UPSERT routine:loc_8c032320 SET label='loc_8c032320', pc='0x8C032320', bank='bank03', role='register a bank (base, &tablePtr, POL)', summary='loc_8c11b800(r4=base); *r5=r6 (table ptr = POL); for i<*(POL+4): loc_8c122fd0(*(POL[0]+4i), *(POL+8)). == Steam FUN_14060d080 minus the host model-table build.';
UPSERT routine:loc_8c122fd0 SET label='loc_8c122fd0', pc='0x8C122FD0', bank='bank12', role='assign texture slots to a model (loops loc_8c122d00 over records)', summary='r4=model r5=texHdrs; repeatedly bsr loc_8C122D00(model, texHdrs, &state, &out) until out==0. Steam FUN_140844dc0 (single function, loop inlined).';
UPSERT routine:loc_8c032696 SET label='loc_8c032696', pc='0x8C032696', bank='bank03', role='HUD bank (0xC90) register + per-fighter portrait patch', summary='stores POL ptr to *0x8C26A90C-region table, reads texHdrs=*(POL+8), tests G+0x29, walks the 6 fighter slots. Steam FUN_14060d560.';
UPSERT routine:loc_8c0324d0 SET label='loc_8c0324d0', pc='0x8C0324D0', bank='bank03', role='bank-loader case 9 body (file 0x3E -> 0x0CC00000, G+0x94 base select)', summary='writes a DC base to G+0x94 (alt when G+0x84==1), loads file 0x3E, registers with base from pool. Inlined into Steam FUN_14060c370 case 9. NOT the texture registrar (seed-30 pairing corrected here).';
UPSERT routine:loc_8c032526 SET label='loc_8c032526', pc='0x8C032526', bank='bank03', role='bank-loader case 10 body (G+0xAD 0/1/2 selects file pair 0x34d/0x36a/0x36c)', summary='Inlined into Steam FUN_14060c370 case 10. NOT FUN_140844dc0 (seed-30 pairing corrected here).';
UPSERT routine:loc_8c129668 SET label='loc_8c129668', pc='0x8C129668', bank='bank12', role='memcpy(dst r4, src r5, size r6) with 4/2/1-byte alignment paths', summary='Plain copy; called by the bank loader to copy a loaded file (e.g. 0x0CE80000 <- 0x0CD8D000, 0x17000). NOT the relocation (seed-30 pairing corrected here).';

-- ---------------------------------------------------------------- Steam routines (mvc_dump.bin)
UPSERT steam_routine:FUN_1408458a0 SET addr='0x1408458a0', role='texture-slot BASE registrar', note='CONFIRMED: *(u32*)(DAT_142ef0ab0 + 0x1e0098) = param_1. 43 call sites in 15 functions; bases seen: 0, 2, 0xD, 0x390+slot*0x100 (FUN_140612180, per-fighter sprite pages), 0x810/0x850/0x860 (common/select banks), 0x910/0x914 (case 5/9), 0xC10 (stage, FUN_14060d470), 0xC50 (effects, case 2), 0xC90 (HUD, FUN_14060d560), 0xD10/0xD50 (case 8/0xE), and a dynamic base *(blk+0x32be8) (FUN_1406127c0). SH4 pair loc_8c11b800 (global 0x8C2DEE54).';
UPSERT steam_routine:FUN_140844dc0 SET addr='0x140844dc0', role='assign texture slots to a NaomiLib model', note='CONFIRMED: walks records from model+0x18 while PCW<0 (next = rec + rec[0x13] + 0x50); for rec[8] (texIndex) >= 0: TCW = texIndex + *(ctx+0x1e0098); rec[3] = TCW; if slot ctx+0x1e00a0+TCW*0x18 is free: used=1, fmt/type u16 = texHdr+4, flag = (type in 5..7) ? 0 : -1, w,h; FUN_140048460(TCW, w, h, 0, fmtType, *(ctx+0x1e0088) + (loc & 0x1ffffff)). texHdr = texHdrs + texIndex*16.';
UPSERT steam_routine:FUN_1408435d0 SET addr='0x1408435d0', role='register ONE texture slot from a 16-byte record', note='CONFIRMED: same slot fill as FUN_140844dc0 but for an explicit slot number and record pointer (w@0,h@2,fmt@4,type@5,loc@8). Used by FUN_140845fe0 (record lists) and FUN_140846080 (single index).';
UPSERT steam_routine:FUN_140845fe0 SET addr='0x140845fe0', role='register a 16-byte record LIST at consecutive slots base+i', note='CONFIRMED: slot = *(ctx+0x1e0098) + i while rec.w > 0; optional second array patches slot+0x1e00a4 (flag). Exe-resident lists: DAT_140a6aad0 (0x910: 256x256 fmt0 @0x0CE60000, 128x128 fmt1 @0x0CC60000, 64x64 fmt2 @0x0CCF0000), DAT_140a6ab30 (0x910 case 9), DAT_140a6ab98 (0xD50: 128x128 fmt2 @0x0CC80000); RAM lists at DC 0x0CE1D000 (base 2), 0x0CE60C00 (dynamic base), 0x0CC00000/0x0CE60000 (case 0x11 bases 0x850 / 0xD).';
UPSERT steam_routine:FUN_140846080 SET addr='0x140846080', role='register record[idx] of a list at slot base+idx', note='CONFIRMED. Boot: FUN_14060af70/FUN_14060b230 register slot 1 from the list at DC 0x0CE0A000 with base 0.';
UPSERT steam_routine:FUN_140845830 SET addr='0x140845830', role='RE-UPLOAD an existing slot from new pixels', note='CONFIRMED: slot = param_1 + base; if used: FUN_140048910(slot, fmt/type, w, h, pixels). Callers: FUN_1406162e0 (0xC99 <- DC 0x0CE60000 after FUN_140611e90 decompress of fighter data), FUN_140616330 ((fighter+0x230>>1)+0xCA6), FUN_140616910 (0x810 <- 0x0CDB0000, 0x81C <- 0x0CDF0000), FUN_1406163e0 (0x811/0x81C/0x817+/0x910/0x914 select-screen pages).';
UPSERT steam_routine:FUN_14060d080 SET addr='0x14060d080', role='register a whole bank: base, model table, slot assign', note='CONFIRMED: FUN_1408458a0(base); FUN_14060d8f0(*table, POL) (host model table, count @+0xB00, texHdrs @+0xB08); for each model FUN_140844dc0(model, texHdrs). SH4 pair loc_8c032320 (the seed-30 pair loc_8c0321dc is a different, small load+rebase routine).';
UPSERT steam_routine:FUN_14060d770 SET addr='0x14060d770', role='POL/TEX relocation after load', note='CONFIRMED: delta = *(POL) - POL - 0x10; *(POL), *(POL+8) and every model-table entry -= delta; every TEX record loc -= (firstLoc - TEX). Read on both sides; SH4 pair loc_8c0322d4 (NOT loc_8c129668, which is memcpy).';
UPSERT steam_routine:FUN_14060c070 SET addr='0x14060c070', role='BOOT loader of the common banks (AFS entry -> DC address)', note='CONFIRMED (called once from FUN_140608690): 799->0x0D000000 + 800->0x0D026000 (effects, base 0xC50); 0x343->0x0D082000 + 0x344->0x0D099000 (HUD, 0xC90); 0x345->0x0D0C6000 + 0x346->0x0D0E5000 (0x810); 0x347/0x348->0x0D25C000/0x0D268000; 0x349/0x34A->0x0D2B1000/0x0D2B3000 (0xD10); 0x34B/0x34C->0x0D7CC000/0x0D7D7000 (case 9, 0x810); 0x34F/0x350->0x0D3A2000/0x0D3CE000 (case 0xB, 0x810); 0x351/0x352->0x0D4CE000/0x0D4F5000 (case 0xC, 0x810); 0x353/0x354->0x0D6CC000/0x0D6E0000 (case 0xD, 0x810); 0x355/0x356 (or 0x359/0x35A when G+0x29)->0x0D720000/0x0D721000 (case 0xE, 0xD10); 0x357/0x358->0x0D7A9000/0x0D7B6000 (case 0xF, 0x850). Each pair followed by FUN_14060d770(POL, TEX).';
UPSERT steam_routine:FUN_14060d560 SET addr='0x14060d560', role='HUD bank (0xC90) register + per-fighter portrait patch', note='CONFIRMED: FUN_14060d8f0(PTR_DAT_142edf598, 0x0D082000); per fighter slot s (stride 0x738, 6 slots): FUN_140611e90(fighterData + fighterData[0 or 3] , DC 0x0CE60000); copy 0x800 B from DC 0x0CE60000 + (DAT_140a6aac4[*(slot+0x440d)] )*0x800 into texHdr[10 + DAT_140a6aac8[s]].loc and 0x800 B from DC 0x0CE61000 into texHdr[16 + DAT_140a6aac8[s]].loc; DAT_140a6aac8 = {0,3,1,4,2,5} => slots 0xC9A/0xC9B/0xC9C = P1 C1/C2/C3, 0xC9D/0xC9E/0xC9F = P2, 0xCA0..0xCA5 the second set. Then FUN_1408458a0(0xC90) + FUN_140844dc0 over the 130 models. SH4 pair loc_8c032696.';
UPSERT steam_routine:FUN_14060dcf0 SET addr='0x14060dcf0', role='AFS entry -> DC RAM copy', note='CONFIRMED: base=ctx[0] (archive image = the AFS at game_50.arc:bin\\mvsc2 +0x40); size=u32@base+0xC+i*8, off=u32@base+8+i*8; memcpy(ctx[1] + (dc - 0x0C000000), base + off, size); returns size.';
UPSERT steam_routine:FUN_14004ba50 SET addr='0x14004ba50', role='HOST PVR texture decode -> RGBA8 (what the D3D capture holds)', note='CONFIRMED: type (fmtType>>8): 1 = twiddled 16bpp -> FUN_140051f70 detwiddle (square; non-square as min-side squares along the long axis; type 2 adds mip offsets 0x2aac/0xaaac/0x2aaac); 3 = VQ (codebook 256x4 u16, indices at +0x800) -> FUN_140052050/FUN_140052280 block detwiddle (type 4 mip offsets 0xd56/0x1556/0x5556); 5..7 = 4-bit palettized (nibble expand then FUN_140051e90). fmt (low byte): 0 ARGB1555 -> R,G,B = c*255/31 (integer division), A = 0xFF if bit15 else 0 (line 2413); 1 RGB565 -> R,B = c*255/31, G = c*255/63, A = 0xFF (line 753); 2 ARGB4444 -> c*0x11 (case 2); 5 = 555 with A=0xFF; output little-endian bytes R,G,B,A. Called from FUN_14004d290 (map/upload) <- FUN_140048460 (texture create).';
UPSERT steam_routine:FUN_140051f70 SET addr='0x140051f70', role='recursive detwiddle (16bpp)', note='CONFIRMED: (src, dst, stride, n): recurse TL (src), BL (src+q*q -> dst+stride*q), TR (src+2q*q -> dst+q), BR; leaf copies one u16. => twiddled index interleaves y in bit 0, x in bit 1 (y-fastest). FUN_140051e90 = same for bytes.';
UPSERT steam_routine:FUN_140052280 SET addr='0x140052280', role='VQ block detwiddle', note='CONFIRMED: recursion over 2x2 blocks in the same TL,BL,TR,BR order; leaf FUN_140051f70(codebook + idx*8, dst, stride, 2) => each codebook entry = 4 u16 in twiddle order; expanding index i to its 4 words in stream order yields a plain twiddled image.';
UPSERT steam_routine:FUN_140611e90 SET addr='0x140611e90', role='word-LZSS decompressor (NinjaLib TEX container variant)', note='CONFIRMED: u16 stream; a bitmask word precedes 16 chunks (0x8000 first); clear = literal; set: hi5 = count (0 => next word is count, dist = whole word), low 11 = back distance in words; count with dist 0 = run of zeros; dist 0 count 0 = end. Used for fighter-data blocks patched into HUD slots and by the bank loader (case 5/6/9/10/0xE/0x11).';
UPSERT steam_routine:FUN_140844a10 SET addr='0x140844a10', role='NaomiLib init: sin/cos tables + texture data base', note='CONFIRMED: also writes *(ctx+0x1e0088) = *(ctx+0x1e0090) = ctx[1] (host base of the 32 MB DC RAM image) -- the pointer every texture registration adds (loc & 0x1ffffff) to.';
UPSERT steam_routine:FUN_140800640 SET addr='0x140800640', role='memcpy', note='CRT memcpy (383-line SIMD body); used by FUN_14060dcf0 and the bank loader. SH4 counterpart loc_8c129668 (sized copy with 4/2/1-byte paths).';

-- ---------------------------------------------------------------- recompiles edges (new / corrected)
RELATE steam_routine:FUN_1408458a0->recompiles:FUN_1408458a0_loc_8c11b800->routine:loc_8c11b800 SET confidence='confirmed', method='kb-seed+decompile', evidence='Both read: SH4 mov.l r4,@0x8C2DEE54; Steam *(ctx+0x1e0098)=param_1; same call slot in loc_8c032320 vs FUN_14060d080 (TEXTURE-BANKS-GHIDRA s1)', inlined=false;
RELATE steam_routine:FUN_14060d770->recompiles:FUN_14060d770_loc_8c0322d4->routine:loc_8c0322d4 SET confidence='confirmed', method='kb-seed+decompile', evidence='Both read: identical relocation algorithm (delta = *POL-POL-0x10 applied to header/table; TEX loc -= firstLoc-TEX); same (POL,TEX) args and call slot in case 2 (TEXTURE-BANKS-GHIDRA s1)', inlined=false;
RELATE steam_routine:FUN_14060d080->recompiles:FUN_14060d080_loc_8c032320->routine:loc_8c032320 SET confidence='confirmed', method='kb-seed+decompile', evidence='Both read: registrar(base); table=POL; loop i<*(POL+4) assign(model_i, *(POL+8)); shared tail loc_8c032f5c of the bank loader jumps to it with (base, &table, POL) exactly as Steam FUN_14060d080(base,&table,POL) (TEXTURE-BANKS-GHIDRA s1)', inlined=false;
RELATE steam_routine:FUN_140844dc0->recompiles:FUN_140844dc0_loc_8c122fd0->routine:loc_8c122fd0 SET confidence='high', method='kb-seed+callslot', evidence='Same call slot/args (model, texHdrs) inside loc_8c032320 vs FUN_14060d080; SH4 body loops loc_8c122d00 per record (inner routine NOT read) -- INFERRED equal to the Steam record walk', inlined=false;
RELATE steam_routine:FUN_14060d560->recompiles:FUN_14060d560_loc_8c032696->routine:loc_8c032696 SET confidence='confirmed', method='kb-seed+decompile', evidence='Both read at shape level: POL ptr stored to bank table, texHdrs=*(POL+8), G+0x29 test, 6-slot fighter walk; called from case 4 in both (loc_8c032c80 / FUN_14060c370 case 4)', inlined=false;
RELATE steam_routine:FUN_14060c370->recompiles:FUN_14060c370_loc_8c0324d0->routine:loc_8c0324d0 SET confidence='confirmed', method='kb-seed+decompile', evidence='SH4 loc_8c0324d0 = case-9 body (G+0x94 base select with G+0x84==1 alternate, file 0x3E -> 0x0CC00000); Steam inlines it in FUN_14060c370 case 9', inlined=true;
RELATE steam_routine:FUN_14060c370->recompiles:FUN_14060c370_loc_8c032526->routine:loc_8c032526 SET confidence='confirmed', method='kb-seed+decompile', evidence='SH4 loc_8c032526 = case-10 body (G+0xAD 0/1/2 -> file pair select); Steam inlines it in FUN_14060c370 case 10', inlined=true;
RELATE steam_routine:FUN_140800640->recompiles:FUN_140800640_loc_8c129668->routine:loc_8c129668 SET confidence='high', method='kb-seed+decompile', evidence='SH4 loc_8c129668 read: memcpy(dst,src,n) with alignment paths; Steam FUN_140800640 is the CRT memcpy used at the same call sites (FUN_14060dcf0)', inlined=false;
-- demote the four seed-30 crawl pairs this read-set falsified (kept for provenance; confidence low + superseded_by)
UPDATE recompiles:FUN_1408458a0_loc_8c0324d0 SET confidence='low', superseded_by='recompiles:FUN_1408458a0_loc_8c11b800', note='WRONG (2026-09-02): loc_8c0324d0 is the bank-loader case-9 body, not the registrar; the registrar is loc_8c11b800 (both read).';
UPDATE recompiles:FUN_14060d770_loc_8c129668 SET confidence='low', superseded_by='recompiles:FUN_14060d770_loc_8c0322d4', note='WRONG (2026-09-02): loc_8c129668 is memcpy; the relocation is loc_8c0322d4 (identical algorithm read on both sides).';
UPDATE recompiles:FUN_140844dc0_loc_8c032526 SET confidence='low', superseded_by='recompiles:FUN_140844dc0_loc_8c122fd0', note='WRONG (2026-09-02): loc_8c032526 is the bank-loader case-10 body; the slot assigner is loc_8c122fd0 (call-slot evidence).';
UPDATE recompiles:FUN_14060d080_loc_8c0321dc SET confidence='low', superseded_by='recompiles:FUN_14060d080_loc_8c032320', note='WRONG (2026-09-02): loc_8c0321dc is a small load+rebase routine without the model loop; FUN_14060d080 is loc_8c032320. The Steam counterpart of loc_8c0321dc is UNKNOWN.';

-- ---------------------------------------------------------------- globals
UPSERT global:tex_slot_base SET addr='0x8C2DEE54', steam_off='ctx+0x1e0098', type='u32', note='TCW base added to every texture registration (texIndex + base, or record index + base). Written ONLY by the registrar (SH4 loc_8c11b800 / Steam FUN_1408458a0); read by FUN_140844dc0, FUN_140845fe0, FUN_140846080, FUN_140845830. Not in blk -- lives in the NaomiLib host context DAT_142ef0ab0.';
UPSERT global:tex_slot_table SET addr='UNKNOWN', steam_off='ctx+0x1e00a0', type='struct[0xFFF] x 0x18', note='Steam texture slot table indexed by TCW: +0 u16 used, +2 u16 fmt|type<<8, +4 u16 flag (0 for type 5..7 else -1), +6 u16 w, +8 u16 h, +0x10 host texture object (FUN_140048460 -> DAT_140acd3a8+0xd0500+TCW*8). SH4 equivalent not located.';
UPSERT global:tex_data_base SET addr='n/a', steam_off='ctx+0x1e0088', type='ptr', note='= ctx[1] = host base of the 32 MB DC work-RAM image (set by FUN_140844a10). Texture pixels = tex_data_base + (record.loc & 0x1ffffff), i.e. the DC address the TEX file was loaded/relocated to.';
UPSERT global:effect_poly_dir SET addr='0x8C26A908', steam_off='PTR_DAT_142edf590', type='ptr', note='Effects bank (base 0xC50) table: SH4 = pointer to the POL loaded at 0x0CED0000 (live value 0x0CED0000, finding:3d_outside_node_readset item 11); Steam = host model table filled by FUN_14060d8f0 from the POL at DC 0x0D000000 (AFS 799; TEX AFS 800 at 0x0D026000). Registered by bank-loader case 2 on both builds.';
UPSERT global:hud_bank_table SET addr='0x8C26A90C', steam_off='PTR_DAT_142edf598', type='ptr', note='HUD/common-model bank (base 0xC90): SH4 pointer stored by loc_8c032696 and read by the case-4 loop loc_8c032f80 over 4 entries (targets 0x8C2896F0+i*0x10); Steam PTR_DAT_142edf598 -> 0x142ee0c50 filled from the POL at DC 0x0D082000 (AFS 0x343; TEX 0x344 at 0x0D099000). Steam case 4 = FUN_14060d560 + 4x FUN_140619720(table[i], &DAT_142eed370+i*0x10).';

-- ---------------------------------------------------------------- findings
UPSERT finding:texbank_tcw_rule SET status='confirmed', confidence='high', date='2026-09-02', contribution_candidate=true, note='TEXTURE SLOT NUMBERING (Steam, read): every bank registration is base + index. FUN_1408458a0(base) stores the base at ctx+0x1e0098; FUN_140844dc0(model, texHdrs) assigns TCW = base + texIndex to each model record (rec[3]) and fills slot ctx+0x1e00a0+TCW*0x18 from the 16-B TEX record {w,h,fmt,type,loc} with pixels at ctx[1]+(loc&0x1ffffff). Bases: 0xC10 stage (FUN_14060d470), 0xC50 effects (case 2, PTR_DAT_142edf590, POL 0x0D000000), 0xC90 HUD (FUN_14060d560, PTR_DAT_142edf598, POL 0x0D082000), 0x810/0x850/0x860/0x910/0x914/0xD10/0xD50 (cases 5..0x15 select/vs/ending banks), 2 and 0 (boot lists), 0x390+slot*0x100 (per-fighter sprite pages, FUN_140612180), *(blk+0x32be8) dynamic (FUN_1406127c0). SH4 identical: loc_8c11b800 stores r4 to 0x8C2DEE54; loc_8c032320(base,&table,POL) loops loc_8c122fd0. Effects bank on SH4 lives at 0x0CED0000 (POL) / 0x0CDA4000 (TEX) -- the recompile relocated the load addresses, the AFS entry numbers are the invariant.';
UPSERT finding:texbank_archive_map SET status='confirmed', confidence='high', date='2026-09-02', contribution_candidate=true, note='ON-DISK LOCATION of every bank: Steam\\steamapps\\common\\MARVEL vs. CAPCOM Fighting Collection\\nativeDX11x64\\arc\\pc\\game_50.arc = ARC v7 with one zlib entry bin\\mvsc2 (toc@8: csize @+68, doff @+76); inflated = IBIS header + Sega AFS at +0x40 (magic AFS\\0, 890 entries, {u32 off,u32 size}@+8+i*8, offsets relative to the AFS). This AFS is ctx[0], the archive image FUN_14060dcf0(i, dc) copies from. Effects: POL entry 799 @AFS+0x3EBB000 (0x25ED0 B, 241 models, 25 textures = TCW 0xC50..0xC68), TEX entry 800 @+0x3EE1000 (0x5B800 B). HUD: POL 835 @+0x5B91800 (0x164E8 B, 130 models, 25 records = 0xC90..0xCA8), TEX 836 @+0x5BA8000 (0x1E000 B -- covers records 0..8 only). Common: POL 837 / TEX 838 (0x16E000 B, TCW 0x810..0x81D). Stage: POL 801+2*id / TEX 802+2*id (rip_stage rule). Entries 799/800/835-838 are byte-identical in game_50.arc, .bak and .ORIGINAL (the skin tool only rewrites character DATs).';
UPSERT finding:texbank_host_decode_exact SET status='confirmed', confidence='high', date='2026-09-02', contribution_candidate=true, note='HOST DECODE (FUN_14004ba50) reproduced BYTE-EXACT: RGB565/ARGB1555 expand as c*255/31 (G: c*255/63) by integer division, ARGB4444 as c*0x11, A1 = 0xFF/0x00, bytes R,G,B,A; twiddle = y in bit 0 (FUN_140051f70 order TL,BL,TR,BR); VQ = codebook entry of 4 u16 in that order, indices in block-twiddle order (FUN_140052280). Gate (rip_texbank.py --gate, sha256 over RGBA8 = tcw_build.py convention): every captured page that comes from a static bank file matches: effects 9/9 distinct pages, HUD 2/2, stage-0B 1/1. Falsification arm: maplecast-flycast/tools/rip_stage.py decode scores 0/11 on the same pages; hybrid runs attribute it to BOTH its x-LSB morton (transposed) and its 1555 (c*8) / 565 (bit-replicate) expansions -- see finding:rip_stage_decode_falsified.';
UPSERT finding:texbank_gate_result SET status='confirmed', confidence='high', date='2026-09-02', note='GATE TALLY over the 45 captured pages in d3dcap/replay/tcw_pages/index.json (pre-31): 8 byte-exact under their key (0xC5B, 0xC61_d3f807, 0xC63, 0xC64, 0xC66, 0xC67, 0xC90_b23a27, 0xC91); 7 byte-exact under ANOTHER TCW of the ripped banks (lib 0xC50 = 0xC51, 0xC60 = 0xC5C, 0xC61 64x64 = stage 0xC10, 0xC61_b23a27 = HUD 0xC90, 0xC61_cc2a09 = 0xC5A, 0xC90 = 0xC5A, 04000000 = 0xC90) -- see finding:tcw_pages_first_record_miskey; 29 are the runtime-patched portrait slots 0xC9A..0xCA5 (finding:texbank_hud_runtime_slots); 1 unmatched (04000000_ad9513, a 1x1 page, not a bank texture). So 16/16 of the pages that CAN come from a bank file do, byte-exact, and 0 contradict the rule. Library after --add: 73 entries, obj=arc for 0xC50..0xC68 (all 25 effects pages, incl. the missing 0xC51/0xC5A/0xC5C/0xC5D/0xC5E/0xC5F/0xC62) and 0xC90..0xC98.';
UPSERT finding:texbank_hud_runtime_slots SET status='confirmed', confidence='high', date='2026-09-02', note='HUD bank records 9..24 (TCW 0xC99..0xCA8) point PAST the static TEX file (offsets >= 0x1E000 of a 0x1E000-B file): their pixels are written at runtime from the FIGHTERS data. CONFIRMED writers: FUN_14060d560 copies 0x800 B (one 32x32 RGB565 page) per fighter slot into records 10+{0,3,1,4,2,5}[slot] (0xC9A..0xC9F = P1 C1,C2,C3 / P2 C1,C2,C3) from the FUN_140611e90-decompressed block at DC 0x0CE60000 + DAT_140a6aac4[*(fighter+0x440d)]*0x800, and a second page from 0x0CE61000 into records 16+ (0xCA0..0xCA5); FUN_1406162e0 re-uploads 0xC99 and FUN_140616330 re-uploads (fighter+0x230>>1)+0xCA6 from the same scratch. That is why the capture holds up to 4 different pages per 0xC9A..0xCA5 key (different teams). INFERRED (not implemented): these are derivable offline from AFS entry 209+cid (the character DAT: source offset = DAT[0] or DAT[3], word-LZSS, then the 0x800-B pages) -- a second rule, roster-dependent; the pair (cid -> page sha) is the test.';
UPSERT finding:tcw_pages_first_record_miskey SET status='confirmed', confidence='high', date='2026-09-02', note='tcw_build.py keys a captured draw by the FIRST record TCW of the node object sharing its CBWorld (line 66: tcw = records[0].tcw), not by the drawn record. Objects with several textures therefore file later pages under the first record key: 7 of 45 library entries were mis-keyed (list in finding:texbank_gate_result), including a stage page (0xC10) under 0xC61 and an effects page (0xC5A) under 0xC90. rip_texbank.py --add --fix-miskeyed moved the proven ones to <key>_<sha6> (miskeyed_true_tcw recorded) and put the ripped page under the key. Consumers of the library keyed by TCW would have drawn the wrong page for 0xC50, 0xC60, 0xC61, 0xC90 before this.';
UPSERT finding:rip_stage_decode_falsified SET status='confirmed', confidence='high', date='2026-09-02', note='maplecast-flycast/tools/rip_stage.py texture decode does NOT reproduce the bytes the Steam host uploads: gate 0/11 on captured effects pages and 0/2 on HUD pages (host decode: 9/9 and 2/2 on the same records). Hybrid attribution (rip_texbank internals): host twiddle + rip_stage colours = 3 hits (only ARGB4444 pages, whose c*0x11 agrees), rip_stage twiddle + host colours = 0 => the x-LSB morton (transposes every page) is wrong AND the ARGB1555 (c*8, no low bits) / RGB565 (bit replicate) expansions differ from the host c*255/31. The docstring claim image-validated non-VQ path is not a pixel gate. Impact: every STGxx_tNN.png and the stage rule consumers; fix = use rip_texbank.decode_host (or rip_texbank.py --bank stage).';
UPSERT finding:texbank_open_items SET status='open', confidence='medium', date='2026-09-02', note='OPEN: (1) bank-loader case 0x18 rebases the effects TEX to 0x0CDA0000 (FUN_14060d770(0x0D000000,0x0CDA0000)) -- who copies pixels there, and whether it ever runs in a match, is UNKNOWN (the gate matched file 800 at 0x0D026000, the boot placement). (2) SH4 side of the slot TABLE (Steam ctx+0x1e00a0) not located. (3) loc_8c0321dc Steam counterpart UNKNOWN. (4) the character-DAT derivation of 0xC99..0xCA8 (finding:texbank_hud_runtime_slots) is INFERRED, not gated. (5) the 1x1 page 04000000_ad9513 origin UNKNOWN (not a bank texture; TCW 0x04000000 is a pseudo-key).';

