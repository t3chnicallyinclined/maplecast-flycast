USE NS re DB kb;

-- ============================================================================
-- 32_tsp_render_state.surql
-- 2026-09-03 -- How Steam derives the D3D11 render state of a world-space draw (stage props, effects,
-- HUD, the POL deck) from the DC polygon-record header words PCW @+0 / ISP @+4 / TSP @+8 and the
-- polygon GROUP header, read in Ghidra (mvc_dump.bin) and gated against 4 capgate packs with the
-- stage-11 tape (d3dcap/replay/tsp_gate.py). Doc: mvc-live-skins-quarters/docs/TSP-RENDER-STATE-GHIDRA.md.
-- Predictor: d3dcap/replay/tsp_state.py. Consumer: d3dcap/replay/tape_to_seq.py (nl_groups, emit_world).
-- Apply: PYTHONIOENCODING=utf-8 python tools/re_kb/apply_seed.py tools/re_kb/32_tsp_render_state.surql
-- ============================================================================

UPSERT source:tsp_render_state_ghidra SET kind='disassembly', strength='code',
  ref='mvc_dump.bin (Ghidra dumpproj, bridge :8080): FUN_1408482a0 (kinds 0-3 consumer: TSP>>29 src / TSP>>26&7 dst alpha instr when entry+0xCC == 1.0 else ctx+0x1f8274; FUN_140844220(src<<4|dst) -> ring cmd 1; clampUV = TSP>>15&3 (0 when ctx+0x1f8524 == 4), addr = 1 iff clampUV == 3, 2 if TSP & 0x60000; FUN_140844320(TSP>>13&3, addr) -> ring cmd 2 = (filter==0 ? 0x10000 : 0) | addr<<17; depth preset (ctx+0x1f8520): cat 2 -> 10, ISP bit26 clear -> (cat 3 && s19 == 0 ? no cmd : 4 - PCW bit7), ISP bit26 set -> 2 -> ring cmd 8; per group ring cmd 9 = group_flags & 3 when entry+0xC8 < 2; ignoreTexA = TSP bit19 || (src == 1 && dst != 0) = FUN_140048370 arg 6; batch id 0x2000 + (TSP>>22&3) + list; texture id TCW & 0xFFFF, 0xFFFF when rec+0x20 < 0; strip expansion even (i,i+1,i+2) odd (i+2,i+1,i), lists verbatim, skipped when group bit 6; vertex colour0 = ARGB((int)(rec+0x2C*255*entry+0xCC), rec+0x30..0x38 * entry+0xD0..D8) clamped). FUN_1408436a0 (cat/s19 from PCW>>24&7 list type and kind; entry+0xD0..D8 = ctx+0x1f825c..64; slot+0x1a = ctx+0x1f8274). FUN_140842e30 (flush per cat: cmd 1 from slot+0x1a, cmd 8 = 10 | 2 | 5 | 1, cmd 4/7 = P,V / W). FUN_140620cd0 (bit 13 -> FUN_140849ac0 = FUN_140848ee0(obj,2,1.0,2); bit 5 -> FUN_140849c30(obj,+0x90) = FUN_140848ee0(obj,1,+0x90,3) or FUN_140849be0 on lists 0xB/0xD; else FUN_140849c10 = FUN_140848ee0(obj,0,1.0,2) or FUN_1408499e0 (kind 0 when ctx+0x1f8518 == 0); colour bits 10/11 -> FUN_140849b00). FUN_140844a10 (ctx+0x1f8274 = 0x45, only writer). FUN_140607b50 @0x140607bfd (ctx+0x1f8520 = 1). FUN_140070940 (ring executor at DAT_140acd3a8+0xdbd08, count +0xdbd2c: cmd 1 preset -> blend hash 0x23baf183 default incl. 1 and 0x32, 0x11/0x12/0x21 -> 0xd3b1d189, 0x16 -> 0xb444c20a, 0x19 -> 0xcbec21a3, 0x22 -> 0xeb00e185, 0/7/&0x400 -> 0x4d2c8180/0xa31e719d, object = R2+0x358+(hash&0xfff)*16; cmd 2 -> point = w>>16&1, addr = w>>17&3 -> sampler [R2+0x20]+{0x1790,0x17f0,0x3300 | 0x1780,0x17e0,0x32f0}; cmd 8 -> DSS slot 1:+0x1e98 2:+0x1ec8 3:+0x1f08+ref 0x80 4:+0x1f08 5:+0x3678 10:+0x3688 11:+0x3698 default +0x1e88; cmd 9 -> RS 2:+0x2038 3:+0x1f68 else +0x1f58). FUN_140036560 = empty ret (the scale / 0x80 / +0xA0 calls in FUN_140620cd0 do nothing).',
  note='Read 2026-09-03. CONFIRMED = decompiled and read. The D3D11_*_DESC creation behind the hashes / slots was searched for in every function of the dump and not found (hashes occur only in FUN_140070940 and the blob FUN_14006a3f0), so the code -> D3D enum table is gate-inferred.';

UPSERT source:tsp_render_state_gate SET kind='measurement', strength='reproduction',
  ref='mvc-live-skins-quarters/d3dcap/replay/tsp_gate.py over capgate/frame_4445, 12033, 15323, 11943 .pack vs gs-cache tape 59613506 (stage 11, 38315 objects, 120118 polygon groups): 824 (draw, record-group) pairs matched by vertex-position set, 0 ambiguous, 1145 unmatched (geometry absent from that tape). Per field, predicted from the header words vs the state the shim recorded on the draw: sampler (filter,u,v) 824/824; depth (write,stencil) 824/824; cull 824/824; ps variant (classify_shaders opaque|texalpha) 824/824; winding (captured triangles == Steam CPU strip rule) 824/824; blend (src,dst) 820/824 -- the 4 misses are SRCA/ONE records on flag-bit-5 nodes (tape nodes referencing objects 136/137/138/187 all carry flags 0x25/0x39) drawn (5,6) = the alpha-multiplier override. --hist: every predicted code maps to exactly one captured state (blend 1 and 0x32 -> (5,6) x657+61; 0x12 -> (5,2) x102; samp 0x0 -> (21,1,1) x6, 0x10000 -> (0,1,1) x48, 0x20000 -> (21,3,3) x657, 0x30000 -> (0,3,3) x113; depth 2 -> (0,0) x167, 4 -> (1,1) x657; cull 1/2/3 -> NONE/FRONT/BACK x117/675/32). Vertex colour0 = record colour x 255 exact on 647/776 (earlier run); the rest are node multipliers (127 = 0.5) and the training deck tint (0,0,255).',
  note='2026-09-03. A pixel/state diff that agrees is a MEASUREMENT of the translation; the mechanism claims are carried by the Ghidra source.';

-- ── routines (Steam side; the DC side of this path is the TA itself, no SH4 routine to pair) ─────
UPSERT steam_routine:FUN_1408482a0 SET addr='0x1408482a0', name='FUN_1408482a0', role='NaomiLib kinds 0-3 consumer: derives blend/sampler/depth/cull/ignoreTexA from PCW/ISP/TSP + group header, expands strips, packs vertex colours, submits FUN_140048370 batches', matched=false;
UPSERT steam_routine:FUN_140844220 SET addr='0x140844220', name='FUN_140844220', role='blend preset: (src<<4|dst) PVR alpha instr pair -> ring cmd 1 preset table', matched=false;
UPSERT steam_routine:FUN_140844320 SET addr='0x140844320', name='FUN_140844320', role='sampler word: (filter, addr) -> ring cmd 2 = (filter==0 ? 0x10000 : 0) | addr<<17; stores ctx+0x1f8284/88', matched=false;
UPSERT steam_routine:FUN_140070940 SET addr='0x140070940', name='FUN_140070940', role='host renderer ring executor: walks DAT_140acd3a8+0xdbd08 records, selects D3D11 blend (by hash) / sampler / DSS / RS objects per cmd 1/2/8/9, issues batches', matched=false;
UPSERT steam_routine:FUN_1400483c0 SET addr='0x1400483c0', name='FUN_1400483c0', role='ring writer: 0x18-byte record {cmd, size, 1, seq} + payload at DAT_140acd3a8+0xdbd20', matched=false;
UPSERT steam_routine:FUN_14004b9a0 SET addr='0x14004b9a0', name='FUN_14004b9a0', role='ring writer for vertex batches (FUN_140048370): {prim, bytes, stride, texId, ignoreTexA, flag} + vertices', matched=false;
UPSERT steam_routine:FUN_140048810 SET addr='0x140048810', name='FUN_140048810', role='ring reset: cursor = base (+0xdbd08), bytes = 0', matched=false;
UPSERT steam_routine:FUN_140849c10 SET addr='0x140849c10', name='FUN_140849c10', role='draw entry: FUN_140848ee0(obj, 0, 1.0, kind 2) -- deck and plain list nodes', matched=false;
UPSERT steam_routine:FUN_140849c30 SET addr='0x140849c30', name='FUN_140849c30', role='draw entry: FUN_140848ee0(obj, 1, alpha, kind 3) -- flag-bit-5 nodes, alpha = node+0x90', matched=false;
UPSERT steam_routine:FUN_140849be0 SET addr='0x140849be0', name='FUN_140849be0', role='draw entry: FUN_140848ee0(obj, 1, alpha, ctx+0x1f8518 ? 3 : 1) -- flag-bit-5 nodes on lists 0xB/0xD', matched=false;
UPSERT steam_routine:FUN_140849ac0 SET addr='0x140849ac0', name='FUN_140849ac0', role='draw entry: FUN_140848ee0(obj, 2, 1.0, kind 2) when ctx+0x1f8520 -- flag-bit-13 nodes; param 2 = no cull word, colour mode forced -1', matched=false;
UPSERT steam_routine:FUN_1408499e0 SET addr='0x1408499e0', name='FUN_1408499e0', role='draw entry: FUN_140848ee0(obj, 0, 1.0, ctx+0x1f8518 ? 2 : 0) -- lists 0xB/0xD (HUD), kind 0 = V forced identity', matched=false;
UPSERT steam_routine:FUN_140036560 SET addr='0x140036560', name='FUN_140036560', role='empty stub (ret): FUN_140620cd0 calls it with the node scale, with 0x80 on flag bit 13 and with +0xA0 on bit 15 -- no effect on Steam', matched=false;

-- ── host-context globals (Steam only; ctx = DAT_142ef0ab0, R = DAT_140acd3a8) ───────────────────
UPSERT global:nl_ctx_blend_override SET name='nl_ctx_blend_override', steam_addr='DAT_142ef0ab0+0x1f8274', type='u32', note='PVR (src<<4|dst) pair used INSTEAD of the record TSP when the draw alpha multiplier (entry+0xCC) != 1.0. = 0x45 (SRCA, INV_SRCA), written only by FUN_140844a10. Copied to queue slot+0x1a and mapped by FUN_140842e30 to preset 0x32.';
UPSERT global:nl_ctx_depth_cmd_enable SET name='nl_ctx_depth_cmd_enable', steam_addr='DAT_142ef0ab0+0x1f8520', type='u32', note='= 1 (FUN_140607b50 @0x140607bfd). Enables the per-draw depth preset command 8 in FUN_1408482a0 and the FUN_140849ac0 path.';
UPSERT global:nl_ctx_no_perspective SET name='nl_ctx_no_perspective', steam_addr='DAT_142ef0ab0+0x1f8518', type='u32', note='Cleared by FUN_140847f20 (perspective set); read by FUN_1408499e0/FUN_140849be0 to pick kind 0/1 (V = identity in the queue entry) vs 2/3. In a fight the HUD lists run under FUN_14061d5b0 perspective -> 0 -> kind 0.';
UPSERT global:nl_ctx_uv_mode SET name='nl_ctx_uv_mode', steam_addr='DAT_142ef0ab0+0x1f8524', type='u32', note='Per-object UV mode copied to entry+0x10c; == 4 forces clampUV = 0 and adds entry+0x110/+0x114 to every UV in FUN_1408482a0. Reset to 0 by FUN_140848ee0 when the object changes. Never != 0 in the gate.';
UPSERT global:nl_ctx_colour_mult SET name='nl_ctx_colour_mult', steam_addr='DAT_142ef0ab0+0x1f825c', type='f32[3]', note='RGB vertex-colour multiplier set by FUN_140849b00 (clamped 0..1) from FUN_140620cd0 flags bits 10/11 (1.0 | node+0x94 | blk+0x6CA8 | product); copied into the queue entry +0xD0..0xD8 by FUN_1408436a0; applied as (int)(c*255*mult) in FUN_1408482a0.';
UPSERT global:nl_ctx_last_sampler SET name='nl_ctx_last_sampler', steam_addr='DAT_142ef0ab0+0x1f8284', type='u32[2]', note='(filter, addr) of the last FUN_140844320 call; reset 0/1 by FUN_1408441d0 and FUN_140844a10.';
UPSERT global:d3d_ring SET name='d3d_ring', steam_addr='DAT_140acd3a8+0xdbd08', type='ptr', note='Game -> host renderer command ring: base +0xdbd08, write cursor +0xdbd20, bytes +0xdbd28 (limit 0x200000), record count +0xdbd2c, sequence +0xdbd38. Records: 6 dwords {cmd, payload bytes, count, seq, x, y} + payload. Written by FUN_1400483c0 / FUN_14004b9a0, reset by FUN_140048810, executed by FUN_140070940.';

-- ── findings ─────────────────────────────────────────────────────────────────────────────────────
UPSERT finding:tsp_render_state_law SET date='2026-09-03', confidence='high', status='inferred',
  contribution_candidate=true,
  statement='STEAM RENDER STATE OF A WORLD-SPACE DRAW IS A FUNCTION OF THE RECORD HEADER, NOT A FLAG HEURISTIC. In FUN_1408482a0: (1) BLEND: src = TSP>>29, dst = TSP>>26&7 (PVR alpha instructions) when the draw alpha multiplier entry+0xCC == 1.0, else the constant ctx+0x1f8274 = 0x45 (SRCA, INV_SRCA); FUN_140844220 maps (src<<4|dst) to a preset: 0x10->1, 0x11/0x16->0x11, 0x14/0x41/0x46->0x12, 0x21->0x16, 0x22->0x22, 0x30->7, 0x31->0x19, 0x45->0x32, else 0. (2) SAMPLER: filter = TSP>>13&3 (0 = point, else linear); clampUV = TSP>>15&3 (bit15 U, bit16 V; 0 when ctx+0x1f8524 == 4); addr = 1 only when BOTH clamp bits are set (a single-axis clamp is WRAP on both axes), addr = 2 when either flip bit (17/18) is set; word = (point ? 0x10000 : 0) | addr<<17. (3) DEPTH preset: category cat/s19 from FUN_1408436a0 (PCW list type bits 26-24: 0 opaque -> cat 0 [kind 3: cat 0 if alpha == 1 else 3, s19 = 1], 1 -> cat 1, 2/3/4 translucent -> cat 3 sorted by the record sort key); flush FUN_140842e30 sends 10 (cat 2) | 2 (cat 3, s19 0) | 5 (s19 5) | 1; the consumer then sends 10 for cat 2, nothing for cat 3/s19 0 with Z-write enabled, 4 - (PCW bit 7 shadow) for Z-write enabled otherwise, 2 when ISP bit 26 (Z-write disable) is set. The ISP depth-compare and cull bits are NEVER read (every captured draw is LESS_EQUAL). (4) CULL: ring cmd 9 = polygon-group header word bits 1-0, per GROUP, only on kinds whose entry+0xC8 < 2 (deck, HUD, bit-5 nodes); the bit-13 path (FUN_140849ac0, param 2) sends none and inherits the previous state. (5) PIXEL SHADER: ignoreTexA = TSP bit 19 || (src == ONE && dst != ZERO) -> the IgnoreTexA (opaque) shader family, else texalpha; fog control TSP bits 23-22 is added to the batch id 0x2000. (6) TEXTURE: TCW & 0xFFFF, 0xFFFF when rec+0x20 (texNum) < 0 (then colour mode rec+0x24 clamped <= 0). (7) The draw KIND comes from FUN_140620cd0 on the node flags: bit 13 -> kind 2 param 2 (FUN_140849ac0); bit 5 -> kind 3 with alpha = node+0x90 (FUN_140849c30; FUN_140849be0 on lists 0xB/0xD); else kind 2 (FUN_140849c10) or kind 0 on lists 0xB/0xD (FUN_1408499e0, V = identity). Gate on 4 capgate packs vs the stage-11 tape: sampler, depth, cull, ps 824/824; blend 820/824 (the 4 = bit-5 nodes with an alpha multiplier the tape lacks).',
  note='CONFIRMED (decompile of FUN_1408482a0, FUN_1408436a0, FUN_140842e30, FUN_140620cd0, FUN_140844220, FUN_140844320, FUN_140844a10, FUN_140607b50, FUN_140849c10/c30/be0/ac0/9e0) + gate reproduction. Replaces the tape_to_seq heuristic (flags & 0x20 or list in 7/8/9 -> texalpha; one template state for all world draws).';
RELATE finding:tsp_render_state_law->cites->source:tsp_render_state_ghidra SET kind='cites';
RELATE finding:tsp_render_state_law->cites->source:tsp_render_state_gate SET kind='cites';
RELATE finding:tsp_render_state_law->about->steam_routine:FUN_1408482a0 SET kind='about';
RELATE finding:tsp_render_state_law->about->steam_routine:FUN_1408436a0 SET kind='about';
RELATE finding:tsp_render_state_law->about->steam_routine:FUN_140842e30 SET kind='about';
RELATE finding:tsp_render_state_law->about->steam_routine:FUN_140620cd0 SET kind='about';
RELATE finding:tsp_render_state_law->about->steam_routine:FUN_140844220 SET kind='about';
RELATE finding:tsp_render_state_law->about->steam_routine:FUN_140844320 SET kind='about';
RELATE finding:tsp_render_state_law->about->global:nl_ctx_blend_override SET kind='about';
RELATE finding:tsp_render_state_law->about->global:nl_ctx_depth_cmd_enable SET kind='about';
RELATE finding:tsp_render_state_law->about->global:nl_ctx_uv_mode SET kind='about';
RELATE finding:tsp_render_state_law->about->finding:3d_draw_emit_map SET kind='about';
UPDATE finding:tsp_render_state_law SET status='confirmed';

UPSERT finding:tsp_host_state_table SET date='2026-09-03', confidence='high', status='inferred',
  statement='HOST TABLE (ring code -> D3D11 state object). Executor FUN_140070940 (CONFIRMED structure): cmd 1 preset -> blend state by hash (1 and 0x32 -> the SAME object 0x23baf183; 0x11/0x12/0x21 -> 0xd3b1d189; 0x16 -> 0xb444c20a; 0x19 -> 0xcbec21a3; 0x22 -> 0xeb00e185; 0 -> 0x4d2c8180; 7 or preset&0x400 -> 0xa31e719d); cmd 2 word -> sampler [R2+0x20]+ (linear: addr1 +0x17f0, addr2 +0x3300, else +0x1790; point: +0x17e0 / +0x32f0 / +0x1780); cmd 8 -> DSS slot (1 +0x1e98, 2 +0x1ec8, 3 +0x1f08 with stencil ref 0x80, 4 +0x1f08, 5 +0x3678, 10 +0x3688, 11 +0x3698, default +0x1e88); cmd 9 -> RS (2 +0x2038, 3 +0x1f68, else +0x1f58). The D3D11 descs of those objects (INFERRED from the capture, single-valued per code over 824 draws): blend 1/0x32 -> (SRC_ALPHA, INV_SRC_ALPHA), 0x12 -> (SRC_ALPHA, ONE), srcA ONE / dstA ZERO always; sampler 0x0 -> (LINEAR, WRAP, WRAP), 0x10000 -> (POINT, WRAP, WRAP), 0x20000 -> (LINEAR, CLAMP, CLAMP), 0x30000 -> (POINT, CLAMP, CLAMP); depth 2 -> (write OFF, stencil off), 4 -> (write ON, stencil REPLACE ref 0); cull 1/2/3 -> NONE/FRONT/BACK (identity), 0 -> the same object as 1. UNKNOWN (never captured): blend 0x16/0x19/0x22/7/0, sampler flip words 0x40000/0x50000 (presumably MIRROR), depth 1/3/5/10/11. Refuted by any capture that maps one code to two states (tsp_gate.py --hist marks it AMBIGUOUS).',
  note='The object creation with the D3D11_*_DESC values was not located: the hashes occur only in FUN_140070940 and the Ghidra mega-blob FUN_14006a3f0; FUN_1402ed380 / FUN_1402f8220 write those offsets in unrelated objects. Stays INFERRED until that code is read.';
RELATE finding:tsp_host_state_table->cites->source:tsp_render_state_ghidra SET kind='cites';
RELATE finding:tsp_host_state_table->cites->source:tsp_render_state_gate SET kind='cites';
RELATE finding:tsp_host_state_table->about->steam_routine:FUN_140070940 SET kind='about';
RELATE finding:tsp_host_state_table->about->global:d3d_ring SET kind='about';
RELATE finding:tsp_host_state_table->about->finding:tsp_render_state_law SET kind='about';

UPSERT finding:nl_group_cull_word SET date='2026-09-03', confidence='high', status='inferred',
  statement='THE CULL MODE IS PER POLYGON GROUP, NOT PER RECORD. FUN_1408482a0 sends ring cmd 9 = group header word & 3 whenever it changes (entry+0xC8 < 2), and the executor maps 1 -> cull NONE, 2 -> FRONT, 3 -> BACK (0 -> NONE). In the stage-11 tape 4,099 of 39,585 records mix cull words across their groups, so a renderer must emit one D3D draw per group (or per run of equal words); a per-record cull is wrong for 10% of records. Gate: 824/824 on the four capgate packs. The other group bits seen: bit 3 = triangle list, bit 6 = submit as a strip (no CPU expansion), bits 2/4/5/7 (0x06, 0x72, 0xF2) UNKNOWN.',
  note='CONFIRMED by decompile + gate. Old nl_triangles read bit 0 as a winding flag; it is half of the cull word.';
RELATE finding:nl_group_cull_word->cites->source:tsp_render_state_ghidra SET kind='cites';
RELATE finding:nl_group_cull_word->cites->source:tsp_render_state_gate SET kind='cites';
RELATE finding:nl_group_cull_word->about->steam_routine:FUN_1408482a0 SET kind='about';
RELATE finding:nl_group_cull_word->about->finding:tsp_render_state_law SET kind='about';
UPDATE finding:nl_group_cull_word SET status='confirmed';

UPSERT finding:nl_strip_winding_steam SET date='2026-09-03', confidence='high', status='inferred',
  statement='STRIP WINDING. FUN_1408482a0 expands every strip group on the CPU (unless group bit 6) into a triangle LIST: even i -> (v[i], v[i+1], v[i+2]), odd i -> (v[i+2], v[i+1], v[i]); triple (list) groups are copied verbatim; the group cull bits do NOT alter the order. Gate: the captured pack triangles (rotation-invariant, winding-preserving) equal this expansion on 824/824 matched draws; the previous ModNao-style rule (swap on even triangles when bit 0 is clear, reorder lists) reproduced only 133/454. It never showed because the world template raster was cull NONE; with the per-group cull word applied the Steam rule is required. Bit-6 (0x72/0xF2) 5-vertex strips are captured in VB order (v0, v2, v1, v4, v3): some record with the same geometry reproduces the draw, the reordering consumer is UNKNOWN.',
  note='CONFIRMED by decompile (strip loop after the vertex copy in FUN_1408482a0) + gate.';
RELATE finding:nl_strip_winding_steam->cites->source:tsp_render_state_ghidra SET kind='cites';
RELATE finding:nl_strip_winding_steam->cites->source:tsp_render_state_gate SET kind='cites';
RELATE finding:nl_strip_winding_steam->about->steam_routine:FUN_1408482a0 SET kind='about';
RELATE finding:nl_strip_winding_steam->about->finding:nl_group_cull_word SET kind='about';
UPDATE finding:nl_strip_winding_steam SET status='confirmed';

UPSERT finding:world_vertex_colour_multipliers SET date='2026-09-03', confidence='high', status='inferred',
  statement='VERTEX COLOUR0 of a world draw = ARGB8 of (record alpha @+0x2C x entry+0xCC alpha multiplier, record RGB @+0x30..0x38 x entry+0xD0..0xD8) each as (int)(f*255*m) clamped to 255, stored little-endian (bytes B,G,R,A) in vertex word 8; word 9 (offset colour) = 0 unless the config lighting flag PTR_DAT_140acd3a0[0x44f4] & 0x10 (0 in every capture). The RGB multiplier comes from FUN_140620cd0 flags bits 10/11 via FUN_140849b00: 1.0 (bit 10 clear) or blk+0x6CA8..0x6CB0 (bit 11) or node+0x94..0x9C (bit 10) or their product; the alpha multiplier is node+0x90 on bit-5 nodes. Colour mode rec+0x24 == -3 -> per-vertex BGRA @+0x10 times the same multipliers. Gate: 647/776 exact with all multipliers 1.0; the misses are node multipliers (127 = 0.5, alpha 127/51) and the training deck tint (B,G,R = 0,0,255 on identity-W quads).',
  note='CONFIRMED by decompile; the tape carries node+0x94 (used now) but not node+0x90 nor blk+0x6CA8.';
RELATE finding:world_vertex_colour_multipliers->cites->source:tsp_render_state_ghidra SET kind='cites';
RELATE finding:world_vertex_colour_multipliers->cites->source:tsp_render_state_gate SET kind='cites';
RELATE finding:world_vertex_colour_multipliers->about->steam_routine:FUN_1408482a0 SET kind='about';
RELATE finding:world_vertex_colour_multipliers->about->global:nl_ctx_colour_mult SET kind='about';
UPDATE finding:world_vertex_colour_multipliers SET status='confirmed';

UPSERT finding:world_node_alpha_mult_not_in_tape SET date='2026-09-03', confidence='high', status='open',
  statement='The 96-byte anode row (list@0, flags@4, matrix@8, colour +0x94..@72, obj@84, model@88) does not carry node+0x90, the f32 alpha multiplier that flag-bit-5 nodes pass to FUN_140849c30/be0. When it is != 1.0 Steam (a) forces normal blending (ctx+0x1f8274 = 0x45 instead of the record TSP), (b) moves an opaque-list record into the sorted translucent category, (c) scales the vertex alpha. Effect measured: 4 of 106 additive (SRCA/ONE) draws in the gate were really normal-blended, and alpha-127/51 vertex colours on bit-5 nodes. Fix: add +0x90 (4 B) to the anode row; tape_to_seq assumes 1.0 meanwhile. blk+0x6CA8..0x6CB0 (deck / bit-11 tint, 12 B) is the other missing multiplier.',
  note='Falsifier of the explanation: a blend miss on a node without flag bit 5.';
RELATE finding:world_node_alpha_mult_not_in_tape->cites->source:tsp_render_state_gate SET kind='cites';
RELATE finding:world_node_alpha_mult_not_in_tape->about->finding:tsp_render_state_law SET kind='about';
RELATE finding:world_node_alpha_mult_not_in_tape->about->steam_routine:FUN_140849c30 SET kind='about';
