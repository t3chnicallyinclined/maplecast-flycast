-- 198_display_options_internal_resolution.surql -- DISPLAY OPTIONS of the Fighting Collection host:
-- per-title settings record (filter A..H, screen size, x2/x3/x4 scale), the scene render target
-- (2048x1024 chosen from the DISPLAY height, not the scale), the centered viewport sub-rect the game
-- own draw list is rasterised into, the compose pass (filter technique table, output rect), and what
-- SUPERGUN must do to reproduce each option. 2026-09-06, SUPERGUN lane.
-- Method: seed constants (0x27f/0x1df native rect, 0x800/0x400 RT dims, 0x5a0/0x780 display thresholds,
-- the 9-entry technique table, the x%d format string) -> call graph -> the anchor own captured heap.
-- Forward slashes only in ref/note; no apostrophes anywhere in this file.
USE NS re DB kb;

UPSERT source:display_options_re_20260906 SET kind='disasm', strength='code',
  ref='Ghidra dumpproj / mvc_dump.bin: FUN_14006f200 + FUN_14006f370 (uAppUnit ctors, vtable 0x1408e3520/0x1408e3530), FUN_140073820 (vt+0x50 update), FUN_140073cc0 (vt+0x38 RT create), FUN_140073ac0 (output rect), FUN_14006f5e0 (vt+0x68 compose), FUN_1400704c0 (drawHalf), FUN_140070940 (drawJack executor, :8080 decompile), FUN_140607b50 (native rect), getters FUN_14003f680/f6a0/f7e0/f840/fcd0/fcf0/fd10/fd30 + setters FUN_140040ae0/40b00/40be0/40c40/410a0/410c0/410e0/41100, menu FUN_140097c40/FUN_1400974a0/FUN_140097830/FUN_140097fe0, FUN_1402b80f0 @0x1402b88f6 and FUN_1402b9930 (nDraw+0xd0..0xdc writers), FUN_14003fa60/FUN_140040da0 (game-option bytes, NOT display). Tables read from exe_image.bin: 0x140a502f0 (9 x {u32 id, u32 variant}), DAT_140a5a288 (letter strings A..I), DAT_140a5a2f8 = {0x206,0x20b,0x20e,0x214,0x210}, DAT_1408e9f60 = x%d. Steam disasm cache d3dcap/replay/re_map/cache/steam_disasm.jsonl for the offset sweeps.',
  note='Scratchpad internal_resolution.md (session 193726f3). All addresses live (no ASLR).';
UPSERT source:display_options_anchor_read_20260906 SET kind='capture', strength='reproduction',
  ref='mvc-live-skins-quarters/d3dcap/ttd/runs/vs-01/pre: host_device.bin (+0x1ac = 5, +0xd04b8 = 0x3c8c00a0, +0xd0499 = 1), regions/000000003b450000_20000000.bin (the settings blob), install config.ini [DISPLAY] Resolution=1024x768, capgate scene_*_2048x1024_f87.bmp and the 1280x960 viewport in docs/RECEIPT-RUNNER-RENDER.md 3.2.',
  note='Title 5 record: +0x1d8=0, +0x1dc filter=0, +0x1e0 screen size=1, +0x1e4=0, +0x1e8=10, +0x1ec=10, +0xb44 scale=1. Titles 0-4,6: +0x1d8=1, filter=4, screen size=0, scale=0 (defaults). Game-option bytes blob+0x5a2f0.. = 05 00 01 00 00 | ff ff ff 02 01 01 02 02 00 00 07 01 01 00 00 00 00 00 00 (config+0x298 speed = 2, matches seed 189).';

-- ---------------------------------------------------------------- routines
UPSERT steam_routine:FUN_14006f200 SET addr='0x14006f200', name='FUN_14006f200',
  role='uAppUnit ctor (class-info 0x140bd3d18, size 0xe8, vtable 0x1408e3530): unit+0xac = hostdev+0x1ac (title index); +0xb0 = filter (FUN_14003fcd0), +0xb4 = screen size (FUN_14003fd10), +0xb8 = orientation (FUN_14003fcf0), +0xbc = scale (FUN_14003f7e0) all from hostdev+0xd04b0 for that title; +0xc0 divisor = 1; +0xd8 = 0x81; +0xe0 = -1.0f, +0xe4 = 2.0f. FUN_14006f370 is the same ctor without the allocation.';
UPSERT steam_routine:FUN_140073820 SET addr='0x140073820', name='FUN_140073820',
  role='uAppUnit vt+0x50 per-frame UPDATE: +0x7c/+0x80 = display w/h = nDraw+0xd8-0xd0 / +0xdc-0xd4; re-reads filter/screen size/orientation/scale from the title record; native w/h = config+0x1dc-0x1d8+1 x config+0x1e4-0x1e0+1 -> +0x8c/+0x90; clamps scale: max index 1 if disp_h < 0x5a0, 2 if < 0x780, else 3 (writes it back via FUN_140040be0); scaled = native*(scale+1) -> +0x98/+0x9c; +0xc0 = 1 then for filter in 3..7: while disp_h < 4*h and h > 0x1bf: +0xc0 *= 2, h /= 2; any change -> FUN_140073ac0.';
UPSERT steam_routine:FUN_140073cc0 SET addr='0x140073cc0', name='FUN_140073cc0',
  role='uAppUnit vt+0x38 RENDER TARGET CREATE: h = nDraw+0xdc - nDraw+0xd4 (display height); h < 0x5a0 -> 0x800x0x400 (2048x1024); h < 0x780 -> 0xc00x0x600 (3072x1536); else 0x1000x0x800 (4096x2048) -> +0x84/+0x88; two sets (ping-pong, index +0x78) of three nDraw textures via FUN_14026ff60: full (fmt 0x27, type 2, flags 0x10) at +0x48, half-height (fmt 0x27) at +0x58, fmt 0xf type 5 flags 0x80 at +0x68. If config+0x1a8 != 0 (software framebuffer titles) instead 512x256 fmt 0x27 type 4. The size does NOT depend on the scale option.';
UPSERT steam_routine:FUN_140073ac0 SET addr='0x140073ac0', name='FUN_140073ac0',
  role='OUTPUT RECT from the screen size mode (+0xb4): aspect n/d = 4/3 if mode in {1,3} else 10/7; 16/9 if config+0x48 == 2 and native_w != 0x180. Non-rotated (config[0x4c]&4 == 0 or +0xb8 != 0): mode 0/1 -> h = disp_h, w = n*h/d & ~1 (fit height); mode 2/3 -> h = floor(disp_h / native_h) * native_h (integer multiple; native_h halved first if taller than the display), w = n*h/d & ~1; mode >= 4 -> w,h = display (stretch). Rotated variants swap the roles. +0xcc = w + 2*(+0xc4), +0xd0 = h + 2*(+0xc8) (margins, 0 from the ctor).';
UPSERT steam_routine:FUN_14006f5e0 SET addr='0x14006f5e0', name='FUN_14006f5e0',
  role='uAppUnit vt+0x68 COMPOSE PASS: rt = +0x48[+0x78]; if config+0x1a8 == 0: FUN_140070940 (ring executor, gate config+0x774) then FUN_1400704c0 (drawHalf when +0xc0 > 1); source rect = CENTERED (sw, sh/div) inside (RTw, RTh) from rt+0x30 dims-word; output quad in NDC = +-(outw/disp_w), +-(outh/disp_h) with outw/outh = +0xcc/+0xd0, vertically flipped by (+0xa8 xor ((config[0x4c]&2) != 0 vs config+0x1e8 != 0)); filter +0xb0 < 9: technique 0x140a502f0[+0xb0] = {id, variant}, CB 8 floats {RTw, RTh, sw, sh/div, outw, outh, 1.0, outh/outw}; else technique 0x4866ab56 with CB {texw, texh, 1/texw, 1/texh}. Then FUN_14033e250 submit.';
UPSERT steam_routine:FUN_1400704c0 SET addr='0x1400704c0', name='FUN_1400704c0',
  role='drawHalf PRE-PASS (technique 0xa583bb16 = package index 0xb16): only when unit+0xc0 >= 2; copies the centered (sw, sh) rect of the full RT into the centered (sw, sh/div) rect of the half-height texture +0x58[+0x78] via FUN_1402b3e20; returns the half texture as the compose source. Used by the scanline filter family (filter 3..7).';
UPSERT steam_routine:FUN_140070940 SET addr='0x140070940', name='FUN_140070940',
  role='drawJack RING EXECUTOR: reads unit+0x98/+0x9c (scaled w/h) and the RT dims-word; viewport/scissor rect = ((RTw-sw)/2, (RTh-sh)/2, sw, sh) via FUN_140343cc0, also handed to the VS as the drawJack CB (x0,y0,x1,y1, RTw/2); ring at hostdev+0xdbd08 (count +0xdbd2c), textures via FUN_14004a950/FUN_14004a910; the ONLY option-derived input is unit+0x98 -- no scale-dependent UV snapping, no upload-size change.';
UPSERT steam_routine:FUN_140607b50 SET addr='0x140607b50', name='FUN_140607b50',
  role='arena carve at mode entry (seed 173/177) AND the native viewport rect: config+0x1a8 = 0 (no software framebuffer), config+0x1d8 = 0, +0x1dc = 0x27f, +0x1e0 = 0, +0x1e4 = 0x1df -> 640x480; config+0x4dc = config+0x28c; then FUN_140048810(0), FUN_1408441d0, FUN_140608690, FUN_140607e90.';
UPSERT steam_routine:FUN_14003fcd0 SET addr='0x14003fcd0', name='FUN_14003fcd0',
  role='per-title settings getter FILTER: *(blob + title*0x9ac + 0x1dc), blob = *(param_1+8) with param_1 = hostdev+0xd04b0 (so blob = *(hostdev+0xd04b8)); title < 0x14. Siblings: FUN_14003f680 +0x1d8 (frame/wallpaper kind 0), FUN_14003fd10 +0x1e0 (screen size), FUN_14003fcf0 +0x1e4 (orientation, vertical titles), FUN_14003f6a0 +0x1e8 and FUN_14003fd30 +0x1ec (sliders 0..10 -> config+0x2cc/+0x2d0 = v*12+7), FUN_14003f840 +0xa40, FUN_14003f7e0 +0xb44 (SCALE). Setters: FUN_140040ae0 (+0x1d8), FUN_1400410a0 (+0x1dc), FUN_1400410e0 (+0x1e0), FUN_1400410c0 (+0x1e4), FUN_140040b00 (+0x1e8), FUN_140041100 (+0x1ec), FUN_140040c40 (+0xa40), FUN_140040be0 (+0xb44).';
UPSERT steam_routine:FUN_140097c40 SET addr='0x140097c40', name='FUN_140097c40',
  role='DISPLAY SETTINGS MENU init (title = menu+0x418): rows kind/label/help/count: [0] +0x1d8 label 0x205 help 0x219 count 4; [1] FILTER label 0x20a help 0x21a count 9 (default FUN_14004a560); [2] SCREEN SIZE label 0x20d help 0x21b count 5 (default FUN_14004a580); [3] only if config[0x4c]&4: orientation label 0x213 count 2; if title == 5: SCALE label 0xa73 help 0xa74 count 4 (row index kept at menu+0x41c); if title < 7: two sliders labels 0x216/0x217 count 11 default 10; last row kind 7 (0xa4/0xa5 reset). Handler FUN_1400974a0 (state 1 = FUN_140097830 edit, state 2 = apply all rows, 3 = mark dirty hostdev+0xd0499). Labels FUN_140097fe0: value 0 -> text DAT_140a5a2f8[kind] (0x206/0x20b/0x210), kind 0/1 value v>=1 -> text 0x20c + space + DAT_140a5a288[v] letter (A..H for filters 1..8), kind 2 -> text 0x20e+v, kind 4 v>=1 -> format x%d with v+1 (x2/x3/x4).';
UPSERT steam_routine:FUN_140097830 SET addr='0x140097830', name='FUN_140097830',
  role='display menu EDIT state: recomputes the scale row count from the display height every frame (disp_h < 0x5a0 -> 2 choices, < 0x780 -> 3, else 4) and clamps the stored scale; kind switch writes the record through the setters; sets DAT_142ebbdf0+0xa8 |= 4 (filter object refresh) after a change; kind 0 nonzero toggles bit 2 of the same flag word.';

-- ---------------------------------------------------------------- globals
UPSERT global:display_settings_blob SET addr='n/a', steam_off='*(hostdev+0xd04b8) ; hostdev = *(0x140acd3a8)', type='persisted settings blob (heap)',
  note='Per-title record stride 0x9ac indexed by hostdev+0x1ac (MvC2 = 5): +0x1d8 frame kind 0 (0..3), +0x1dc filter (0 = OFF, 1..8 = A..H), +0x1e0 screen size (0..4), +0x1e4 orientation (vertical titles only), +0x1e8/+0x1ec sliders (0..10), +0xb44 scale (0..3 = x1..x4; only title 5 shows it). The same blob holds the game-option bytes at +0x5a2f0.. (seed 189) and per-title stats at +0x2fefc + title*0x878*4 (FUN_14003fa00). Dirty flag hostdev+0xd0499.';
UPSERT global:app_filter_technique_table SET addr='n/a', steam_off='0x140a502f0', type='u32[9][2] {technique id, variant}',
  note='[0] 0x11cccb57/0 (TAppFilter, PS_AppFilterCopy = filter OFF), [1] 0x11cccb57/1 (PS_AppFilterArcade = A), [2] 0xc5f3bb58 (B), [3] 0xb6fadb59 (C), [4] 0xffa0eb5a (D), [5] 0x8ca98b5b (E), [6] 0x19b22b5c (F), [7] 0x6abb4b5d (G), [8] 0x9b625b5e (H). Low 12 bits 0xb57..0xb5e are consecutive package indices; 0x4866ab56 (0xb56) is the plain path, 0xa583bb16 (0xb16) drawHalf. Names from nativeDX11x64/app_shader/AppShaderPackage.mfx: TAppFilter, TAppFilterB..H; sources mention af_filter_lanczos/sharp (A), mask_line (B), ce_filter_lanczos + scan_bright/scan_beam/scan_weight (C), scanlineWeights (D), dotMaskWeights (E), Crts* CRT (F), scanLineWeight (G).';
UPSERT global:uAppUnit_compose_unit SET addr='n/a', steam_off='vtable 0x1408e3520 (alt 0x1408e3530), size 0xe8', type='SceneDraw unit',
  note='+0x40 ctx; +0x48/+0x50 full RTs, +0x58/+0x60 half-height, +0x68/+0x70 depth; +0x78 ping-pong index; +0x7c/+0x80 display w/h; +0x84/+0x88 RT w/h; +0x8c/+0x90 native w/h (640x480); +0x98/+0x9c scaled w/h; +0xa0/+0xa4 aspect n/d; +0xa8 flip; +0xac title; +0xb0 filter; +0xb4 screen size; +0xb8 orientation; +0xbc scale; +0xc0 half divisor; +0xc4/+0xc8 margins; +0xcc/+0xd0 output w/h. vt+0x38 FUN_140073cc0 create, vt+0x50 FUN_140073820 update, vt+0x68 FUN_14006f5e0 compose.';

-- ---------------------------------------------------------------- findings
UPSERT finding:display_options_live_in_per_title_record SET status='inferred', confidence='high', date='2026-09-06',
  title='The Collection display options (frame, filter A..H, screen size, x2/x3/x4 scale) are per-title u32 fields of the persisted settings blob, not config+0x284..0x2c8',
  statement='blob = *(hostdev+0xd04b8), record = blob + title*0x9ac, title = hostdev+0x1ac (MvC2 = 5, read from the vs-01 anchor host_device.bin). Fields: +0x1d8 kind-0 option 0..3 (menu row 0, letter labels, INFERRED frame/wallpaper: nonzero enables a filter-object flag bit and the companion view unit FUN_14006d0e0), +0x1dc FILTER 0..8 (0 = OFF via text 0x20b, 1..8 shown as text 0x20c + A..H), +0x1e0 SCREEN SIZE 0..4 (text 0x20e+v), +0x1e4 orientation (row only when config[0x4c]&4, never for MvC2), +0x1e8/+0x1ec sliders 0..10 feeding config+0x2cc/+0x2d0 = v*12+7 (audio, INFERRED), +0xb44 SCALE 0..3 shown as text 0x210 / x2 / x3 / x4 (format DAT_1408e9f60 = x%d with v+1); the scale row exists ONLY for title 5 (FUN_140097c40 @ menu+0x418 == 5) and its choice count is 2/3/4 for display heights < 1440 / < 1920 / >= 1920 (FUN_140097830, FUN_140073820 both clamp). The bytes at blob+0x5a2f5..0x5a307 -> config+0x284..0x2c8 (seed 189) are the GAME options (speed at +0x298), not display. Menu label strings are localisation text ids (0x205..0x21e, 0xa73/0xa74) with no exe string: names UNKNOWN.',
  consequence='Captured vs-01 record for title 5: frame 0, filter 0 (OFF), screen size 1 (4:3 fit), scale 1 (x2). Test to CONFIRM the encoding live: change one option in the Collection display menu and re-read [[[0x140acd3a8]+0xd04b8]+5*0x9ac+0x1dc/0x1e0/0xb44] with EvalExpression while running; the dirty byte hostdev+0xd0499 goes 1.';

UPSERT finding:scene_rt_size_follows_display_height SET status='inferred', confidence='high', date='2026-09-06',
  title='The scene render target is 2048x1024 / 3072x1536 / 4096x2048 chosen from the DISPLAY height (< 1440 / < 1920 / else), never from the scale option; format id 0x27 = DXGI 87 B8G8R8A8_UNORM',
  statement='FUN_140073cc0 (uAppUnit vt+0x38): h = nDraw+0xdc - nDraw+0xd4 (display rect written by the D3D bring-up FUN_1402b80f0 @0x1402b88f6 and the resize path FUN_1402b9930; the capture ran config.ini [DISPLAY] Resolution=1024x768): h < 0x5a0 -> 0x800 x 0x400; h < 0x780 -> 0xc00 x 0x600; else 0x1000 x 0x800. Two ping-pong sets of {full, half-height, depth} textures via FUN_14026ff60 (nDraw::Texture create, fmt 0x27 / 0xf). The capture measured the scene RT as 2048x1024 f87 (capgate scene_*_2048x1024_f87.bmp), consistent with 768 < 1440 and fmt 0x27 == DXGI_FORMAT 87. The thresholds are exactly the ones that make the maximum scale fit: x2 = 960 <= 1024, x3 = 1440 <= 1536, x4 = 1920 <= 2048.',
  consequence='2048x1024 is not a constant of the game; a runner that hard-codes it is right only for displays under 1440 rows. The RT is a fixed maximum for the display class and the game draws into a centered sub-rect of it.';

UPSERT finding:scale_option_is_viewport_multiple_only SET status='inferred', confidence='high', date='2026-09-06',
  contribution_candidate=true,
  title='x2/x3/x4 = the game display list rasterised by the GPU into a centered 640*(s+1) x 480*(s+1) viewport of the scene RT; the sim, the ring, UVs and texture uploads are untouched',
  statement='Native rect = config+0x1d8..0x1e4 = (0, 0x27f, 0, 0x1df) written by FUN_140607b50 at mode entry -> 640x480 (unit+0x8c/+0x90). FUN_140073820: unit+0x98/+0x9c = native * (scale+1) after clamping scale to the display class. FUN_140070940 (drawJack executor) reads ONLY unit+0x98 from the unit: viewport/scissor = ((RTw-sw)/2, (RTh-sh)/2, sw, sh) via FUN_140343cc0 and the same rect as the drawJack CB (x0,y0,x1,y1,RTw/2); vertices come from the ring at hostdev+0xdbd08 in the sim 640x480 space, textures from FUN_14004a950/FUN_14004a910 (the DC-RAM page uploads of seed 187). Nothing on the sim side (FUN_140118950 / FUN_140607d60 / the ring emit FUN_140843eb0) reads the unit or the settings record. The vs-01 anchor: scale 1 -> 1280x960 centered at (384, 32) in 2048x1024, which is exactly the 1280x960 viewport RECEIPT-RUNNER-RENDER.md 3.2 diffs over.',
  consequence='For SUPERGUN a larger internal resolution is purely a rasterisation-resolution choice: the same display list, the same textures, a bigger viewport. Drawing at window size is NOT the same as the game at x2: the game rasterises at an integer multiple of 640x480 and then resamples that to the output rect in the compose pass.';

UPSERT finding:compose_pass_filter_and_screen_size SET status='inferred', confidence='high', date='2026-09-06',
  contribution_candidate=true,
  title='Compose pass FUN_14006f5e0: centered source rect -> output rect from the screen size mode, through one of 9 AppFilter techniques; filters C..G first halve the source until it has <= 447 rows or the display is >= 4x taller',
  statement='Source = centered (sw, sh/div) of the RT (div = unit+0xc0). Output rect (unit+0xcc/+0xd0, FUN_140073ac0): screen size 0/1 = fit display height at aspect 10:7 (mode 0) or 4:3 (mode 1); 2/3 = integer multiple of the native height (pixel-perfect) at the same two aspects; >= 4 = stretch to the display; 16:9 forced when config+0x48 == 2 and native_w != 384; rotated variants when config[0x4c]&4 and orientation == 0. Quad NDC = +-(outw/dispw), +-(outh/disph), vertical flip from unit+0xa8 xor the config[0x4c]&2 / config+0x1e8 test. Filter unit+0xb0 < 9 -> table 0x140a502f0[filter] {technique id, variant}: 0 = 0x11cccb57/0 (TAppFilter PS_AppFilterCopy, plain resample), 1 = 0x11cccb57/1 (PS_AppFilterArcade, A), 2..8 = 0xc5f3bb58, 0xb6fadb59, 0xffa0eb5a, 0x8ca98b5b, 0x19b22b5c, 0x6abb4b5d, 0x9b625b5e (TAppFilterB..H; pairing INFERRED from the consecutive 12-bit indices 0xb57..0xb5e and the consecutive technique names in AppShaderPackage.mfx). CB = {RTw, RTh, sw, sh/div, outw, outh, 1.0, outh/outw}. For filter 3..7 (C..G, the scanline/CRT family) FUN_140073820 sets div = 2^k with disp_h < 4*h and h > 0x1bf, and FUN_1400704c0 (drawHalf, technique 0xa583bb16) box-halves the source height div times before the filter. filter >= 9 -> technique 0x4866ab56 with {texw, texh, 1/texw, 1/texh}. Sampler ids set in the pass: 0x7fa75002 / 0xabee5001 (which D3D filter mode: UNKNOWN, read the sampler desc in a capture).',
  consequence='Filter OFF at x2 on a 1024x768 window = rasterise 1280x960, then one textured quad resampling 1280x960 -> 1024x768 (4:3 fit). Any scanline filter at x2 on 1080p first halves 960 -> 480 -> 240 rows (1080 < 4*480), then shades scanlines from a 240-row source. Reproducing A..H needs the technique bodies from the user own AppShaderPackage.mfx (not in the exe).';

UPSERT finding:supergun_display_option_reproduction SET status='inferred', confidence='high', date='2026-09-06',
  contribution_candidate=true,
  title='SUPERGUN: to match the game per display option, rasterise the list into an offscreen RT at 640*(s+1) x 480*(s+1) and present through the compose math; filter OFF is a single resample, A..H need the user own shader package',
  statement='What the runner already does (gfx.rs present: draw at window size into a 4:3 letterbox) equals the game only in the limit where window == 640*(s+1) x 480*(s+1) and filter OFF. Faithful per option: (1) SCALE s: rasterise the display list with the viewport ((RTw-sw)/2, (RTh-sh)/2, sw, sh), sw = 640*(s+1), sh = 480*(s+1), into an RT sized by the game rule (2048x1024 below 1440 display rows, 3072x1536 below 1920, else 4096x2048; or any RT >= sw x sh since the compose only samples the centered rect); clamp s to 1/2/3 by display height as FUN_140073820 does. (2) SCREEN SIZE m: output rect from FUN_140073ac0 (m=1: h = disp_h, w = 4h/3 & ~1; m=3: h = floor(disp_h/480)*480; m=0/2 the same at 10:7; m>=4 stretch), centered. (3) FILTER 0: one quad sampling the centered sw x sh rect into the output rect with the pass sampler (mode UNKNOWN until read from a capture; the Path B captures carry every sampler desc). FILTER 1..8: the TAppFilter..TAppFilterH techniques with the 8-float CB, plus the drawHalf halving for 3..7 -- techniques live in the user install (nativeDX11x64/app_shader/AppShaderPackage.mfx), so BYOR-style load at runtime, never commit. Nothing changes on the sim/tick side: G+*, blk, the ring and the uploads are identical for every option (Gates 1/2 remain the gate for the tick; the render gate is the pixel gate of RECEIPT-RUNNER-RENDER.md 3.2 at the SAME settings record as the capture: title 5 filter 0, screen size 1, scale 1, window 1024x768).',
  consequence='Do not equate our window-size raster with x2/x4: the game rasterises at an integer multiple then resamples. The first numeric render gate must be run at the anchor settings (filter OFF, 4:3 fit, x2, 1024x768) so the compose is a single bilinear-class resample on both sides; any other setting is a change to the render that needs its own capture.';

UPSERT finding:sh4_steam_pairs_display_options SET status='inferred', confidence='high', date='2026-09-06',
  title='Display options have NO SH4 twin: the whole chain is host-side MT Framework code added by the port',
  statement='Native rect, RT creation, compose, filter table and the settings record are host code (uAppUnit / nDraw / the Collection menu) with no marvelous2 counterpart; the only game-side touch points are the 640x480 native rect written by the arena carve FUN_140607b50 (Steam-only) and the ring the sim emits (FUN_140843eb0 = the same display list on DC). Fingerprints used: 0x27f/0x1df, 0x5a0/0x780, 0x800/0x400/0xc00/0x600/0x1000/0x800, 0x1bf, the x%d string, the 9-entry technique table.',
  consequence='Function matching against the SH4 side is not applicable here; confirmation comes from the anchor heap (done) and from live reads of the settings record while toggling the menu (pending).';

-- ---------------------------------------------------------------- edges
RELATE finding:display_options_live_in_per_title_record->cites->source:display_options_re_20260906 SET id='e198_rec_src';
RELATE finding:display_options_live_in_per_title_record->cites->source:display_options_anchor_read_20260906 SET id='e198_rec_anchor';
