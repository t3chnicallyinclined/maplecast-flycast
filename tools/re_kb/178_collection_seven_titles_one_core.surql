-- 178_collection_seven_titles_one_core.surql -- the Fighting Collection runs all SEVEN titles through
-- ONE outer loop and ONE per-title frame-function slot; the six CPS titles are a MAME-shaped emulator
-- behind that slot, and Capcom SHIPS their boot anchors in the arcs. 2026-09-07.
-- Paths use forward slashes: a backslash in a single-quoted SurrealQL string is an invalid escape.
USE NS re DB kb;

UPSERT source:collection_multititle_ghidra_20260907 SET kind='static', strength='code',
  ref='Ghidra dumpproj / mvc_dump.bin base 0x140000000 (file offset == RVA), plus raw reads of the same image and of the arc TOCs under Steam/steamapps/common/MARVEL vs. CAPCOM Fighting Collection/nativeDX11x64/arc/pc.',
  note='Decompiled FUN_14004b600, FUN_14004e5c0, FUN_140050830, FUN_140118950, FUN_140113600, FUN_140112200, FUN_140112450, FUN_140111510, FUN_140113880, FUN_140110100, FUN_140111d10 and FUN_140111e20, FUN_140112d90, FUN_140116630 / 140116670 / 1401162f0 / 1401165f0 / 140116cb0, FUN_1400fb5a0. Import closures computed by BFS over Ghidra disassembly from the MvC2 frame fn and from the CPS frame fn plus every CPU-core and video entry point.';

UPSERT finding:collection_per_title_frame_dispatch SET confidence='high', date='2026-09-07',
  contribution_candidate=true,
  title='FUN_140118950 is NOT MvC2-specific: it is the Collection generic frame advance for all seven titles, and the per-title entry point is the function pointer at config+0x10',
  statement='FUN_140118950(frame_counter_ptr, inputs_ptr) increments the frame counter, rotates the four seat words config+0x218..0x224 into +0x228..0x234, writes the new seat words through the seat map config+0x258..0x264, then TAIL-CALLS *(config+0x10). config = *(0x140acd3a0) = 0x140ac6d40. config+0x08 is an int32 GAME INDEX, 0..6, and 5 == MvC2. FUN_14004b600 is the whole fork: if config+0x08 != 5 it calls FUN_1401135e0 (emulator machine_start) else FUN_140607b50 (the MvC2 arena carve). FUN_140050830 is the title selector: it reads the game index from hostdev+0x1ac and the revision from hostdev+0x1b0, fills config+0x08 / +0x0c / +0x30 (current romset name) / +0x38 (base romset) / +0x44 (driver index) / +0x4c / +0x54, and at 0x14005096f sets config+0x10 = FUN_140113600 when the game index is NOT 5 and NULL when it IS (MvC2 installs its own FUN_140607D60 later, at 0x140607c07 inside FUN_140607b50).',
  consequence='A SUPERGUN shell already calls the multi-title entry point. Driving a CPS title is the same call with a different value in config+0x08 and config+0x10, not a different loop.';

UPSERT finding:collection_driver_table_is_mame_shaped SET confidence='high', date='2026-09-07',
  contribution_candidate=true,
  title='The Collection carries a MAME-shaped drivers[] array at 0x140a5c5a0 with 14 entries, and the mvsc2 rows have NULL machine pointers -- MvC2 is native, the other six are emulated',
  statement='PTR_PTR_140a5c5a0 is a NULL-terminated array of 14 pointers to 0x50-byte driver descriptors: [0] xmcotau [1] xmcotaj [2] mshj [3] mshh [4] xmvsfu [5] xmvsfj [6] mshvsfu [7] mshvsfj [8] mvscu [9] mvscj [10] mvsc2 [11] mvsc2u [12] punisheru [13] punisherj. Descriptor: +0x00 romset name, +0x08 title string, +0x10 region and date string, +0x18 machine_config builder, +0x20 driver init, +0x28 third init hook, +0x30 ROM-region descriptor list, +0x38 input-port list. mvsc2 and mvsc2u have NULL at +0x18, +0x20, +0x28 and +0x38 -- no machine, no ROM regions, no ioports. FUN_140112070 / FUN_1401120f0 / FUN_140112180 are lookup-by-name, index-by-name and description-by-name. The per-GAME table is separate: 0x140a4e038, stride 0x50, seven rows, six qword romset-name pointers at +0x00..+0x2F then per-game bytes (+0x30 to config+0x40, +0x31 to config+0x48, +0x32 to config+0x50, +0x33 to config+0x54 which is the settings-descriptor index 2..8 of finding:mvc2_match_settings_descriptor_table, +0x35 to config+0x5c, +0x38 dword to config+0x4634). Row 2 (X-Men vs Street Fighter) is the only one with six names: xmvsfj, xmvsfu, xmvsfjr1, xmvsfur1, xmvsfjr2, xmvsfur2, and FUN_14004e5c0 folds config+0x2ac (0..2) into the revision index for exactly that game.',
  consequence='Naming a title is (game index, revision index) to romset to driver index. The arc file is game_<game><rev>.arc, built with the format string at 0x1408dd558.';

UPSERT finding:cps_emulator_core_map SET confidence='high', date='2026-09-07',
  contribution_candidate=true,
  title='The Collection CPS1/CPS2 core is a MAME-shaped emulator entirely in static image memory: frame fn FUN_140113600, machine 0x141043890, machine_config 0x141043A10, CPU table 0x1410424A0 stride 0x78, CPU contexts 0x140F42490 stride 0x20000',
  statement='config+0x10 for a CPS title = FUN_140113600 (thunk to FUN_140112610): gate FUN_140113dd0, then FUN_140113880 (ioport read), then loop FUN_14010fd70 (scheduler timeslice) until DAT_141043a0c >= 1. FUN_140112200(driver_index) is machine_start: zeroes the 0x178-byte machine at DAT_140a5c618 = 0x141043890, sets machine[0] = driver desc and machine[1] = the 0x560-byte machine_config at 0x141043A10, calls desc+0x18 to build it, FUN_140111240 to bind the four device interfaces, desc+0x20 driver init, allocates the screen bitmaps via FUN_14010eb40, sets *(config+0x1a8) = the 1024x512x32 final RGBA framebuffer, calls machine_config+0x520 video_start. FUN_1400fb5a0 is the shared CPS2 machine_config: M68000 at 16 MHz (address map 0x140a5bd90) plus Z80 at 8 MHz (map 0x140a5be40), refresh float 0x426e8cb4 = 59.6394 Hz, 512x256 with visarea 64..447 by 16..239 = 384x224, 0x1000 palette entries, screen_update FUN_1400f8c40 at machine_config+0x538; it also installs config+0x18 = FUN_1400f65c0, the CPS vblank and present hook. Device interfaces (MAME cpu_get_info shape, table 0x1408fee70, four entries): 0 = FUN_140110ed0 dummy, 1 = m68000 FUN_1400b1dc0 context 0x130, 2 = z80 FUN_1400f46f0 context 0xE0, 3 = sh2 FUN_1400e3b40 context 0x378 (present, unused by these seven titles). FUN_140111510 is cpu_init: the per-CPU instance record is 0x1410424A0 + slot*0x78 (+0x38 execute, +0x50 context size, +0x68 device type, +0x70 context pointer) and the CPU CONTEXT is 0x140F42490 + slot*0x20000. FUN_140110f80(cpu, cycles) runs one CPU through instance+0x38. The Z80 opcode dispatch is the 1536-entry (6 x 256) table at 0x1408FAFF0, indexed at 0x1400ed251. ROM regions: FUN_140112450 walks drivers[config+0x44]+0x30, a list of {u32 size, u32 region_id, u32} triplets terminated by size 0, lays them end to end from *(config+0x00) (the same resident-payload base field MvC2 uses for the arena), and caches base at config+0xD0+id*8 and size at config+0x160+id*4. CPS2 list 0x1408fed70 = {0x1000000 id0, 0x2000000 id4, 0x50000 id1, 0x800000 id10, 0x800000 id12}, total 0x4050000; CPS1 / Punisher list 0x1408fe6d8 = {0x1000000 id0, 0x800000 id4, 0x50000 id1, 0x400000 id10}, total 0x1c50000.',
  consequence='Every piece of emulator state a shell must place is a fixed in-image address -- no ASLR, no dynamically allocated machine object. The presentable output is one pointer: *(config+0x1a8).';

UPSERT finding:cps_frame_import_surface_equals_mvc2 SET confidence='high', date='2026-09-07',
  contribution_candidate=true,
  title='Stepping one CPS frame reaches EXACTLY the same 29 IAT slots as stepping one MvC2 frame -- zero extra file, D3D, audio, socket or thread imports',
  statement='BFS direct-call closure over Ghidra disassembly. Root set A = FUN_140607d60 plus FUN_140118950 (MvC2): 577 functions, 29 distinct absolute-pointer indirect call targets, all in 0x1408db000..0x1408dc000 (the IAT). Root set B = FUN_140113600 plus every m68000 core entry (0x1400b24b0, 0x1400b1d40, 0x1400b2430, 0x1400b2210, 0x1400b2380, 0x1400b1d30, 0x1400b1ce0), every z80 core entry (0x1400f4be0, 0x1400f4660, 0x1400f4b50, 0x1400eebc0, 0x1400f1060, 0x1400ed1e0, 0x1400e38c0) and the CPS video and interrupt hooks (0x1400f8c40, 0x1400f8920, 0x1400ff710, 0x1400ffa90, 0x1400ff8a0, 0x140110d00, 0x1400f9dc0, 0x1400f9f90, 0x1400f65c0, 0x1400f4e50): 605 functions, 30 targets. Set difference B minus A = { 0x140bd4fc0 } and that is NOT an IAT slot -- it is a function-pointer field inside the m68000 CPU context block (0x140bd4e94 + 0x12c, within the 0x130-byte context), set by the core itself. A minus B is empty. Both closures terminated naturally, well under the 9000-function cap. The residual register-indirect calls in B are the CPU instance table 0x1410424A0 and the Z80 and 68000 opcode tables, all in-image.',
  consequence='The exact C6 import set SUPERGUN already replaces (0x1408db240 RtlAllocateHeap, 0x1408db140 RtlReAllocateHeap, 0x1408db238 HeapFree, 0x1408db2d8 GetLastError, 0x1408db510 SetLastError) plus the two no-oped critical-section slots 0x1408db190 and 0x1408db108 covers a CPS frame with nothing added.',
  caveat='This is the FRAME. Machine START (FUN_140112200) and the ROM load are a separate closure and were not measured; the ROM blob arrives through the resource-manager vtable +0x60 at 0x140036ec6 and 0x1400382ee, which IS host file I/O.';

UPSERT finding:collection_ships_boot_anchors_for_cps SET confidence='high', date='2026-09-07',
  contribution_candidate=true,
  title='Capcom SHIPS the CPS boot anchors: every CPS arc holds bin/<romset> plus TWO jacksave save states, and the Collection boots a title by machine_start then restoring state slot 0',
  statement='FUN_14004e5c0 is start-selected-title: read game and rev from hostdev+0x1ac and hostdev+0x1b0, FUN_14003fa60 copies a boot-state record out of the host-device session block (*(hostdev+8)+0x5A2F0 = {u16 game, u16 rev, about 0x14 setting bytes, u32 size at +0x5A308, payload at +0x5A30C}) into state slot 0, start the machine (FUN_140607b50 for MvC2, FUN_1401135e0 for CPS), then FUN_140111d10(0) = LOAD STATE SLOT 0. FUN_140111d10 and FUN_140111e20 are load and save and branch on config+0x1a8: non-zero (emulated title) uses the MAME-shaped state registry, zero (MvC2) is a straight memcpy of *(config+0x1c0) for *(config+0x1c8) bytes -- the blk region. The state slot buffers are STATIC: base 0x141083FE0, stride 0x10000C, ten slots keyed by the trailing digit of the name; each slot is 0x100000 payload plus u32 cursor at +0x100000, u32 valid size at +0x100004, u32 mode at +0x100008 (FUN_140112d90, FUN_140112e30, FUN_140112e90). The serialised image is staged at 0x141C88B10 and begins with the 8-byte magic 0x657661736b63616a (jacksave) written by FUN_140116630; FUN_140116cb0 assigns each registered item an offset starting at 0x18, FUN_140116670 saves and FUN_140116340 loads. On disk: every CPS arc under arc/pc has exactly three ARC v7 entries -- bin/<romset>, state/<romset>-1, state/<romset>-2. Decompressed state size is 848030 bytes for all five CPS2 titles and 823442 bytes for The Punisher (CPS1). game_50.arc (MvC2) has ONE entry, bin/mvsc2, and NO state.',
  consequence='The anchor-based product model is the Collection own model. For a CPS title the anchor is a roughly 0.8 MB jacksave image the user already owns, and slot 0 is the runtime anchor netplay overwrites so both peers start identical.',
  caveat='848030 and 823442 are the ARC decompressed entry sizes. The authoritative runtime total is DAT_141c8549c after FUN_140116cb0, or the u32 at slot+0x100004; neither has been read live.';

UPSERT finding:cps_inputs_use_the_same_seat_words SET confidence='high', date='2026-09-07',
  contribution_candidate=true,
  title='The CPS emulator reads the SAME per-seat input words the MvC2 tick reads: config+0x218 + seat*4',
  statement='FUN_140113880, called once per CPS frame from FUN_140113600, walks the driver ioport list at *(*DAT_140a5c618 + 0x38) (driver desc +0x38), stride 0x34 bytes per entry, and for each entry tests *(u32*)(config + player*4 + 0x218) against the per-ioport-type mask table DAT_140a5c6c0 + type*4, accumulating into the port value. Those are exactly the four seat words FUN_140118950 writes from the GGPO and seat map. Type 0x28 reads config + player*2 + 0x284 instead (an analogue or dial field).',
  consequence='A shell that already produces seat words for MvC2 needs no new input path for a CPS title; only the ioport mask table changes, and it is per-driver data in the image.';

RELATE finding:collection_per_title_frame_dispatch->cites->source:collection_multititle_ghidra_20260907 SET id='e178_dispatch';
RELATE finding:collection_driver_table_is_mame_shaped->cites->source:collection_multititle_ghidra_20260907 SET id='e178_drivers';
RELATE finding:cps_emulator_core_map->cites->source:collection_multititle_ghidra_20260907 SET id='e178_core';
RELATE finding:cps_frame_import_surface_equals_mvc2->cites->source:collection_multititle_ghidra_20260907 SET id='e178_imports';
RELATE finding:collection_ships_boot_anchors_for_cps->cites->source:collection_multititle_ghidra_20260907 SET id='e178_anchors';
RELATE finding:cps_inputs_use_the_same_seat_words->cites->source:collection_multititle_ghidra_20260907 SET id='e178_inputs';

-- status last: the schema asserts a 'confirmed' finding already cites a code/reproduction source.
UPDATE finding:collection_per_title_frame_dispatch SET status='confirmed';
UPDATE finding:collection_driver_table_is_mame_shaped SET status='confirmed';
UPDATE finding:cps_emulator_core_map SET status='confirmed';
UPDATE finding:cps_frame_import_surface_equals_mvc2 SET status='confirmed';
UPDATE finding:collection_ships_boot_anchors_for_cps SET status='confirmed';
UPDATE finding:cps_inputs_use_the_same_seat_words SET status='confirmed';
