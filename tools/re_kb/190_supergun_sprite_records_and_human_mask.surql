-- 190_supergun_sprite_records_and_human_mask.surql -- the SUPERGUN RE agents wrote these five
-- findings LIVE on 2026-09-06 (Ghidra over mvc_dump.bin, gated on the running game); this file
-- makes them rebuildable. Seed 187 cites three of them. Forward slashes only in ref/note.
USE NS re DB kb;

UPSERT source:supergun_sprite_records_20260906 SET kind='disasm', strength='code',
  ref='GhidraMCP over mvc_dump.bin: FUN_140620f10 (walker), FUN_1406129f0 (per-sprite emitter), FUN_140845e20, FUN_1408436a0 (display-list writer), FUN_1408458b0 (opcode 0xC consumer, disasm 0x1408459b7..0x140845b0e), FUN_140048370 (submit), FUN_140612430 (per-entity tile registrar), FUN_140614210 (LZSS), FUN_1408456a0 (tile copy-out), FUN_140845fa0, FUN_1406127c0 (init slot registration), FUN_140845fe0, FUN_1408435d0, FUN_140613390 (palette upload), FUN_14060e170 (battle machine case 0), FUN_140611a20 (match machine), FUN_140118950 / FUN_14060b7d0 / FUN_140048630 / FUN_140619840 (input routing). Anchors d3dcap/ttd/runs/20260903-000941 and -001536 pre/blk.bin; runner CGEOM / RING LIVE logs.',
  note='Constants read from raw exe bytes where stated (0x1408e2a44 = 0.5, 0x1408dd5a8 = 1.0, 0x1408e2a68 = 2pi, 0x14092a584 = 1/65536; tile order tables PTR_DAT_140a75020 / PTR_DAT_140a75130).';

UPSERT finding:supergun_char_opcode0c_subrect SET status='confirmed', confidence='high', date='2026-09-06',
  contribution_candidate=true,
  title='Characters are opcode 0xC display-list records, one per tile, carrying explicit sub-rect UVs; the world path (opcodes 0..3) never sees them',
  statement='FUN_140620f10 -> FUN_1406129f0 -> FUN_140845e20 -> FUN_1408436a0(0xC, rec, size): the sole writer of the ctx+0x30 list sets item+4 = the kind, and characters are kind 0xC (stage and models are 0..3 / 0..5). FUN_1406129f0 loops parts x tiles and emits one 0xC record per tile. The consumer FUN_1408458b0 expands each record to 4 vertices and submits FUN_140048370(0x4000, vbuf, stride 0x1C, 4 verts, texid). Record layout: +0x00 key = (bank+1)<<16 | slot, +0x04 x, +0x08 y, +0x0C z (the converted sort key), +0x10 scaleX, +0x14 scaleY, +0x18 u0, +0x1C v0, +0x20 u1, +0x24 v1, +0x28 rotation (u16 angle), +0x2C alpha (<= 0 dropped), +0x30 mode (!= 0 category 3), +0x34 flags (&3 x anchor, &0xC y anchor, 0x10 flipU, 0x20 flipV, 0x1000 blend). Tile pixel W/H come from the runtime slot table ctx+0x1e00a0 + slot*0x18 (+0x02 fmt, +0x04 palette bank, +0x06 w, +0x08 h, +0x10 host texture), built per frame, so it cannot be ripped offline.',
  consequence='A shell that draws only opcodes 0..3 renders the stage perfectly and no characters; a shell that draws 0xC records from a stale slot table with synthesized UVs scatters the body. rec+0x38/+0x3C (a secondary UV pair via FUN_140842c80) and flag bits 0x800 / 0x20800: INFERRED, not load-bearing.';

UPSERT finding:supergun_body_tile_pixel_source SET status='confirmed', confidence='high', date='2026-09-06',
  contribution_candidate=true,
  title='Body tile pixels have no stable DC-RAM address at draw time: FUN_140612430 decodes each entity into one scratch window and FUN_1408456a0 copies every tile out into the staging ring at config+0x208',
  statement='FUN_140612430 (one call per entity, before the walker): pixelCursor = 0x0CE60000 is a LOCAL reset per entity; node+0x120 = blk+0x32BF0 is the global running tile cursor; cell = node+0x1B0 + u32[node+0x1B0 + (sid&0x7FFF)*4], count = u16[cell], records of 8 bytes {i16 xoff, i16 yoff, u16 sel (bits 4..9 palette bank, 0x4000 flipY, 0x8000 flipX), u16 partIndex}; part = node+0x1A8 + u32[node+0x1A8 + partIndex*4] with +0/+1 logical w/8 h/8, +2/+3 storage w/8 h/8, +4.. LZSS stream; FUN_140614210(part+4, storageW*storageH/2, dcram + 0xE60000 + (pixelCursor - 0x0CE60000)). Tile size T = 32 unless storage is 16 or 8 wide (or 2 / 1 rows of 8 tall); bytesPerTile = T*T/2; tiles are contiguous; per tile k: slot = blk+0x32BE8 + cursor + k, FUN_140845fa0(slot, sel>>4 & 0x3F) sets the palette bank, FUN_1408456a0(slot, src) copies the bytes OUT, ALLOC_LIST[blk+0x339F8] = {b0 = T, b1 = nTiles-1, b2 = tbl[k].col, b3 = rows - tbl[k].row} with the tile order tables PTR_DAT_140a75020 (wide parts) / PTR_DAT_140a75130 (tall parts) in a tile-level Morton walk. FUN_1408456a0 (only caller FUN_140612430): n = w*h/2 for fmt&0xF00 == 0x500, w*h for 0x700, w*h*2 for 0x100/0x900; if *(config+0x208) != 0 it appends to the ring at *(config+0x208) + *(config+0x214): 6 x u32 header {0, slot, w, h, fmt, n} then n bytes, config+0x210 count++, +0x214 += n + 0x18; else FUN_140048910 immediately. Every live slot 0x10..0x30F is registered at init by FUN_1406127c0 from 768 x 16-byte descriptors at dcram+0xE60C00 = {u32 0x00200020, u32 fmt 0x0502, u64 loc 0x0CE60000} via FUN_140845fe0 -> FUN_1408435d0, so 32x32 for an 8x8 tile is by design: each T x T tile is a Morton block of T*T/2 bytes at the head of a 32x32 twiddled upload, landing top-left, which is why the emitter addresses an 8-px tile at u in [0, 0.25], v in [0.75, 1]. fmt 0x0502 = PAL4 (high byte 5 => n = w*h/2), type byte 2. Palette uploads come from the staged row blk+0x2C40 + i*0x20, rebuilt from blk+0x1040 + i*0x38 when the dirty byte +0x08 is set (dirty&1 raw, else dirty&2 half intensity (c>>1 & 0x777) | (c & 0xF000)) by FUN_140613390; reading +0x1040 raw misses the halved variant.',
  consequence='A shell must read the ring (or the upload routine) every tick; the bank-header location holds nothing for these slots. The runner (seed 187) walks the ring and zeroes config+0x210/+0x214 per tick.';

UPSERT finding:supergun_sprite_consumer_flip_anchor_rule SET status='confirmed', confidence='high', date='2026-09-06',
  contribution_candidate=true,
  title='FUN_1408458b0: the exact anchor, UV flip, strip and rotation rule of an opcode 0xC quad, and how FUN_1406129f0 sets the bits from facing',
  statement='W = u16[desc+6] * rec.scaleX, H = u16[desc+8] * rec.scaleY, a = rec.flags. xoff = (a&3)==3 ? W : (a&3)==2 ? floorf(W*0.5) : 0 ((a&3)==1 -> 0, NOT W); yoff = (a&0xC)==0xC ? H : (a&0xC)==8 ? floorf(H*0.5) : 0; L = rec.x - xoff, T = rec.y - yoff, R = L+W, B = T+H. u0/v0/u1/v1 = rec+0x18/+0x1C/+0x20/+0x24; if (a & 0x10) { u0 = 1-u0; u1 = 1-u1 }; if (!(a & 0x20)) { v0 = 1-v0; v1 = 1-v1 } (V inverted when 0x20 is CLEAR). Strip V0 = (L,T,u0,v0), V1 = (L,B,u0,v1), V2 = (R,T,u1,v0), V3 = (R,B,u1,v1), stride 0x1C = x, y, z (+0x0C), u, v, rec+0x38, rec+0x3C. Rotation when rec+0x28 != 0: th = -((u16)rec+0x28 * 2pi / 65536), each corner rotated about the ANCHOR point (rec.x, rec.y). NDC: hw = *(ctx+0x1f82a4)*0.5, hh = *(ctx+0x1f82a8)*0.5, x = (x-hw)/hw, y = (hh-y)/hh. The emitter FUN_1406129f0 sets base = *(blk+0x32BE0) | (facing == 0 ? 0xD : 0xF) with facing = node+0x154 (facing-1 tiles carry rec.x = the right edge), 0x10 = sel.bit15 XOR (facing != 0), 0x20 = sel & 0x4000; default UVs (0, 1-t, t, 1) and when flipped (1-t, .., 1, ..) so the consumer inversion yields the mirror within the tile own [0, t]. Position mirroring about the logical box is baked into rec.x by the emitter; the consumer only flips texels.',
  consequence='Port verbatim. The runner had xoff inverted ((a&3)==1 -> W), flip hard-coded and the record UVs discarded: one facing coincidentally cancelled, the other drew away from the opponent.';

UPSERT finding:human_cpu_seat_determinant SET status='confirmed', confidence='high', date='2026-09-06',
  contribution_candidate=true,
  title='G+0x84 = blk+0x3D3C is the human-side bitmask (bit0 = P1 side, bit1 = P2 side); battle init sets every fighter to CPU and clears the human sides from it',
  statement='FUN_14060e170 (battle scene machine, dispatched by G+3), case 0 = battle init: sets all six fighters CPU flag fighter+0x6B1 (blk+0x4469 / +0x4BA1 / +0x52D9 / +0x5A11 / +0x6149 / +0x6881, stride 0x738) = 1, then if (G+0x84 & 1) clears P1-side fighters 0/2/4 to 0 and if (G+0x84 & 2) clears P2-side fighters 1/3/5. Polarity from the set-site: +0x6B1 1 = CPU/AI, 0 = human. Input still reaches every fighter (FUN_140118950 -> config+0x218, FUN_14060b7d0 / FUN_140048630 -> blk+0x3C66, FUN_140619840 copies each seat word to its side unconditionally); a CPU fighter just has its input overwritten by the AI. G+0x84 is written by the roster character-select scene at lock-in and carried in blk; the match machine FUN_140611a20 only reads it (case 2: G+0x84 | G+0x85), battle init only reads it, the only in-match writer is the KO round-transition tail (masks it down). It is not re-derived from config at battle entry: config+0x794 (mode word, written only by FUN_140037b50, read by FUN_140038430 / FUN_1400ac540 for loader selection) does not build the mask. Two real battle anchors (20260903-000941 and -001536) hold blk+0x3D3C = 0x03 with all six +0x6B1 = 0.',
  consequence='A rematch that restores blk from the select anchor (where the mask is 0) and jumps to battle leaves both sides CPU; the seat map (config+0x258..) and a config reload do not touch it. The per-frame reader of +0x6B1 that chooses AI vs pad: INFERRED (set-site + anchor correlation only).';

-- INFERRED, deliberately: the status assert refuses inferred -> confirmed without the numeric gate
-- below, and only a smoke check (P1 responds, humanMask logged 0x03) has run. Leave it so until
-- the blk gate runs.
UPSERT finding:supergun_rematch_both_cpu_fix SET status='inferred', confidence='high', date='2026-09-06',
  title='The same-team rematch restores G+0x84 (blk+0x3D3C) and G+0x18 (blk+0x3CD0) captured at match start, before the G+3 = 0 tick',
  statement='The runner snapshots rd8(blk+0x3D3C) and rd8(blk+0x3CD0) at the G+1 == 2 / G+2 == 0 commit tick (before battle init consumes them) and writes them back after the select-anchor restore and the roster write set, before the tick that runs battle init; G+0x18 is the master mask that flows to G+0x85 via FUN_140611a20 case 0. Smoke-checked on screen: REMATCH humanMask G+0x84 = 0x03 restored, P1 under human control.',
  gate='NOT YET RUN: the rematch battle-entry blk must match a real same-roster match at blk+0x3D3C and the six +0x6B1 flags (Gate 1 / N1 comparison against a captured battle anchor).',
  consequence='A byte write is a sim change until gated; the seat map (config+0x258..) and a config reload were shown NOT to be the determinant.';

RELATE finding:supergun_char_opcode0c_subrect->cites->source:supergun_sprite_records_20260906 SET id='e190_rec_src';
RELATE finding:supergun_body_tile_pixel_source->cites->source:supergun_sprite_records_20260906 SET id='e190_pix_src';
RELATE finding:supergun_sprite_consumer_flip_anchor_rule->cites->source:supergun_sprite_records_20260906 SET id='e190_rule_src';
RELATE finding:human_cpu_seat_determinant->cites->source:supergun_sprite_records_20260906 SET id='e190_mask_src';
RELATE finding:supergun_rematch_both_cpu_fix->cites->finding:human_cpu_seat_determinant SET id='e190_fix_mask';
RELATE finding:supergun_body_tile_pixel_source->cites->finding:supergun_char_opcode0c_subrect SET id='e190_pix_rec';
RELATE finding:supergun_sprite_consumer_flip_anchor_rule->cites->finding:supergun_char_opcode0c_subrect SET id='e190_rule_rec';
RELATE finding:supergun_sprite_consumer_flip_anchor_rule->cites->finding:mvc_tiled_flip_logical_box SET id='e190_rule_flip';

UPDATE finding:supergun_char_opcode0c_subrect SET status='confirmed';
UPDATE finding:supergun_body_tile_pixel_source SET status='confirmed';
