UPSERT routine:loc_8c0376e0 SET label='loc_8c0376e0', pc='0x8C0376E0', bank='bank03', role='Training Mode Pause (4 items: CONTINUE / TRAINING MENU / BUTTON CONFIG / MODE MENU; text table bank13 loc_8c1366c4). Item 1 activates the training options struct T=0x8c212ccc (+0xE=1). Entry loc_8c14D350[2].';
UPSERT routine:loc_8c03813a SET label='loc_8c03813a', pc='0x8C03813A', bank='bank03', role='Training menu MAIN page (cursor T+1, 5 items mod 5 via bank12 loc_8c1292d4; subpage table bank14 loc_8c14D35C = main/dummy/options/exit/charselect). On leaving applies options via loc_8c037fc0.';
UPSERT routine:loc_8c0383dc SET label='loc_8c0383dc', pc='0x8C0383DC', bank='bank03', role='Training DUMMY page (cursor T+2, 4 items): item0/1/2 set T+4 = 0/1/2, T+0xF = (1<<side)/0xFF/0, T+5..8 = 0, GameGlobal+0x18 = (1<<side) or 3 (item2 = human controls the dummy), G+0x84 = 0, G+0x85 = G+0x8c = G+0x18, then loc_8c0380c8 (round reset); item3 = back.';
UPSERT routine:loc_8c038662 SET label='loc_8c038662', pc='0x8C038662', bank='bank03', role='Training OPTIONS page (cursor T+2, 8 items): 0 -> T+0xD (range 2), 1 -> T+0x19 (2), 2 -> T+9 (2), 3 -> T+0xA (8), 4 -> T+0xB (4), 5 -> T+0xC (3, game speed), 6 = DEFAULT (T+0xA=T+0xB=T+0xC=1, T+0xD=T+9=T+0x19=0), 7 = EXIT. Left/right = pad bits 0x0800/0x0400, wrap via bank12 loc_8c1292d4 mod.';
UPSERT routine:loc_8c037fc0 SET label='loc_8c037fc0', pc='0x8C037FC0', bank='bank03', role='APPLY training options into GameGlobal: G+0xa7=T+6, G+0xa8=T+7, G+0xa9=T+8, G+0xaa=T+0xD, G+0x83=T+0xA (CPU level 0..7), G+0x1b=T+0xB (damage 0..3), G+0x89=T+0xC (speed 0..2), G+0xae=T+9 (damage display), G+0xac=T+0x19, then bank04 loc_8c046a2a (speed triple from G+0x89).';
UPSERT routine:loc_8c038028 SET label='loc_8c038028', pc='0x8C038028', bank='bank03', role='Training options INIT: zero T+0..0xD,+0x19; T+0xA=T+0xB=T+0xC=1; apply (loc_8c037fc0); G+0xa6 = 0; if G+0x4c == 2 (training) G+0xa6 = 1 and T+0xF = G+0x18.';
UPSERT routine:loc_8c0380c8 SET label='loc_8c0380c8', pc='0x8C0380C8', bank='bank03', role='Training round reset after a dummy change: G+2..7 = 0, G+0x8d/0x8e = 0, G+0x19 = 1, bank04 loc_8c044d8c, apply options, then object/list resets.';
UPSERT routine:loc_8c046ddc SET label='loc_8c046ddc', pc='0x8C046DDC', bank='bank04', role='Text Displays (HUD WINS %2d / NEW HERO / score): Training Mode Check at loc_8c046e0c: if GameGlobal+0x4c == 2 skip. == Steam FUN_140627c50.';
UPSERT routine:loc_8c047218 SET label='loc_8c047218', pc='0x8C047218', bank='bank04', role='Damage display trigger: battle state (0x8c2896b0 byte) == 4 && G+0xae && 0x8c212d65 bits -> loc_8c04712c(1) / loc_8c04712c(0). == Steam FUN_140628320 tail (0x8c212d65 == DAT_142edf2d1).';
UPSERT routine:loc_8c04712c SET label='loc_8c04712c', pc='0x8C04712C', bank='bank04', role='Damage display text DAMAGE / TOTAL DAMAGE / MAX COMBO (bank13 loc_8c13a2e4/loc_8c13a2f0/loc_8c13a300). == Steam FUN_1406281a0.';
UPSERT routine:loc_8c03d894 SET label='loc_8c03d894', pc='0x8C03D894', bank='bank03', role='Stage select by mode byte: G+0x4c == 2 (training) -> stage byte = 0x0B (Training Room stg_Train); == 5 -> other path.';

-- this pair already existed as a fingerprint-only edge (confidence high, method fingerprint); promote it in place.
UPDATE recompiles:FUN_140627c50_loc_8c046ddc SET confidence='confirmed', method='seed+decompile', evidence='fingerprint b:3d6a/3d10/3ce1/3d43/3d3c/3d04 plus decompile: same strings WINS %2d (bank13 loc_8c13a2ac / 0x14097e838) and NEW HERO (loc_8c13a2d8 / 0x14097e868), same G+0x4c == 2 early exit, same G+0x8b branch';
RELATE steam_routine:FUN_140628320->recompiles->routine:loc_8c047218 SET id='FUN_140628320_loc_8c047218', confidence='confirmed', method='seed+decompile', evidence='same gate battle state 4 && G+0xae && static bitmask (0x8c212d65 <-> 0x142edf2d1, delta 0xB6CCC56C exact) -> side 1 then side 0';
RELATE steam_routine:FUN_1406281a0->recompiles->routine:loc_8c04712c SET id='FUN_1406281a0_loc_8c04712c', confidence='confirmed', method='seed+decompile', evidence='same three strings DAMAGE / TOTAL DAMAGE / MAX COMBO and %3d';

-- ---------------------------------------------------------------------------------------------------
-- FINDINGS
-- ---------------------------------------------------------------------------------------------------
UPSERT finding:steam_training_mode_is_config_0x828 SET status='inferred', confidence='high', date='2026-09-06',
  contribution_candidate=true,
  title='The Steam build knows it is in TRAINING when config+0x828 != 0 (session+0xd0330 family); the DC mode byte G+0x4c == 2 is never written on Steam',
  statement='config+0x828 = session+0xd0334 + 1 iff session+0xd0330 != 0 (FUN_140037b50). Three independent consumers make it the training discriminator: (1) FUN_140611a20 case 0 sets G+0xa6 = 1 iff config+0x828 != 0 (0x140611c1f-0x140611c2e); (2) the scene-entry label caseD_3 at 0x14060be3e sets G+0x4d = 3 (infinite clock) iff config+0x828 != 0, else G+0x2a = 1 iff config+0x7c0 (versus); (3) FUN_140038430 allocates the ui/1_menu/19_training objects (atklog2, keylog, keyrecorder) iff config+0x828 != 0. Measured: select-01 and all eight 20260903 battle anchors carry config+0x828 = 1, G+0xa6 = 1, G+0x4d = 3, G+0x2a = 0; vs-01 and receipt-20260903-stage9-anchor carry config+0x80c = 1, config+0x828 = 0, G+0xa6 = 0, G+0x4d = 2, G+0x2a = 1. G+0x4c: a whole-image search finds only writers of the value 0 (caseD_3 0x14060be5a/be99/bee0/bf1d, FUN_14060e170/FUN_14060e250 0x14060e29a); the DC value 2 (SH4 Training Mode Check bank04 loc_8c046e0c, stage select loc_8c03d894) is dead on Steam, so the G+0x4c == 2 branches in FUN_140627c50, FUN_14062e090 and FUN_14060e170 caseD_7 never run.',
  consequence='Training vs versus is a HOST decision carried in host_device.bin (session+0xd0330 vs +0xd0338) and mirrored into config by FUN_140037b50 at scene load, then baked into blk at scene entry (G+0x4d, G+0x2a) and match init (G+0xa6). A select anchor captured in versus (vs-01) differs from a training one in: session+0xd0330/+0xd0334/+0xd0338, config+0x828/+0x82c/+0x80c/+0x810/+0x814/+0x7c4/+0x7d8/+0x818..+0x820 (FUN_140037b50), G+0xa6, G+0x4d, G+0x2a, and the select turn token blk+0x33a00 (1 vs 255). select-01 IS a training select anchor and needs no conversion.';

UPSERT finding:select01_anchor_is_training_not_arcade SET status='inferred', confidence='high', date='2026-09-06',
  title='CORRECTION: the select-01 anchor is a TRAINING character select, not ARCADE',
  statement='finding:select_load_state_differs_per_mode (seed 176) labels select-01 as ARCADE from session+0xd0330 = 1. select-01/pre/blk.bin holds G+0xa6 = 1 and G+0x4d = 3 (blk+0x3D5E, blk+0x3D05), the two bytes only the config+0x828 path writes (FUN_140611a20 case 0 and caseD_3 0x14060be7b), and select-01/pre/exe_image.bin holds config+0x828 = 1. The eight 20260903 battle anchors (recorded as live training matches in seeds 162/163) show the identical pattern. session+0xd0330 != 0 is the training family.',
  supersedes='Only the ARCADE label in seed 176; the measured values there are correct.',
  consequence='Every SUPERGUN Gate 1/2/3 battle anchor is a training-mode state: health floors at 1 and the round clock never decrements in those captures. A true 1P arcade capture does not exist in the anchor set (arcade would be the FUN_140037b50 ladder branch with config+0x828 == 0 && +0x80c == 0 && +0x7f8 == 0, config+0x794 stays 0: UNKNOWN, never measured).';

UPSERT finding:steam_training_health_floor_G_0xa6 SET status='inferred', confidence='high', date='2026-09-06',
  contribution_candidate=true,
  title='Infinite health in training = G+0xa6 (blk+0x3D5E): every damage path floors health at 1 instead of killing; regen is a separate host toggle',
  statement='G+0xa6 is the DC training flag (SH4 loc_8c038028 sets it iff GameGlobal+0x4c == 2; Steam FUN_140611a20 case 0 sets it iff config+0x828 != 0). Readers: FUN_14063cbc0, FUN_140639d00, FUN_14063afd0, FUN_14063cf60 -- when fighter+0x578 (health, max 0x90 = 144) would reach <= 0 they write +0x578 = 1 and +0x57c (red) >= 1 instead of the KO path FUN_1406394b0; FUN_140639200 arms fighter+0x472 = 0x32 on every hit taken; FUN_14063b920 (per frame, battle state 4) counts +0x472 down and then adds +2 health and +2 red per frame up to 0x90, but ONLY for side k whose config+0x878+k*4 != 0 (0x878 = P1 side point fighter, 0x87c = P2 side). Anchors: config+0x878 = 0x87c = 1; 20260903-001536 P2 point hp 63 red 83 +0x472 50; 20260903-001645 hp 70 red 90 +0x472 47.',
  consequence='No KO can happen while G+0xa6 = 1, so the runner KO-freeze / rematch logic never fires in training by construction. Turning regen off per side is config+0x878/0x87c = 0 (host field, outside blk).';

UPSERT finding:steam_training_infinite_time_G_0x4d SET status='inferred', confidence='high', date='2026-09-06',
  contribution_candidate=true,
  title='Infinite time in training = G+0x4d == 3 (blk+0x3D05): the round clock is loaded with 99 and never decremented',
  statement='G+0x4d indexes DAT_140a6fa70 = [30, 60, 99, 99] (round seconds) in FUN_1406274f0 (round init: battle+0x60 = battle+0xa6 = table[G+0x4d]) and FUN_140626eb0; FUN_140626fe0 decrements battle+0x60 once per DAT_140a6fa74[G+0x46] frames ONLY if G+0x4d != 3. Defaults: FUN_14060b440 G+0x4d = DAT_142edf22a (2 = 99 s, DC 0x8c212cbe), FUN_140608690 G+0x4d = 2; caseD_3 0x14060be7b writes 3 iff config+0x828 != 0. Measured: training anchors G+0x4d = 3, versus anchors 2. G+0x46 (frames per clock tick, index into [180,120,90,70]) = 1 everywhere, from config+0x294.',
  consequence='The runner can offer NORMAL / INFINITE time without any timer poke: G+0x4d = 2 or 3 at scene entry (before FUN_1406274f0 runs at round init). Writing it mid-round only takes effect at the next round init.';

UPSERT finding:steam_training_dummy_controller_config_0x850 SET status='inferred', confidence='high', date='2026-09-06',
  contribution_candidate=true,
  title='The training DUMMY is driven by game code from host-owned config fields: config+0x850 (control mode), 0x82c (local side), 0x858 (guard), 0x85c (tech), 0x860 (air recovery), 0x868 (ground recovery), 0x880/0x884 (meter fill), 0x888/0x88c (dizzy pin)',
  statement='FUN_140634920 (per frame) calls FUN_140634600 iff config+0x828 && config+0x520. FUN_140634bc0: fighter is the dummy iff config+0x828 && config+0x82c != (fighter+0x6b0 & 1) && config+0x850 < 3. FUN_140634600: config+0x850 == 6 -> fighter+0x6b1 = 1 (CPU) on the three fighters of the dummy side, == 7 -> CPU on both sides, other values -> 0 (human/pad); == 3 RECORD the dummy side input word fighter+0x668 into config+0xcb0[config+0xca8++] (cap 0xe10 = 3600 frames), == 4 PLAYBACK config+0xcb0[config+0xcac++] into fighter+0x668 (wrap at config+0xca8); record/playback also need config+0x830 == 2 && config+0x838 == 0 && config+0x520 != 0. Meter: config+0x880 (P1 side) / 0x884 (P2 side) != 0 -> FUN_14063bd30(point fighter, 4) every frame (+4 meter/frame, level rollover at 0x90 in FUN_14063bd70) = infinite super gauge. Dizzy: config+0x888/0x88c != 0 -> fighter+0x291 = 0x50 every frame. Guard (FUN_14063a4a0): config+0x858 == 2 -> auto-guard every guardable hit (FUN_140638f80 -> FUN_140639c80), == 3 -> random, == 1 -> fighter+0x29f = 0x3f after a hit. Tech (FUN_140637f00 case 3): config+0x85c 1 = always, 2 = random, 0 = never. Air recovery (FUN_14074c080): config+0x860 1 = always, 2 = random. Ground recovery (FUN_14074bbd0): config+0x868 1 = always, 2 = random. FUN_140037370 (host scene load) fills 0x850..0x870 and the per-side pairs from the session settings block and clears 0x850 if it was 3/4/6/7. Anchor defaults: 0x850 = 0, 0x858 = 0, 0x85c = 0, 0x860 = 0, 0x868 = 0, 0x878 = 0x87c = 1, 0x880 = 1, 0x884 = 0, 0x888 = 0x88c = 0.',
  caveat='The meaning of config+0x850 values 0/1/2 (the manual/stand family: FUN_140634bc0 treats all three as dummy) is INFERRED as STAND / CROUCH / JUMP from the DC menu order and the Fighting Collection menu; no game-code reader distinguishes 0/1/2 in the functions read so far (UNKNOWN which routine, if any, injects crouch/jump inputs; possibly the dummy just holds the pad). Field NAMES (guard / tech / air recovery / ground recovery / dizzy) are INFERRED from the fighter fields each one drives; the mechanism and the values are CONFIRMED from code.';

UPSERT finding:steam_training_reset_entry_config_0x28 SET status='inferred', confidence='high', date='2026-09-06',
  title='Training position reset is a game function: config+0x28 = FUN_140607da0, driven by config+0x838 (1 = reset, 2 = local player left corner, 3 = right corner)',
  statement='config (game_state object 0x140ac6d40) + 0x28 holds FUN_140607da0 (xref 0x140ac6d68). The host FUN_1400388f0 detects the reset chord on the local pad (FUN_14004b720 / FUN_140056a30 bits 0x80 -> config+0x838 = 2, 0x20 -> 3; config+0x830 bit7 -> 1) and calls FUN_14004f5b0, which in the battle scene (config+8 == 5) calls (**(config+0x28))(). FUN_140607da0: iff config+0x828 != 0: FUN_14060efd0() = round re-init (G+4 = 1, G+0x19 = 1, G+0x90 = 0, FUN_1406274f0 round block + clock, FUN_1406146d0(fighter,0) x6, list resets, battle+0x65 = 99, two battle steps), then if config+0x838 == 2: local x (fighter+0x50) = -1191.0, dummy x = -1245.0, facings +0x174 = 0/1, camera blk+0x6a24/0x6a18/0x69b4/0x695c/0x6914 = -960.0; == 3 mirrored positive. After the call the host sets config+0x830 = 2, 0x838 = 0, 0x83c = 0x1e (30 frame lockout) and restarts recording (0xca8 = 0 if 0x850 == 3) or playback (0xcac = 0 if 0x850 == 4).',
  consequence='SUPERGUN can implement RESET / RESET LEFT / RESET RIGHT by writing config+0x838 and calling the game own FUN_140607da0 between ticks (exactly what the shipped host does), then clearing 0x838. It is deterministic given blk and must be logged as a tape event because config is outside the GGPO save region.';

UPSERT finding:steam_training_attack_data_and_hitbox_export SET status='inferred', confidence='high', date='2026-09-06',
  title='Attack data and hitbox display: the game exports per-hit numbers into config (0x8d4/0x914/0x944/0x964/0x974/0x984/0x994) and draws hitboxes itself when config+0x8c8 == 0',
  statement='FUN_140639200 (iff config+0x828 && damage > 0): config+0x8d4/0x8d8 = last damage, 0x914/0x918 += damage (total; reset when 0x974/0x978 == 0), 0x944/0x948 = combo count, 0x974/0x978 = 1, 0x964/0x968 = 0x1e (per-side HUD countdown decremented by FUN_140634600). FUN_140634600 exports config+0x984+side*4 = fighter+0x291 (dizzy meter) and 0x994+side*4 = fighter+0x292. FUN_140613cd0: iff config+0x520 != 0 && config+0x8c8 == 0 draws the boxes of every object in the lists blk+0x2eee8.. (FUN_1406138e0 per box, FUN_14084b520 cross-hairs). The DC damage display (G+0xae + DAT_142edf2d1 -> FUN_1406281a0 DAMAGE / TOTAL DAMAGE / MAX COMBO text) is still compiled in but has no Steam writer for either flag (static 0x142edf2d1 = 0 in every anchor).',
  consequence='A SUPERGUN overlay attack-data panel can read config+0x8d4.. directly (the host atklog2 object does the same). Hitbox display via config+0x8c8 = 0 emits FUN_14084b520 primitives into the display list: the runner renderer must handle them (UNKNOWN whether it does today).';

UPSERT finding:config_0x520_written_in_flush_body SET status='inferred', confidence='high', date='2026-09-06',
  title='config+0x520 (active-sides mask, 3 in battle) is written inside the host flush body 0x140607e90.. -- the --no-flush runner never updates it, which silently disables the dummy controller and hitbox display',
  statement='0x140608238 (config+0x520 = 0), 0x140608371 (bit0 if blk+0x4400 != 0), 0x140608398 (bit1 if blk+0x4b38 != 0) lie in the body that begins at FUN_140607e90 (the host flush the runner patches to RET with --no-flush; the cache attributes the range 0x140607da0-0x140608bc7 to both FUN_140607da0 and FUN_140607e90). FUN_140634920 gates FUN_140634600 on config+0x520 != 0, FUN_140613cd0 gates hitboxes on it, FUN_1400388f0 gates the reset chord on it, FUN_14063cf60 reads it with config+0x4e4. Anchors: 0 at select, 3 in battle. blk+0x4400 / blk+0x4b38 are set by FUN_140610870 from G+0x18 bits.',
  consequence='With --no-flush the runner must maintain config+0x520 itself: 3 in battle (or mirror the game rule bit0 = blk+0x4400 != 0, bit1 = blk+0x4b38 != 0) before each tick; a battle anchor already carries 3 in its exe image, a select anchor carries 0.';

UPSERT finding:dc_training_menu_has_no_steam_twin SET status='inferred', confidence='high', date='2026-09-06',
  title='The DC in-game training pause menu (bank03 loc_8c0376e0 family, options struct 0x8c212ccc, apply loc_8c037fc0) was NOT recompiled: Steam has no writer for G+0xa7..0xa9/0xaa/0xac/0xae and no reference to the struct; the Fighting Collection host menu replaces it',
  statement='SH4: pause loc_8c0376e0 -> TRAINING MENU (bank13 PauseT_Toremo) -> pages loc_8c03813a (main) / loc_8c0383dc (dummy: T+4 mode, G+0x18 human mask 1<<side or 3, G+0x84 = 0, G+0x85 = G+0x8c = G+0x18) / loc_8c038662 (options T+0xD, T+0x19, T+9, T+0xA range 8, T+0xB range 4, T+0xC range 3) / loc_8c038920 / loc_8c038ada; loc_8c037fc0 applies T into GameGlobal+0xa7/0xa8/0xa9/0xaa/0x83/0x1b/0x89/0xae/0xac. Steam: a whole-image search of every function loading DAT_142edf580 finds READERS of G+0xaa (FUN_14061f030 meter fill), G+0xac (FUN_140635ad0 KO bookkeeping), G+0xae (FUN_140628320 damage display), G+0x83 (FUN_140611a20 write from G+0x4f, FUN_14061eb00, FUN_14060e170), G+0x1b (FUN_140608690 from config+0x290, FUN_14063cd30), G+0x89 (seed 189) but NO writer of G+0xaa/0xac/0xae/0xa7/0xa8/0xa9 anywhere; the strings TRAINING MENU / DUMMY option labels are absent from the exe (list_strings); the recompiled static block maps DC 0x8c212cbc..c0 -> 0x142edf228..22c (FUN_14060b440/FUN_14060b550), 0x8c212d65 -> 0x142edf2d1, 0x8c212d90 -> 0x142edf2fc (delta 0xB6CCC56C) but 0x142edf240/0x142edf244 are FLOATS read by FUN_140618ab0/FUN_1406185e0/FUN_140619370, incompatible with the DC byte fields T+8/T+0xC of 0x8c212ccc, so the T struct was not carried over. The equivalents on Steam are config fields: G+0xaa -> config+0x880/0x884, G+0xae -> config+0x8d4.. export + host atklog2, T+0xA -> config+0x4dc -> G+0x4f -> G+0x83, T+0xB -> config+0x290 -> G+0x1b, T+0xC -> config+0x298 -> G+0x49 -> G+0x89.',
  consequence='There is no in-game training menu for SUPERGUN to open. The game-faithful path is the one the shipped host takes: write the config fields the game reads (they are the game own training interface) and call config+0x28 for reset. Writing G+0xaa/0xae directly would exercise dead DC code paths that the real game never runs: do not.';

UPSERT finding:training_mode_determinism_notes SET status='inferred', confidence='high', date='2026-09-06',
  title='Training mode and the runner: KO freeze cannot fire, the DC join path is blocked by G+0x4a = 1, config options live outside the GGPO save region',
  statement='(1) G+0xa6 = 1 floors health at 1 -> FUN_1406394b0 (KO) is never reached -> the KO-freeze / rematch state machine of the runner is idle in training; the round clock is frozen by G+0x4d = 3 so time-over never fires either. (2) FUN_14062e090 (continue / insert-coin machine) is NOT early-returned in training (G+0x2a = 0, G+0x4c = 0) but its join path (START on the inactive seat -> G+0x18/0x85/0x8c |= side, G+0x8d = 1, G+0xaf = 1, select re-entry) sits under G+0x4a == 0, and caseD_3 sets G+0x4a = 1 for both training and versus; blk+0x3c40 = 1 (FREE PLAY) in all anchors. (3) Every training option is a config field (exe image, host-owned) read by the sim each frame: not in blk, so not in the GGPO save region {blk, 0x33B18} (finding:ggpo_saves_exactly_blk); a tape must log option changes and reset calls as events, like game speed (seed 189). (4) config+0x520 is only written by the flush body (finding:config_0x520_written_in_flush_body). (5) G+0x84 (human mask) at battle init is what FUN_14060e170 case 0 uses to set fighter+0x6b1; in training FUN_140634600 then rewrites fighter+0x6b1 on the dummy side every frame from config+0x850 (6/7 = CPU, else human), so the anchor value of +0x6b1 does not persist once the controller runs.',
  consequence='Rematch logic and the human-mask fix (re_kb 190/192) are unaffected by training, but a training session that flips config+0x850 to 6 will see the dummy-side +0x6b1 bytes go to 1 regardless of G+0x84.';

UPSERT finding:supergun_training_write_set SET status='inferred', confidence='high', date='2026-09-06',
  contribution_candidate=true,
  title='SUPERGUN runner training write set: anchor = select-01 (already training); options = the config fields the shipped host writes; reset = config+0x838 + call config+0x28; nothing in blk is invented',
  statement='ANCHOR: use select-01 (config+0x828 = 1, G+0xa6 = 1, G+0x4d = 3 already in blk/exe image) or any 20260903 battle anchor; do not convert vs-01 (finding:mode_lives_in_host_device_session). If vs-01 must be used, the INFERRED conversion is: host_device session+0xd0330 = 1, +0xd0334 = 0, +0xd0338 = 0; exe image config+0x828 = 1, +0x82c = 0, +0x80c = 0, +0x810 = 0, +0x814 = 0; blk G+0xa6 = 1 (blk+0x3D5E), G+0x4d = 3 (blk+0x3D05), G+0x2a = 0 (blk+0x3CE2); token blk+0x33a00 = 1 -- gated ONLY by a battle-entry blk compare against a 20260903 training anchor of the same roster and stage. PER TICK (before FUN_140118950, while G+2 == 2): config+0x520 = 3 (the flush would compute bit0 = blk+0x4400 != 0, bit1 = blk+0x4b38 != 0). OPTIONS (write any time; read by the sim next frame): config+0x850 dummy control {0 manual/stand, 1, 2 (INFERRED crouch/jump), 3 record, 4 playback, 6 CPU dummy, 7 CPU both}; config+0x858 guard {0 none, 1 after-hit, 2 all, 3 random}; config+0x85c tech {0,1,2 random}; config+0x860 air recovery {0,1,2}; config+0x868 ground recovery {0,1,2}; config+0x878 / +0x87c HP regen P1 / P2 side {0,1}; config+0x880 / +0x884 infinite meter P1 / P2 {0,1}; config+0x888 / +0x88c no-dizzy P1 / P2 {0,1}; config+0x8c8 hitbox display {1 off, 0 on}; config+0x82c local side {0 = P1 human, dummy = P2; 1 = mirrored}. HEALTH/TIME are already the game own training behaviour (G+0xa6 / G+0x4d); NORMAL time = G+0x4d = 2 written before round init. RESET: set config+0x838 = 1 | 2 | 3, call FUN_140607da0 (= *(config+0x28)) once between ticks, then config+0x838 = 0, config+0x830 = 2 (and config+0xca8 = 0 when 0x850 == 3, 0xcac = 0 when 0x850 == 4). RECORD/PLAYBACK also need config+0x830 = 2. Never write G+0xaa/0xac/0xae/0xa7..0xa9 or fighter+0x578 directly.',
  consequence='Every entry is a value the shipped host writes into the same field, so the sim sees a state the real game can produce. Still a CHANGE TO THE SIMULATION until gated: the fixed gate is the battle-entry blk of a runner training match vs a real training capture (the 20260903 anchors) for the same roster / stage, and for each option a live capture with that option set (config+0x8xx read back from the running game plus the resulting blk delta). No time estimates.';

UPSERT finding:sh4_steam_pairs_training_mode SET status='inferred', confidence='high', date='2026-09-06',
  title='SH4<->Steam pairs and global translations for the training subsystem',
  statement='loc_8c046ddc (bank04 Text Displays, Training Mode Check loc_8c046e0c) <-> FUN_140627c50 (strings WINS %2d / NEW HERO, G+0x4c == 2 exit); loc_8c047218 <-> FUN_140628320 tail (state 4 && G+0xae && static bitmask); loc_8c04712c <-> FUN_1406281a0 (DAMAGE / TOTAL DAMAGE / MAX COMBO); loc_8c038028 sets G+0xa6 iff G+0x4c == 2 <-> FUN_140611a20 case 0 sets G+0xa6 iff config+0x828 (the mode test moved from GameGlobal+0x4c to the host config); loc_8c037fc0 (apply T into G) has no twin; bank04 loc_8c046a2a / loc_8c04608c <-> 0x140627310 (seed 189). Globals: GameGlobal+0xa6 0x8c2682e6 <-> blk+0x3D5E; +0x4d 0x8c26828d <-> blk+0x3D05; +0x2a 0x8c26826a <-> blk+0x3CE2; +0xaa/0xac/0xae <-> blk+0x3D62/0x3D64/0x3D66; +0x83 <-> blk+0x3D3B; +0x1b <-> blk+0x3CD3; +0x4a <-> blk+0x3D02; static 0x8c212d65 <-> 0x142edf2d1; 0x8c212cbc..c0 <-> 0x142edf228..22c; battle block 0x8c2895f0 <-> blk+0x324E0 (+0x20 shift after the six pointers). Fingerprints: strings, the 0x90 health cap, the 0xe10 record length, the 30/60/99/99 table, the (1<<side) mask writes -- never instruction bytes.';

