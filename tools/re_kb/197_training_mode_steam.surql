-- 197_training_mode_steam.surql -- TRAINING MODE on the Steam MvC2 recompile: how the game knows it is
-- training (config+0x828 -> G+0xa6 / G+0x4d), the game-owned training implementation (health floor,
-- regen, infinite clock, meter fill, dummy controller, guard/recovery, reset, attack-data export,
-- hitbox display), the host->game config interface the Fighting Collection menu writes, the DC training
-- pause menu that has NO Steam twin, and the SUPERGUN runner write set. 2026-09-06.
-- RE METHOD: SH4 annotations (bank03 loc_8c0376e0 training pause family, bank04 loc_8c046ddc/loc_8c047218,
-- work.asm GameGlobal) matched to Steam by strings (WINS %2d / NEW HERO / DAMAGE / TOTAL DAMAGE / MAX COMBO),
-- constants (0x90 health cap, 0xe10 record length, time table 30/60/99/99) and G-offset structure; globals
-- translated through the block map (G = blk+0x3CB8 == DC GameGlobal 0x8c268240); CONFIRMED vs INFERRED tagged;
-- pairs stored as recompiles edges. Forward slashes only in ref/note; no apostrophes.
USE NS re DB kb;

-- ---------------------------------------------------------------------------------------------------
-- SOURCES
-- ---------------------------------------------------------------------------------------------------
UPSERT source:training_mode_re_20260906 SET kind='disasm', strength='code',
  ref='Ghidra dumpproj / mvc_dump.bin (base 0x140000000): FUN_140611a20 (disassembly 0x140611b70-0x140611d5a), caseD_3 scene-entry label 0x14060be10-0x14060bf30, FUN_140626fe0, FUN_1406274f0, FUN_140626eb0, FUN_14063cbc0, FUN_140639d00, FUN_14063afd0, FUN_14063cf60, FUN_140639200, FUN_14063b920, FUN_140634920, FUN_140634600, FUN_140634bc0, FUN_14063a4a0, FUN_140638f80, FUN_140637f00, FUN_14074c080, FUN_14074bbd0, FUN_14063bd30, FUN_14063bd70, FUN_14061f030, FUN_140628320, FUN_1406281a0, FUN_140613cd0, FUN_140607da0, FUN_14060efd0, FUN_140610870, FUN_140608690, FUN_14060b440, FUN_14063cd30, FUN_140627c50, FUN_14062e090, FUN_140037370, FUN_140037b50, FUN_140038430, FUN_1400388f0, FUN_14004f5b0; disasm cache mvc-live-skins-quarters/d3dcap/replay/re_map/cache/steam_disasm.jsonl (whole-image regex searches for writers of G+0x4c/0x4d/0x2a/0x84/0x18/0xaa/0xac/0xae and for config+0x4d0..0x8ff accesses); SH4 refs/marvelous2 build/bank03.asm:17811-22478 (loc_8c0376e0 training pause, loc_8c03813a main, loc_8c0383dc dummy, loc_8c038662 options, loc_8c038920 exit, loc_8c038ada char select, loc_8c037fc0 apply, loc_8c038028 init, loc_8c0380c8 reset), bank04.asm:16540-16575 (loc_8c046ddc text displays, Training Mode Check loc_8c046e0c), bank04.asm:17120-17185 (loc_8c047218), bank03.asm:32505-32530 (loc_8c03d894 stage 0x0B), bank13.asm:7331 (TRAINING MENU), bank14.asm:13237-13275 (menu tables).',
  note='Scratchpad answer training_mode.md (session 193726f3). All Steam addresses are live addresses (no ASLR). Table values read from select-01/pre/exe_image.bin: DAT_140a6fa70 = [30,60,99,99] (round clock seconds by G+0x4d), DAT_140a6fa74 = [180,120,90,70] (frames per clock tick by G+0x46), DAT_140a97e3c = [16,32,48,64] (damage scale by G+0x1b).';

UPSERT source:training_anchor_readings_20260906 SET kind='capture', strength='reproduction',
  ref='mvc-live-skins-quarters/d3dcap/ttd/runs/{select-01,vs-01,20260903-000941,20260903-000956,20260903-001249,20260903-001536,20260903-001645,20260903-002326,receipt-20260903-stage9-anchor}/pre/{blk.bin,exe_image.bin,host_device.bin}',
  note='Read with a 40-line python script (session 193726f3): G bytes at blk+0x3CB8+k, config dwords at exe_image+0xac6d40+k, session bytes at host_device+0xd0330.., fighter fields at blk+0x3DB8+i*0x738. TRAINING anchors (select-01 and every 20260903-* battle anchor): session+0xd0330=1, config+0x828=1, +0x80c=0, +0x520=3 in battle, G+0xa6=1, G+0x4d=3, G+0x2a=0, blk+0x33a00=1; VERSUS anchors (vs-01, receipt-20260903-stage9-anchor): session+0xd0338=1, config+0x828=0, +0x80c=1, G+0xa6=0, G+0x4d=2, G+0x2a=1, blk+0x33a00=255. All anchors: config+0x878=1 +0x87c=1 +0x880=1 +0x884=0 +0x888=0 +0x88c=0 +0x898=1 +0x89c=1 +0x8c8=1, config+0x290=1 +0x294=1 +0x298=2 +0x4dc=1, G+0x1b=1 G+0x46=1 G+0x49=2 G+0x4f=1 G+0x83=1, G+0x4c=0 G+0xaa=0 G+0xac=0 G+0xae=0, static 0x142edf2d1=0. Training battle 20260903-001536: P2 point fighter hp=63 red=83 fighter+0x472=50; 20260903-001645: hp=70 red=90 +0x472=47 (the regen timer counting down).';

