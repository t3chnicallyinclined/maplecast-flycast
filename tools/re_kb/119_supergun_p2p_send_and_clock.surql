-- 119: SUPERGUN U1 + U2 CLOSED -- (U1) the Steam build sends EVERY P2P packet, GGPO input packets included, with
-- eP2PSendType = 0 = k_EP2PSendUnreliable (the BUFFERING mode), never k_EP2PSendUnreliableNoDelay; and (U2) the
-- millisecond clock GGPO uses for every interval and for _round_trip_time is latched from QueryPerformanceCounter
-- exactly ONCE PER FRAME, so GGPO measures RTT with ~16.67 ms granularity.
-- Source doc: mvc-live-skins-quarters/docs/SUPERGUN-NETCODE.md s8 (appended 2026-09-04). Follows seed 117.
-- Method step 2 (seed with unique constants / argument shapes, propagate along the call graph) + step 4.
-- The U1 seed was the x86-64 argument shape of ISteamNetworking::SendP2PPacket (5th arg = eP2PSendType, an imm32
-- stored to [rsp+0x20] before a vtable slot-0 call) scanned over the mapped image, cross-checked by grepping every
-- decompiled function that references the Steam interface singleton. Both methods return THE SAME FIVE call sites.
-- Apply with tools/re_kb/apply_seed.py after the README export backup
-- (re_kb_data/_exports/re_kb_20260904-151244_pre118.surql -- named pre118 because this seed was APPLIED as 118
-- and renumbered to 119 the same day; the engine lane had already taken 118 for receipt_runner_gate3). Idempotent
-- and order-independent with seed 120, which carries the same two note strings. No apostrophes inside string literals.
-- Do NOT re-run 07_dedup_edges.surql afterwards.
USE NS re DB kb;

UPSERT source:supergun_p2p_send_20260904 SET kind='analysis', strength='code', ref='Ghidra HTTP bridge 127.0.0.1:8080 on mvc_dump.bin; mapped image d3dcap/ttd/runs/receipt-20260903-stage9-anchor/pre/exe_image.bin (68,059,136 B at 0x140000000, gitignored); Steam SDK isteamnetworking.h for the ISteamNetworking005 vtable order and the EP2PSend enum', note='Two independent enumerations of ISteamNetworking SendP2PPacket call sites agree exactly: (a) a machine-code scan for the argument shape C7 44 24 20 imm32 (mov dword [rsp+0x20], eP2PSendType) followed within 56 bytes by a vtable slot-0 call (FF 10 / FF 50 00); (b) decompiling all 72 functions that reference the Steam platform singleton PTR_FUN_140a34d90 and grepping for a slot-0 call on *(singleton+0x40). Five sites, all with the literal 0. No store of *(singleton+0x40) into any variable or global exists in the corpus, so there is no cached interface pointer route that the enumeration could have missed.';

-- ---------------------------------------------------------------- routines
UPSERT steam_routine:FUN_14016ecf0 SET addr='0x14016ecf0', name='FUN_14016ecf0', role='THE ONLY GENERAL-PURPOSE P2P SEND in the binary. Virtual method, slot 15 (+0x78) of the transport class whose vtable is 0x140924698 and whose registry name string is Steam (0x14092468c). Signature (this, uint peerIndex <= 15, const void *pubData, u32 cubData). Body: bail if peerIndex > 15; enter the critical section at this+8 when this+0x30 is set; require the per-peer active flag at this[peer*3 + 0x39]; fetch the Steam platform singleton via (*DAT_1408DB898)(&PTR_FUN_140A34D90); fail with 0x80010038 if *(singleton+0x40) (= ISteamNetworking) is null; call ISteamNetworking vtable +0x30 = GetP2PSessionState(steamID, &P2PSessionState_t) and require m_bConnectionActive; then call ISteamNetworking vtable +0x00 = SendP2PPacket(steamID, pubData, cubData, 0, this[0xff]) -- the fourth argument is the LITERAL 0 = k_EP2PSendUnreliable and the fifth is the virtual channel from this+0x7F8. On failure report 0x80010039 with m_eP2PSessionError.', note='CONFIRMED by decompilation 2026-09-04. Every GGPO packet reaches Steam through this function: the four other SendP2PPacket sites in the whole image transmit only fixed literals (Steam 6 B twice, SteamQosReq and SteamQosAns 12 B), and GGPO input messages are 32-40 B of variable payload, so by exhaustion they take this path.', matched=false;
UPSERT steam_routine:FUN_14016e8c0 SET addr='0x14016e8c0', name='FUN_14016e8c0', role='Transport-class peer open / session poke (vtable 0x140924698 slot 18, +0x90). Sends the 6-byte literal Steam (0x14092468c) via ISteamNetworking SendP2PPacket with eP2PSendType = 0 on the same virtual channel this[0xff]; also calls GetP2PSessionState. This is the packet that provokes the peer P2PSessionRequest_t.', note='CONFIRMED by decompilation 2026-09-04.', matched=false;
UPSERT steam_routine:FUN_14015c0f0 SET addr='0x14015c0f0', name='FUN_14015c0f0', role='Steam QoS probe: sends the 12-byte literals SteamQosReq (0x140922a80) and SteamQosAns (0x140922a90) via ISteamNetworking SendP2PPacket, eP2PSendType = 0. A latency probe independent of GGPO.', note='CONFIRMED by decompilation 2026-09-04. Worth knowing: the title already measures a QoS RTT of its own, separate from GGPO _round_trip_time.', matched=false;
UPSERT steam_routine:FUN_14015c030 SET addr='0x14015c030', name='FUN_14015c030', role='Peer handshake helper: sends the 6-byte literal Steam (0x140922a78) via ISteamNetworking SendP2PPacket, eP2PSendType = 0, channel 0, then allocates a 0x20-byte peer record (vtable PTR_FUN_140922ae0) with field +0x18 = 0xFFFF.', note='CONFIRMED by decompilation 2026-09-04. This is the site that revealed the Steam interface accessor shape.', matched=false;
UPSERT steam_routine:FUN_14003ee40 SET addr='0x14003ee40', name='FUN_14003ee40', role='Steam interface fetch: SteamClient017 then one CreateInterface per subsystem into a flat struct. Confirmed slot offsets: +0x00 ISteamClient, +0x08 ISteamUser (SteamUser019), +0x10 ISteamFriends, +0x18 ISteamUtils, +0x20 ISteamMatchmaking, +0x28 ISteamUserStats, +0x30 ISteamApps, +0x38 ISteamMatchmakingServers, +0x40 ISteamNetworking (SteamNetworking005), +0x48 ISteamRemoteStorage, +0x50 ISteamScreenshots, +0x58 ISteamHTTP, +0x60 ISteamController (SteamController006).', note='CONFIRMED by decompilation 2026-09-04. The struct is reached everywhere as (*DAT_1408DB898)(&PTR_FUN_140A34D90); DAT_1408DB898 is the singleton getter and PTR_FUN_140A34D90 the singleton descriptor whose initialiser is FUN_14003F180.', matched=false;
UPSERT steam_routine:FUN_1400388f0 SET addr='0x1400388f0', name='FUN_1400388f0', role='THE PER-FRAME TIMING UPDATE (vtable 0x1408DD460 slot 7, +0x38 -- its only reference). Calls FUN_14011F310 = QueryPerformanceCounter (IAT 0x1408DB1E0), stores the raw counter at ctx+0x40160, the tick delta at +0x40170, the previous counter at +0x40168, then computes seconds = ticks * *(ctx+0x40188) and writes it to ctx+0x40140 AND ctx+0x40148, and the frame delta time (float) to ctx+0x40150.', note='CONFIRMED by decompilation 2026-09-04. A function that computes deltaTime = now - lastNow and stores lastNow is by construction the per-frame update; ctx+0x40150 is then used as the frame-rate divisor. Consequence: ctx+0x40140 -- the value GGPO reads -- is latched ONCE PER FRAME. Only four functions in the image reference displacement 0x40140: this writer, the initialiser FUN_140038430, the GGPO clock reader FUN_14003ABA0, and FUN_14003A520 (netplay session start).', matched=false;
UPSERT steam_routine:FUN_140038430 SET addr='0x140038430', name='FUN_140038430', role='Timing-context initialiser: zeroes ctx+0x40150 / +0x40178 and stores the initial seconds value into ctx+0x40140 and +0x40148 as one 16-byte write.', note='CONFIRMED by decompilation 2026-09-04. Called from 0x1400372FD.', matched=false;
UPSERT steam_routine:FUN_14011f310 SET addr='0x14011f310', name='FUN_14011f310', role='Thin QueryPerformanceCounter wrapper: calls IAT 0x1408DB1E0 (KERNEL32 QueryPerformanceCounter) with a stack LARGE_INTEGER and returns the count.', note='CONFIRMED by decompilation 2026-09-04; the IAT slot name comes from same-boot export resolution (d3dcap/receipt/runner iat_map.txt).', matched=false;
UPSERT steam_routine:FUN_14034bd40 SET addr='0x14034bd40', name='FUN_14034bd40', role='nNetwork Session constructor (class-registry name string at 0x140964B88, vtable 0x140964BA0, object size 0x2078). Zeroes Session+0x18 (the nNetwork SessionDriver slot); builds the sub-objects; calls FUN_14034A5A0(Session+0x160, Session).', note='CONFIRMED by decompilation + the class-registry layout 2026-09-04. The registry entry is [ctor qword][class name string][vtable], which is how the MT Framework class names were recovered from the image without symbols.', matched=false;

-- ---------------------------------------------------------------- globals
UPSERT global:steam_interface_singleton SET addr='0x140a34d90', steam_off='PTR_FUN_140A34D90, fetched by (*DAT_1408DB898)(&PTR_FUN_140A34D90)', type='singleton descriptor -> Steam interface struct', note='CONFIRMED 2026-09-04. The returned struct is the one FUN_14003EE40 fills; +0x40 is ISteamNetworking (SteamNetworking005). 235 code references to the descriptor across 72 functions; NONE of them stores *(struct+0x40) anywhere, so every P2P send re-fetches the interface and the five-site enumeration is exhaustive.';
UPSERT global:ggpo_ms_clock SET addr='0x142ebc8b8+0x40140', steam_off='*(double*)(DAT_142EBC8B8 + 0x40140) * DAT_1408DD5D0', type='double, frame-latched seconds', note='UPDATED 2026-09-04, was UNKNOWN in seed 117: the source is QueryPerformanceCounter (FUN_14011F310, IAT 0x1408DB1E0) but the value is LATCHED ONCE PER FRAME by FUN_1400388F0, which in the same breath computes the frame delta time at +0x40150. GGPO (FUN_14003ABA0 = Platform GetCurrentTimeMS) therefore sees a clock quantised to ~16.67 ms. The 200/1000/2000 ms poll intervals are unaffected, but _round_trip_time is measured with one-frame granularity, and SetLocalFrameNumber (FUN_14011E740) converts it as rtt*60/1000, so a one-frame RTT quantisation is exactly one frame of _local_frame_advantage error.';
UPSERT global:steam_transport_vtable SET addr='0x140924698', steam_off='0x140924698 (25 slots)', type='vtable', note='CONFIRMED 2026-09-04. The concrete Steam transport class; its class-registry name string is Steam at 0x14092468C. Slot 15 (+0x78) = FUN_14016ECF0 the general P2P send, slot 18 (+0x90) = FUN_14016E8C0 the peer poke, slots 13/14 (+0x68/+0x70) = FUN_14016E6D0 / FUN_14016E640. Distinct from the abstract nNetwork SessionDriver (vtable 0x1409646B0, 104 slots, whose slots 6 and 7 are still the pure-virtual stub FUN_140036560 -- no subclass of SessionDriver overriding them exists in the image).';
UPSERT global:nnetwork_session_array SET addr='0x142ebccb8+0x250', steam_off='*(DAT_142EBCCB8 + 0x250 + 8*k), k = 0..3', type='nNetwork Session*[4]', note='CONFIRMED 2026-09-04 (FUN_14034E720 iterates exactly four entries from +0x250). FUN_1400692E0 -- the shim directly under GGPO Udp SendTo -- uses entry 0 and calls FUN_14034DB60(session, buf, len+4, peer, 0x10, 7), which dispatches vtable +0x38 on *(session+0x18).';

-- ---------------------------------------------------------------- findings
UPSERT finding:supergun_steam_p2p_send_flag_resolved SET status='confirmed', text='U1 CLOSED. The Steam build passes eP2PSendType = 0 = k_EP2PSendUnreliable -- the BUFFERING mode -- on every ISteamNetworking SendP2PPacket call, never k_EP2PSendUnreliableNoDelay (1). The whole binary contains exactly FIVE SendP2PPacket call sites, found independently by an x86-64 argument-shape scan over the mapped image and by decompiling all 72 users of the Steam interface singleton; both methods return the same five, and all five encode the literal 0. Four of them transmit fixed literals (Steam 6 B at 0x140922A78 and 0x14092468C, SteamQosReq and SteamQosAns 12 B); the fifth, FUN_14016ECF0 (transport vtable 0x140924698 slot 15), is the only one taking (pubData, cubData) as parameters. GGPO input messages are 32-40 B of variable payload, so by exhaustion they are sent unreliable-WITH-buffering. No cached copy of the interface pointer exists anywhere in the corpus, so no sixth route can have been missed.';
UPSERT finding:supergun_ggpo_clock_frame_quantised SET status='confirmed', text='U2 CLOSED. GGPO Platform GetCurrentTimeMS in the Steam build (FUN_14003ABA0) reads *(double*)(DAT_142EBC8B8 + 0x40140), which FUN_1400388F0 latches from QueryPerformanceCounter exactly once per frame (the same function computes the frame delta time at +0x40150 from the difference, which is what makes it the per-frame update by construction; it is referenced only from vtable 0x1408DD460 slot 7). Only four functions in the image touch displacement 0x40140. So the underlying source is high resolution but the value GGPO sees is quantised to ~16.67 ms. The 200/1000/2000 ms poll intervals are unaffected. _round_trip_time is not: SetLocalFrameNumber computes rtt*60/1000, so a one-frame RTT quantisation is exactly one frame of _local_frame_advantage error, and because RTT is slowly varying the rounding is a persistent bias that the 40-frame TimeSync window does NOT average away -- against MIN_FRAME_ADVANTAGE = 3 that is a third of the decision threshold. The up-to-150 ms blocking Sleep of GGPO_EVENTCODE_TIMESYNC is therefore driven by a coarsely quantised input.';
UPSERT finding:supergun_steam_send_buffering_cost_unknown SET status='open', text='OPEN, and it is now the only thing between us and a number for the shipped transport overhead: HOW MUCH delay k_EP2PSendUnreliable actually adds inside the Steam client. The flag is CONFIRMED to be the buffering variant, but Valve does not document the buffer window for the legacy ISteamNetworking path and it lives in steamclient, not in the game image, so it cannot be read statically. Settle it empirically with SUPERGUN-NETCODE Gate N4: during a live online match between two of our own machines, read the GGPO endpoint _round_trip_time at endpoint+0x2068 with the agent existing ReadProcessMemory path while sg_probe measures raw UDP RTT between the same two machines at the same time. The difference is the whole Steam transport overhead, of which this buffering is one term. The measurements must be simultaneous and on the same machine pair.';
UPSERT finding:supergun_no_sessiondriver_subclass SET status='confirmed', text='The abstract nNetwork SessionDriver (vtable 0x1409646B0, 104 slots) has NO subclass in the image that overrides its send slots: slots 6 and 7 are still the pure-virtual stub FUN_140036560, and the only code referencing that vtable is the base class own constructor and destructors. The concrete transport is a separate class whose registry name is Steam (vtable 0x140924698). Recorded so that nobody re-walks the SessionDriver interface expecting to find the sender there.';

-- ---------------------------------------------------------------- edges
RELATE steam_routine:FUN_1400692e0->calls->steam_routine:FUN_14034db60 SET id=calls:FUN_1400692e0_FUN_14034db60, note='GGPO payload + 4-byte prefix into the nNetwork Session message layer';
RELATE steam_routine:FUN_1400692e0->reads->global:nnetwork_session_array SET id=reads:FUN_1400692e0_nnetwork_session_array;
RELATE steam_routine:FUN_14016ecf0->reads->global:steam_interface_singleton SET id=reads:FUN_14016ecf0_steam_interface_singleton, note='ISteamNetworking at +0x40; SendP2PPacket with eP2PSendType = 0';
RELATE steam_routine:FUN_14016e8c0->reads->global:steam_interface_singleton SET id=reads:FUN_14016e8c0_steam_interface_singleton;
RELATE steam_routine:FUN_14015c030->reads->global:steam_interface_singleton SET id=reads:FUN_14015c030_steam_interface_singleton;
RELATE steam_routine:FUN_14015c0f0->reads->global:steam_interface_singleton SET id=reads:FUN_14015c0f0_steam_interface_singleton;
RELATE steam_routine:FUN_14003ee40->writes->global:steam_interface_singleton SET id=writes:FUN_14003ee40_steam_interface_singleton;
RELATE steam_routine:FUN_1400388f0->calls->steam_routine:FUN_14011f310 SET id=calls:FUN_1400388f0_FUN_14011f310, note='QueryPerformanceCounter';
RELATE steam_routine:FUN_1400388f0->writes->global:ggpo_ms_clock SET id=writes:FUN_1400388f0_ggpo_ms_clock, note='once per frame';
RELATE steam_routine:FUN_140038430->writes->global:ggpo_ms_clock SET id=writes:FUN_140038430_ggpo_ms_clock, note='initialiser';
RELATE steam_routine:FUN_14003aba0->reads->global:ggpo_ms_clock SET id=reads:FUN_14003aba0_ggpo_ms_clock, note='GGPO Platform GetCurrentTimeMS';
RELATE finding:supergun_steam_p2p_send_flag_resolved->cites->source:supergun_p2p_send_20260904 SET id=cites:supergun_steam_p2p_send_flag_resolved_src;
RELATE finding:supergun_ggpo_clock_frame_quantised->cites->source:supergun_p2p_send_20260904 SET id=cites:supergun_ggpo_clock_frame_quantised_src;
RELATE finding:supergun_no_sessiondriver_subclass->cites->source:supergun_p2p_send_20260904 SET id=cites:supergun_no_sessiondriver_subclass_src;
RELATE finding:supergun_steam_send_buffering_cost_unknown->cites->source:supergun_p2p_send_20260904 SET id=cites:supergun_steam_send_buffering_cost_unknown_src;

-- the two seed-117 open items are now answered
UPDATE finding:supergun_steam_p2p_send_flag_unknown SET status='resolved', note='RESOLVED 2026-09-04 by seed 119 (tools/re_kb/119_supergun_p2p_send_and_clock.surql; applied as 118 and renumbered to 119 the same day because the engine lane had already taken 118 for receipt_runner_gate3): eP2PSendType = 0 = k_EP2PSendUnreliable at all five ISteamNetworking SendP2PPacket call sites in the image. See finding:supergun_steam_p2p_send_flag_resolved. NOTE that this resolves only the FLAG VALUE; the millisecond cost of the buffering it selects is still open, see finding:supergun_steam_send_buffering_cost_unknown.';
UPDATE finding:supergun_ggpo_clock_resolution_unknown SET status='resolved', note='RESOLVED 2026-09-04 by seed 119 (tools/re_kb/119_supergun_p2p_send_and_clock.surql; applied as 118 and renumbered to 119 the same day because the engine lane had already taken 118 for receipt_runner_gate3): the clock is latched from QueryPerformanceCounter once per frame by FUN_1400388F0, so GGPO sees ~16.67 ms granularity. See finding:supergun_ggpo_clock_frame_quantised.';
