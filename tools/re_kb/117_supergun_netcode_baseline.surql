-- 117: SUPERGUN NETCODE BASELINE -- the shipped Steam MvC2 online path decomposed, and the two host measurements that
-- decide the SUPERGUN architecture. Source doc: mvc-live-skins-quarters/docs/SUPERGUN-NETCODE.md.
-- Method step 2 (seed with unique constants) + step 4 (tag and store). The seeds were GGPO upstream constants
-- (2000/500/200/1000 poll intervals, 40/10/3/9 timesync window, 8 max prediction, 0x1C UDP_HEADER_SIZE, 0x1020 msg alloc);
-- every one of them matched a Steam function, and the reference source read to confirm them is the vendored upstream in
-- maplecast-flycast/core/deps/ggpo/lib/ggpo (timesync.h, sync.h, network/udp_msg.h, backends/p2p.cpp).
-- Apply with tools/re_kb/apply_seed.py after the README export backup (re_kb_data/_exports/re_kb_20260904-145333_pre117.surql).
-- Idempotent: UPSERT for nodes, RELATE with explicit edge ids. No apostrophes inside string literals.
-- Do NOT re-run 07_dedup_edges.surql afterwards.
USE NS re DB kb;

UPSERT source:supergun_netcode_baseline_20260904 SET kind='analysis', strength='code', ref='mvc-live-skins-quarters/docs/SUPERGUN-NETCODE.md; measurement harness mvc-live-skins-quarters/d3dcap/net/sg_bench.cpp; tick timings from d3dcap/receipt/runner/rr_runner.exe on run receipt-20260903-stage9-anchor (gitignored); Ghidra HTTP bridge 127.0.0.1:8080 on mvc_dump.bin; reference source maplecast-flycast/core/deps/ggpo/lib/ggpo', note='Every GGPO magic constant read out of the Steam decompilation matches vendored upstream GGPO exactly, so the Steam fork of the GGPO library is upstream behaviour with the transport swapped for Steam P2P. Host measurements on the dev machine 2026-09-04.';
UPSERT source:supergun_netcode_measure_20260904 SET kind='measurement', strength='reproduction', ref='mvc-live-skins-quarters/d3dcap/net/sg_bench.cpp (built by d3dcap/net/build.bat, run modes state|timer|udp) and mvc-live-skins-quarters/d3dcap/receipt/runner/rr_runner.exe --ticks 3000 / --ticks 300 --inputs on run d3dcap/ttd/runs/receipt-20260903-stage9-anchor (gitignored); summary.json ms arrays', note='Host measurements taken 2026-09-04 on the dev machine (Windows 11 26200, HIGH_PRIORITY_CLASS + THREAD_PRIORITY_TIME_CRITICAL, QPC 10 MHz). Numbers are per-machine, not portable; the falsification value is the RATIO between the tick cost and the frame budget, which is three orders of magnitude.';

-- ---------------------------------------------------------------- routines (CONFIRMED: both sides read and agree)
UPSERT steam_routine:FUN_140118dd0 SET addr='0x140118dd0', name='FUN_140118dd0', role='THE PER-FRAME ONLINE DRIVER. Takes the freshly decoded local pad word, calls ggpo_add_local_input (session vtable +0x18) with size 4; if that FAILS the whole frame is SKIPPED (no tick, no advance) -- this is GGPO PREDICTION_THRESHOLD, i.e. the local game freezes while the peer is more than MAX_PREDICTION_FRAMES behind. On success: ggpo_synchronize_input (FUN_140119a60, 16-byte buffer = 4 seats x 4 B) -> FUN_140118950(&DAT_142d10b90, inputs, disconnect_flags) = THE SIM TICK -> ggpo_advance_frame (vtable +0x28). Writes the frame counter to *(PTR_DAT_140acd3a0 + 0x768).', note='CONFIRMED by decompilation 2026-09-04. Caller FUN_14003a520 at 0x14003a9aa. The 16-byte synchronized-input buffer is exactly what d3dcap/receipt/runner passes, so the measured native tick cost IS the shipped per-frame and per-rollback-frame cost.', matched=false;
UPSERT steam_routine:FUN_140118f00 SET addr='0x140118f00', name='FUN_140118f00', role='GGPO advance_frame CALLBACK (the rollback re-simulation body): ggpo_synchronize_input -> FUN_140118950 (sim tick) -> ggpo_advance_frame. Registered in the callback struct built by FUN_140118ae0.', note='CONFIRMED by decompilation 2026-09-04. Identical tick call to the live path, so one rollback frame costs one tick.', matched=false;
UPSERT steam_routine:FUN_140118ae0 SET addr='0x140118ae0', name='FUN_140118ae0', role='Netplay session bring-up: registers the rollback region (FUN_140118290), fills the GGPO callback struct {begin_game FUN_1400365e0, save_game_state FUN_140119380, load_game_state FUN_140118fa0, log_game_state LAB_140118f90, free_buffer FUN_1400365e0, advance_frame FUN_140118f00, on_event FUN_140119010}, ggpo_start_session(session, cbs, name@0x1408ff058, num_players, input_size=4, port), set_disconnect_timeout(3000), set_disconnect_notify_start(1000), then per local player set_frame_delay(handle, param_5).', note='CONFIRMED by decompilation 2026-09-04. param_5 (the frame delay) comes from FUN_14003a520 as *(PTR_DAT_140acd3a0 + 0x27C), itself copied from *(*(u64*)(DAT_140acd3a8 + 0xD04B8) + 0x48) = a per-match/lobby setting. Live value read by replay-kit/ringdiag.py at Sync+0x178 during a ranked match: 4.', matched=false;
UPSERT steam_routine:FUN_140119010 SET addr='0x140119010', name='FUN_140119010', role='GGPO on_event callback. switch(code - 1000) over the verbatim upstream event enum: 0 CONNECTED_TO_PEER, 1 SYNCHRONIZING (progress = count*100/total), 2 SYNCHRONIZED, 3 RUNNING, 4 DISCONNECTED, 5 TIMESYNC, 6 CONNECTION_INTERRUPTED, 7 CONNECTION_RESUMED. Case 5 (TIMESYNC) calls Sleep(frames_ahead * 1000 / 60) on the game thread through IAT slot 0x1408DB248.', note='CONFIRMED by decompilation 2026-09-04; IAT slot 0x1408DB248 resolved to KERNEL32!Sleep by same-boot export resolution (d3dcap/receipt/runner iat_map.txt). This is the upstream GGPO sample handler kept verbatim: a hard blocking stall of up to MAX_FRAME_ADVANTAGE=9 frames = 150 ms, emitted at most once per RECOMMENDATION_INTERVAL=240 frames.', matched=false;
UPSERT steam_routine:FUN_14011cdc0 SET addr='0x14011cdc0', name='FUN_14011cdc0', role='GGPO TimeSync::recommend_frame_wait_duration. Two 40-entry int windows (FRAME_WINDOW_SIZE 40) summed for local and remote frame advantage; if remote_avg <= local_avg or (remote_avg - local_avg)/2 + 0.5 < 3 (MIN_FRAME_ADVANTAGE) return 0; optional require_idle_input scan over 10 (MIN_UNIQUE_FRAMES) GameInput records of stride 0x1C; result clamped to 9 (MAX_FRAME_ADVANTAGE).', note='CONFIRMED 2026-09-04: constants 40 / 10 / 3 / 9 match maplecast-flycast/core/deps/ggpo/lib/ggpo/timesync.h exactly. Caller FUN_14011e220 = UdpProtocol::RecommendFrameDelay.', matched=false;
UPSERT steam_routine:FUN_14011d940 SET addr='0x14011d940', name='FUN_14011d940', role='GGPO UdpProtocol::OnPoll, upstream verbatim. Syncing: retry after 2000 ms (SYNC_RETRY_INTERVAL) or 500 ms while roundtrips_remaining == 5 (SYNC_FIRST_RETRY_INTERVAL / NUM_SYNC_PACKETS). Running: SendPendingOutput if last_input_packet_recv_time + 200 ms (RUNNING_RETRY_INTERVAL); QualityReport every 1000 ms; bandwidth recompute every 1000 ms as (packets_sent * 0x1C + bytes_sent)/seconds (0x1C = UDP_HEADER_SIZE 28); KeepAlive if last_send_time + 200 ms (KEEP_ALIVE_INTERVAL); disconnect_notify and disconnect events off _disconnect_notify_start / _disconnect_timeout. Shutdown state: clear at now > shutdown_timeout (UDP_SHUTDOWN_TIMER 5000, set in FUN_14011d320).', note='CONFIRMED by decompilation 2026-09-04. Field map: +0x2068 _round_trip_time, +0x206C _packets_sent, +0x2070 _bytes_sent, +0x2074 _kbps_sent, +0x2078 _stats_start_time, +0x2098 _current_state, +0x209C last quality-report/sync time, +0x20A0 last stats time, +0x20A4 last input packet recv time, +0x20A8 _local_frame_advantage, +0x20AC _remote_frame_advantage, +0x3D10 _last_send_time, +0x3D14 _last_recv_time, +0x3D18 shutdown timeout.', matched=false;
UPSERT steam_routine:FUN_14011e740 SET addr='0x14011e740', name='FUN_14011e740', role='GGPO UdpProtocol::SetLocalFrameNumber: _local_frame_advantage = (_round_trip_time * 60 / 1000 + _last_received_input.frame) - local_frame.', note='CONFIRMED 2026-09-04: line-for-line upstream. The 60 is the frame rate baked in as 0x3C; this is where RTT enters the timesync loop, so the resolution of the millisecond clock FUN_14003ABA0 bounds the resolution of the whole timesync.', matched=false;
UPSERT steam_routine:FUN_14011e230 SET addr='0x14011e230', name='FUN_14011e230', role='GGPO UdpProtocol::SendInput: when running, feed TimeSync (FUN_14011cd10) with the local/remote frame advantage, push the GameInput into the 0x1C-stride _pending_output ring at +0x20B0, then call SendPendingOutput IMMEDIATELY.', note='CONFIRMED 2026-09-04. Consequence: the shipped build sends one input packet PER FRAME (60 Hz), not on a slower cadence.', matched=false;
UPSERT steam_routine:FUN_14011e3d0 SET addr='0x14011e3d0', name='FUN_14011e3d0', role='GGPO UdpProtocol::SendPendingOutput: allocates a 0x1020-byte UdpMsg (MAX_COMPRESSED_BITS 4096 -> 512 B of bits), then bit-encodes EVERY un-acked input in _pending_output as an XOR delta chain against _last_acked_input (run-length encoded bit positions), stamps _last_received_input.frame * 2 | disconnect_requested, and hands it to SendMsg.', note='CONFIRMED 2026-09-04. Consequence: redundant retransmission of all un-acked inputs in every packet is ALREADY the shipped behaviour -- a SUPERGUN design cannot claim redundancy as a novelty, only a different cadence/path.', matched=false;
UPSERT steam_routine:FUN_14011e310 SET addr='0x14011e310', name='FUN_14011e310', role='GGPO UdpProtocol::SendMsg: bump _packets_sent / _bytes_sent (by PacketSize), stamp _last_send_time, write magic (+0x20) and the incrementing sequence number (+0x3D2A), push {send_time, dst sockaddr, msg ptr} into the 0x20-stride _send_queue ring at +0x58, then PumpSendQueue.', note='CONFIRMED 2026-09-04.', matched=false;
UPSERT steam_routine:FUN_14011e000 SET addr='0x14011e000', name='FUN_14011e000', role='GGPO UdpProtocol::PumpSendQueue, upstream verbatim including the debug artificial-latency (_send_latency at +0x2C) and out-of-order-packet (_oop_percent at +0x30) paths. Emits Udp::SendTo with a per-type length: header 5 + {input 0x1B + ceil(bits/8), inputack 5, sync/quality 4, keepalive 0}.', note='CONFIRMED 2026-09-04. _send_latency and _oop_percent are read from the object; if the shipped build ever sets them non-zero it would add deliberate latency -- their live values are UNKNOWN and worth one read.', matched=false;
UPSERT steam_routine:FUN_14011df90 SET addr='0x14011df90', name='FUN_14011df90', role='GGPO UdpMsg::PacketSize. Input (type 3) = 0x20 + ceil(num_bits/8); InputAck (4) = 10; SyncRequest/SyncReply/QualityReport/QualityReply (1,2,5,7) = 9; KeepAlive (6) and default = 5.', note='CONFIRMED 2026-09-04. So a steady-state MvC2 input packet is roughly 32-40 B of UDP payload at 60 Hz per direction, i.e. about 4 KB/s per direction once the 28-byte IP+UDP header is added, before Steam P2P framing.', matched=false;
UPSERT steam_routine:FUN_14011d100 SET addr='0x14011d100', name='FUN_14011d100', role='GGPO Udp::SendTo -- REPLACED in the Steam build. It ignores the flags and address length and calls FUN_1400692E0(DAT_140BD3BB8, *(u16*)(sockaddr+2) = the sin_port field carrying the peer slot, buffer, len). The sockaddrs are built from the literal "192.168.0.%d" at 0x1408DD5C0, so the IP is decorative and the peer identity travels in the port field.', note='CONFIRMED 2026-09-04. This is the seam where a SUPERGUN transport would be substituted in a hypothetical patched client, and it is the reason the GGPO layer never sees a real socket.', matched=false;
UPSERT steam_routine:FUN_1400692e0 SET addr='0x1400692e0', name='FUN_1400692e0', role='Game transport shim under GGPO: prefixes a 4-byte header {u8 type = 7 at +0x2564, u16 len at +0x2566} to the GGPO payload copied at +0x2568, maps peer -1 to 0xC0 and -2 to 0x80 (broadcast/host pseudo-targets), drops the send if the target slot is inactive, then FUN_14034DB60(*(DAT_142EBCCB8+0x250), buf, len+4, target, 0x10, 7).', note='CONFIRMED by decompilation 2026-09-04. The 4-byte prefix is pure overhead on every GGPO packet. The eventual ISteamNetworking::SendP2PPacket call and its EP2PSend flag are BELOW this, behind the vtable +0x38 of *(netmgr+0x18) -- NOT yet located.', matched=false;

-- ---------------------------------------------------------------- globals
UPSERT global:ggpo_frame_delay_setting SET addr='0x140acd3a0+0x27C', steam_off='*(PTR_DAT_140acd3a0 + 0x27C)', type='i32 frames', note='THE SHIPPED INPUT DELAY. Copied at netplay session start (FUN_14003a520) from *(*(u64*)(DAT_140acd3a8 + 0xD04B8) + 0x48) and passed to ggpo_set_frame_delay. Live value observed 4 (Sync+0x178) during a ranked match = 66.7 ms of unconditional added input latency. CONFIRMED path by decompilation 2026-09-04; whether the value is user-selectable, region-derived or fixed per mode is UNKNOWN.';
UPSERT global:ggpo_sync_scalars SET addr='*(0x142E10B98)+0x9F0', steam_off='Sync +0x174/+0x178/+0x180/+0x184/+0x188/+0x18C/+0x190', type='GGPO Sync object', note='CONFIRMED live 2026-08-27 (replay-kit/ringdiag.py) and re-derived from the Steam decompile 2026-09-04: +0x174 _num_players 2, +0x178 _frame_delay 4, +0x180 _rollingback, +0x184 _last_confirmed_frame, +0x188 _framecount (== blk+0x3CC8, no epoch offset), +0x18C _max_prediction_frames 8, +0x190 _input_queues (stride 0xE44, _inputs[128] at +40, GameInput stride 28).';
UPSERT global:ggpo_ms_clock SET addr='0x142ebc8b8+0x40140', steam_off='*(double*)(DAT_142EBC8B8 + 0x40140) * DAT_1408DD5D0', type='double seconds/ms', note='GGPO Platform::GetCurrentTimeMS in the Steam build (FUN_14003ABA0) reads an ENGINE timer, not timeGetTime or QPC directly. Every GGPO interval (200/1000/2000 ms), the RTT and hence _local_frame_advantage are quantised by this clock. Its update cadence is UNKNOWN: if it advances once per frame, GGPO measures RTT with 16.7 ms granularity and the whole timesync loop is coarse.';
UPSERT global:steam_networking_interface SET addr='0x1408de368', steam_off='string "SteamNetworking005"', type='Steam interface version string', note='CONFIRMED 2026-09-04: SteamNetworking005 (legacy ISteamNetworking P2P) is the ONLY Steam networking interface string in the image -- no SteamNetworkingSockets, no SteamNetworkingMessages. Fetched in FUN_14003EE40 into slot [8] of the Steam interface struct. Consequence: the shipped online path rides Valve legacy P2P (NAT punch with SDR relay fallback), whose send-buffering behaviour depends on the EP2PSend flag that is not yet located.';
UPSERT global:xinput_dll SET addr='0x140980b20', steam_off='string "XINPUT1_3.dll"', type='import module name', note='CONFIRMED 2026-09-04: the game reads pads through legacy XInput 1.3 (plus SteamController006 for Steam Input). The pad is decoded by FUN_14003AD50 immediately before ggpo_add_local_input inside FUN_14003A520, so there is no extra input queue between the poll and the sim -- the controllable latency is WHEN in the frame that poll happens, which is UNKNOWN.';

-- ---------------------------------------------------------------- findings
UPSERT finding:supergun_shipped_ggpo_is_upstream SET status='confirmed', text='The Steam MvC2 online path is upstream GGPO with only the transport replaced. Every upstream magic constant was found in a Steam function and cross-checked against the vendored source in maplecast-flycast/core/deps/ggpo/lib/ggpo: MAX_PREDICTION_FRAMES 8, FRAME_WINDOW_SIZE 40, MIN_UNIQUE_FRAMES 10, MIN_FRAME_ADVANTAGE 3, MAX_FRAME_ADVANTAGE 9, SYNC_RETRY_INTERVAL 2000, SYNC_FIRST_RETRY_INTERVAL 500, NUM_SYNC_PACKETS 5, RUNNING_RETRY_INTERVAL 200, KEEP_ALIVE_INTERVAL 200, QUALITY_REPORT_INTERVAL 1000, NETWORK_STATS_INTERVAL 1000, UDP_SHUTDOWN_TIMER 5000, UDP_HEADER_SIZE 28, MAX_COMPRESSED_BITS 4096, RECOMMENDATION_INTERVAL 240, the event enum 1000..1007 and the TIMESYNC Sleep handler from the upstream sample. Nothing was retuned for a 60 Hz fighting game.';
UPSERT finding:supergun_shipped_latency_terms SET status='confirmed', text='The shipped online latency budget decomposes into four terms owned by GGPO: (1) frame delay, live 4 frames = 66.7 ms, unconditional; (2) speculation depth capped at MAX_PREDICTION_FRAMES = 8; (3) a HARD LOCAL FREEZE whenever ggpo_add_local_input returns PREDICTION_THRESHOLD, i.e. whenever the peer is more than 8 frames behind -- FUN_140118dd0 skips the entire frame, no tick and no advance; (4) a blocking Sleep(frames_ahead * 1000/60) of up to 9 frames = 150 ms on every TIMESYNC event, at most one per 240 frames. Terms 3 and 4 are what a player experiences as online MvC2 stutter, and both are policy, not physics.';
UPSERT finding:supergun_tick_cost_measured SET status='confirmed', text='MEASURED 2026-09-04 on the dev machine with d3dcap/receipt/runner/rr_runner.exe on the stage-9 anchor images: the real sim tick FUN_140118950 costs p50 0.034 ms / p99 0.076 ms / max 0.280 ms over 3000 idle ticks, and p50 0.039 ms / p99 0.158 ms / max 0.169 ms over 300 real-input ticks; 3000 ticks total 113 ms of tick time. Because FUN_140118f00 (the GGPO advance_frame callback) calls the same function with the same 16-byte input buffer, this IS the shipped cost of one rollback re-simulation frame. 26.5 simulated frames per millisecond.';
UPSERT finding:supergun_rollback_state_cost_measured SET status='confirmed', text='MEASURED 2026-09-04 (d3dcap/net/sg_bench.cpp state): a full save or restore of the 0x33B18 = 211,736 B registered rollback region costs p50 0.004 ms (min 0.0031, p99 0.017) for ring depths 1-60, rising to p50 0.021 ms at ring depth 120 where the 25 MB working set leaves cache. An FNV-1a hash of the whole region for desync detection costs p50 0.025 ms. Consequence: a 60-deep save ring costs 0.25 ms per second of gameplay and one restore is 0.004 ms.';
UPSERT finding:supergun_speculation_budget SET status='inferred', text='DERIVED from the two measurements above (tick 0.0377 ms mean, save/restore 0.0045 ms mean, ring depth <= 60): one rollback of N frames costs about 1 restore + N ticks + N saves = 0.004 + N * 0.042 ms. 8 frames = 0.34 ms, 60 frames = 2.5 ms, 240 frames = 10.1 ms. Against a 16.67 ms frame budget this says GGPO MAX_PREDICTION_FRAMES = 8 is roughly 30x more conservative than this engine needs. INFERRED, not confirmed: the tick cost and the memcpy cost were measured SEPARATELY, so cache interference between an interleaved save-tick-save loop is not in the number. Gate N1 in SUPERGUN-NETCODE.md settles it by measuring the interleaved loop directly.';
UPSERT finding:supergun_host_pacing_measured SET status='confirmed', text='MEASURED 2026-09-04 (d3dcap/net/sg_bench.cpp timer, Windows 11 26200, HIGH_PRIORITY + TIME_CRITICAL): Sleep(1) actually takes p50 1.50 ms / max 2.74 ms with or without timeBeginPeriod(1); a CREATE_WAITABLE_TIMER_HIGH_RESOLUTION overshoots its deadline by p50 0.58 ms / max 1.08 ms; a busy spin to a QPC deadline overshoots by p50 0.00003 ms / p99 0.008 ms / max 0.14 ms. QPC granularity is 100 ns. Consequence: sampling input as late as possible before the tick requires a SPIN, not a sleep; the difference is about 0.6 ms of latency, i.e. 3.5 percent of a frame, bought with a burned core.';
UPSERT finding:supergun_udp_socket_floor_measured SET status='confirmed', text='MEASURED 2026-09-04 (d3dcap/net/sg_bench.cpp udp, loopback, zero wire time): UDP ping-pong RTT p50 0.057 ms / p99 0.10 ms and sendto p50 0.022 ms, and these are FLAT from 16 B to 1200 B of payload. Consequence: packet SIZE is free in host time up to the MTU, so redundant input history costs bandwidth only, and the whole OS socket path is about 3 percent of one frame.';
UPSERT finding:supergun_steam_p2p_send_flag_unknown SET status='open', text='UNKNOWN and load-bearing: which EP2PSend value the shipped path passes to ISteamNetworking::SendP2PPacket. k_EP2PSendUnreliable buffers, k_EP2PSendUnreliableNoDelay does not; the difference is a per-packet Nagle-scale delay on every input. The call is below FUN_1400692E0 -> FUN_14034DB60 -> vtable +0x38 of *(netmgr+0x18); that implementation has not been located. Settle it either in Ghidra by resolving that vtable, or live by hooking SendP2PPacket in the running game and logging the flag.';
UPSERT finding:supergun_ggpo_clock_resolution_unknown SET status='open', text='UNKNOWN: the resolution and update cadence of the engine millisecond clock FUN_14003ABA0 (*(double*)(DAT_142EBC8B8+0x40140) * scale) that GGPO uses for every interval and for _round_trip_time. If it is frame-quantised then GGPO measures RTT at 16.7 ms granularity and the timesync loop cannot resolve better than one frame. Settle it by sampling that double at 1 kHz from an external reader during a match and looking at the step size.';

-- ---------------------------------------------------------------- edges
RELATE steam_routine:FUN_140118dd0->calls->steam_routine:FUN_140118950 SET id=calls:FUN_140118dd0_FUN_140118950, note='the sim tick, per online frame';
RELATE steam_routine:FUN_140118f00->calls->steam_routine:FUN_140118950 SET id=calls:FUN_140118f00_FUN_140118950, note='the sim tick, per rollback re-simulation frame';
