-- 170: GGPO SAVE/LOAD STATE -- what the shipped Steam MvC2 rollback actually copies, read out of mvc_dump.bin
-- (live process image, base 0x140000000, file offset == RVA) with capstone. Method step 2 (seed with unique constants:
-- 0x100004 staging size, 0x33B18 region length, 0x41C64E6D dead LCG) + step 4 (tag and store).
-- Reference corroboration: vendored upstream GGPO in maplecast-flycast/core/deps/ggpo/lib/ggpo (GGPOSessionCallbacks
-- field order) and seed 117_supergun_netcode_baseline.surql. Backup: re_kb_data/_exports/re_kb_20260905-135936_pre170.surql.
-- Idempotent: UPSERT for nodes, RELATE with explicit edge ids. No apostrophes inside string literals.
USE NS re DB kb;

UPSERT source:ggpo_save_region_20260905 SET kind='ghidra', strength='code', ref='C:/Users/trist/ghidra_projects/mvc_dump.bin disassembled with capstone (scripts in %TEMP%/sg_dis/f.py,g.py); functions 0x140118270..0x1401193dd; live global values read at their file offsets', note='Ghidra MCP was down; every claim was read directly out of the raw live-process dump. The dump was taken with MvC2 loaded and OFFLINE (DAT_142e10b98 = 0), so the region table 0x142d10950 is still 0 -- the STATIC control flow is confirmed, the LIVE table contents are not yet observed.';

-- ---------------------------------------------------------------- routines
UPSERT steam_routine:FUN_140119380 SET addr='0x140119380', name='FUN_140119380', role='GGPO save_game_state CALLBACK. bool f(u8** buf, int* len, int* checksum, int frame). Sets *len = 0x100004 UNCONDITIONALLY, allocates 0x100004 B via FUN_14003ab80 (virtual allocator *(0x142e12cf8), vtable +0x40, align 0x10), returns false if null, then FUN_1401188c0(0x142d10b90) = GATHER the registered regions into the staging buffer, then memcpy(*buf, 0x142d10b90, 0x100004) at 0x1401193cc. It does NOT copy blk directly -- blk reaches the buffer only because blk is the single registered region.', note='CONFIRMED by disassembly 2026-09-05. Registered as callbacks+0x08 at 0x140118b53.', matched=false;
UPSERT steam_routine:FUN_140118fa0 SET addr='0x140118fa0', name='FUN_140118fa0', role='GGPO load_game_state CALLBACK. f(u8* buf, int len). FUN_140118270 (log, sprintf of the staging frame counter) -> memcpy(0x142d10b90, buf, len) at 0x140118fce -> FUN_140118310(0x142d10b90) = SCATTER the regions back to their live addresses -> FUN_140118270 again -> inc *(*(0x140acd3a0) + 0x76c) = the rollback counter.', note='CONFIRMED by disassembly 2026-09-05. Registered as callbacks+0x10 at 0x140118b3d.', matched=false;
UPSERT steam_routine:FUN_140118290 SET addr='0x140118290', name='FUN_140118290', role='ROLLBACK REGION REGISTRATION. Zeroes the staging frame word, memsets staging+4 for 0x100000 B, clears count 0x142d10950 and total 0x142d10954, then branches on the game selector *(*(0x140acd3a0) + 0x48): if > 2 (MvC2) it registers EXACTLY ONE region {src = *(GS+0x1B0) = blk, len = *(GS+0x1B8) = 0x33B18}, count = 1, total = 0x33B18, and returns; if <= 2 it tail-jumps to 0x1401183a0 which registers about 25 emulator regions.', note='CONFIRMED by disassembly 2026-09-05. Two callers: FUN_140118ae0 at 0x140118afa and FUN_140118d00 at 0x140118d18.', matched=false;
UPSERT steam_routine:FUN_1401188c0 SET addr='0x1401188c0', name='FUN_1401188c0', role='GATHER. for i in 0..*(0x142d10950): memcpy(staging + 4 + off, srcs[i], lens[i]); off += lens[i]. srcs = 0x142d107d0 (u64 array, stride 8), lens = 0x142d108d0 (u32 array, stride 4).', note='CONFIRMED by disassembly 2026-09-05. Single caller: FUN_140119380 at 0x1401193ba.', matched=false;
UPSERT steam_routine:FUN_140118310 SET addr='0x140118310', name='FUN_140118310', role='SCATTER. Exact inverse of FUN_1401188c0: memcpy(srcs[i], staging + 4 + off, lens[i]).', note='CONFIRMED by disassembly 2026-09-05. Single caller: FUN_140118fa0 at 0x140118fda.', matched=false;
UPSERT steam_routine:FUN_1400365e0 SET addr='0x1400365e0', name='FUN_1400365e0', role='STUB: mov al,1; ret. Registered as BOTH begin_game (callbacks+0x00) and free_buffer (callbacks+0x18).', note='CONFIRMED by disassembly 2026-09-05. free_buffer being a no-op means the 0x100004 B save allocation is never handed back through the GGPO path; whether the allocator behind FUN_14003ab80 recycles is UNKNOWN.', matched=false;
UPSERT steam_routine:FUN_140118d00 SET addr='0x140118d00', name='FUN_140118d00', role='SECOND GGPO session bring-up (alongside FUN_140118ae0). Also calls FUN_140118290 (0x140118d18) and builds a callback struct with FUN_1400365e0. Same registered region set.', note='INFERRED role (spectator or synctest session) 2026-09-05; the region registration call is CONFIRMED.', matched=false;

-- ---------------------------------------------------------------- globals
UPSERT global:ggpo_staging_142d10b90 SET addr='0x142d10b90', type='struct u32 frame then u8 payload 0x100000', note='The GGPO save/load STAGING BUFFER, 0x100004 B. Word 0 is the counter incremented by FUN_140118950 (the sim tick, first instruction inc dword ptr [rcx]). Referenced from .text only inside 0x140118a80..0x1401193c5 (the GGPO callback cluster) -- 13 rip-relative references, all in that range. NOT the game_state page and NOT blk.', evidence='mvc_dump.bin whole-text rip-relative scan 2026-09-05';
UPSERT global:ggpo_region_table SET addr='0x142d107d0 srcs / 0x142d108d0 lens / 0x142d10950 count / 0x142d10954 total', type='u64 array / u32 array / u32 / u32', note='The rollback region table. Whole-text scan 2026-09-05: every one of the 45 rip-relative references to 0x142d10950..0x142d10958 and all 56 base-relative table writes (imm 0x02d107d0 / 0x02d108d0) lie inside 0x1401182be..0x1401188ca, i.e. inside FUN_140118290 plus its alt path 0x1401183a0 plus the gather/scatter. There is NO other writer, so the registered region set is fully enumerated.', evidence='mvc_dump.bin scan 2026-09-05';
UPSERT global:game_state_page_140ac6d40 SET addr='0x140ac6d40', steam_off='deref of 0x140acd3a0', type='exe static page', note='THE game_state page (call it GS, distinct from G = blk+0x3CB8). Fields read in this analysis: GS+0x48 = game selector (live value 0xB with MvC2 loaded; greater than 2 selects the single-blk-region path), GS+0xd0/+0xd8 = per-emulated-game contexts (both 0 under MvC2), GS+0x1B0 = blk pointer (live 0x15AE1000, equals the value at 0x142edf560), GS+0x1B8 = 0x33B18, GS+0x218/+0x228 = the input words, GS+0x768 = frame counter, GS+0x76C = rollback counter, GS+0x27C = GGPO frame delay. GS IS NOT IN THE ROLLBACK REGION.', evidence='mvc_dump.bin live values 2026-09-05';

-- ---------------------------------------------------------------- findings
UPSERT finding:ggpo_saves_exactly_blk SET status='confirmed', confidence='high', date='2026-09-05', contribution_candidate=true, note='WHAT THE SHIPPED ROLLBACK COPIES. For MvC2 the GGPO save/load set is EXACTLY ONE region: src = the pointer at 0x140ac6d40 + 0x1B0 = blk = 0x15AE1000 live, len = the value at 0x140ac6d40 + 0x1B8 = 0x33B18 = 211,736 B. Registered at 0x1401182eb..0x140118302 in FUN_140118290, taken because the game selector at 0x140ac6d40 + 0x48 reads 0xB which is greater than 2 in the live dump. There are NO extra regions, NO pointers and NO allocator state on the MvC2 path. The other branch (0x1401183a0, about 25 regions from getter pairs such as 0x140f383d0 len 0x4A0, 0x140f38870 len 0x9A40, 0x142d08f80 len 0x7848, 0x141BA09C0 len 0x2A10, plus ctx+0x500000 len 0x830 and ctx+0x800100 len 0x80) belongs to the Collection emulated titles, not MvC2. Mechanism nuance: the callback copies 0x100004 B from the STAGING buffer 0x142d10b90, not from blk -- the gather FUN_1401188c0 puts blk at staging+4 first, so bytes 4 through 4+0x33B18 of every GGPO save ARE blk and the remaining about 837 KB is the zeroed memset from registration. Residual: the dump is offline, so the LIVE region table has not been observed; the falsification test is one read of 0x142d10950 / 0x142d107d0 / 0x142d108d0 during a real online match, expecting count 1, src equal to the pointer at 0x142edf560, len 0x33B18.';
UPSERT finding:ggpo_rng_caveat_retired SET status='confirmed', confidence='high', date='2026-09-05', contribution_candidate=true, note='THE RNG COUNTER-EXAMPLE IS FALSIFIED, independently re-verified against mvc_dump.bin 2026-09-05. The sim RNG state is the 2 bytes blk+0x32BD4 (hi) and blk+0x32BD5 (lo), reached as the pointer at 0x142edf560 plus 0x32BD4. Read directly in FUN_14060fa40 at 0x14060fa47 and 0x14060fa4f, in the 8-bit draw FUN_14060f990 at 0x14060f997 and 0x14060f99f, and written by the seeder FUN_14060f9e0 at 0x14060f9e7 (value 1) and 0x14060f9f5 (value 0xC3). 0x32BD5 is less than 0x33B18, so the RNG state is INSIDE the single registered region and is rolled back and snapshotted with blk. The DC-style LCG (A 0x41C64E6D, C 0x3039, shift 0x10, mask 0x7FFF, seed 1) at object 0x140a5c800 is DEAD: a whole-image scan finds 0x41C64E6D at exactly two places, the immediate inside its initialiser FUN_1400298c0 at 0x1400298e8 and the object itself at 0x140a5c804, and a whole-text rip-relative scan for references into 0x140a5c7d8..0x140a5c818 returns only the six displacements inside FUN_1400298c0. Retire the re_kb caveat that named RNG as the rollback-vs-replay counter-example.';
UPSERT finding:rollback_vs_replay_sufficiency SET status='confirmed', confidence='high', date='2026-09-05', contribution_candidate=true, note='ROLLBACK-SUFFICIENT IS NOT REPLAY-SUFFICIENT, restated with the correct residual now that RNG is closed. blk 0..0x33B18 is by construction rollback-sufficient (it is the whole registered set). It is NOT cold-start replay-sufficient, because the sim tick FUN_140118950 also READS memory the rollback deliberately never saves, since that memory is constant for the whole match: (a) the six PL slot images at 0x0C420000 + pos*0x150000 (animation-script records read by FUN_140611f70) and the rest of the loaded DC-RAM banks; (b) the game_state page 0x140ac6d40, of which only GS+0x218..0x227 (the inputs) and GS+0x520 (a render gate) are read before written; (c) the NaomiLib ctx matrix state ctx+0x1F80A4 onwards, on which the frame is a fixed point and whose only effect on a wrong entry state is 49 render-output bytes (walker screen x/y). So the correct statement is: blk snapshot plus per-frame inputs plus the match-constant loaded DC-RAM (derivable from the roster by the AFS 209+cid rule, finding:determinism_pl_image_rule) plus the GS input words equals deterministic reproduction. The loader-built PL tail beyond the AFS entry is the one piece whose cross-boot reproducibility is still UNKNOWN.';
UPSERT finding:ggpo_save_cost_correction SET status='confirmed', confidence='medium', date='2026-09-05', note='CORRECTION to finding:supergun_rollback_state_cost_measured (seed 117): the bench measured a 0x33B18 = 211,736 B copy, but the SHIPPED save callback does a 0x100004 = 1,048,580 B allocation plus a 1,048,580 B memcpy every saved frame (0x14011938d sets the length to 0x100004 unconditionally; 0x140119393 allocates that; 0x1401193cc copies that), of which only 211,736 B is live state. The shipped per-save cost is therefore about 5x the benchmarked number, and free_buffer is the stub FUN_1400365e0 (mov al,1; ret) so nothing is returned through the GGPO free path. OPEN: whether the allocator behind FUN_14003ab80 recycles; test = watch the alloc counter 0x140ab67cc and process private bytes across a long online match.';

-- ---------------------------------------------------------------- edges
RELATE steam_routine:FUN_140119380->calls->steam_routine:FUN_1401188c0 SET id=calls:FUN_140119380_FUN_1401188c0, note='gather before the save memcpy';
RELATE steam_routine:FUN_140118fa0->calls->steam_routine:FUN_140118310 SET id=calls:FUN_140118fa0_FUN_140118310, note='scatter after the load memcpy';
RELATE steam_routine:FUN_140118d00->calls->steam_routine:FUN_140118290 SET id=calls:FUN_140118d00_FUN_140118290, note='second session bring-up registers the same region set';
RELATE steam_routine:FUN_140118290->reads->global:game_state_page_140ac6d40 SET id=reads:FUN_140118290_game_state_page, note='GS+0x48 selector, GS+0x1B0 blk ptr, GS+0x1B8 length';
RELATE steam_routine:FUN_140118290->writes->global:ggpo_region_table SET id=writes:FUN_140118290_ggpo_region_table;
RELATE steam_routine:FUN_1401188c0->reads->global:ggpo_region_table SET id=reads:FUN_1401188c0_ggpo_region_table;
RELATE steam_routine:FUN_140118310->reads->global:ggpo_region_table SET id=reads:FUN_140118310_ggpo_region_table;
RELATE finding:ggpo_saves_exactly_blk->about:ggpo_about_1->steam_routine:FUN_140118290;
RELATE finding:ggpo_saves_exactly_blk->about:ggpo_about_2->steam_routine:FUN_140119380;
RELATE finding:ggpo_saves_exactly_blk->about:ggpo_about_3->steam_routine:FUN_140118fa0;
RELATE finding:ggpo_rng_caveat_retired->about:ggpo_about_4->steam_routine:FUN_14060fa40;
RELATE finding:ggpo_rng_caveat_retired->about:ggpo_about_5->steam_routine:FUN_14060f9e0;
RELATE finding:ggpo_save_cost_correction->about:ggpo_about_6->steam_routine:FUN_140119380;
RELATE finding:ggpo_saves_exactly_blk->cites->source:ggpo_save_region_20260905 SET id=cites:ggpo_saves_exactly_blk_src;
RELATE finding:ggpo_rng_caveat_retired->cites->source:ggpo_save_region_20260905 SET id=cites:ggpo_rng_caveat_retired_src;
RELATE finding:rollback_vs_replay_sufficiency->cites->source:ggpo_save_region_20260905 SET id=cites:rollback_vs_replay_sufficiency_src;
RELATE finding:ggpo_save_cost_correction->cites->source:ggpo_save_region_20260905 SET id=cites:ggpo_save_cost_correction_src;
