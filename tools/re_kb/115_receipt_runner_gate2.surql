-- 115: RECEIPT RUNNER GATE 2 -- the live agent's tape harvest, refactored into a library (RetroReceipts-agent agent/src/harvest.rs,
-- MemSource seam under read_at), run over the NATIVE RUNNER's per-tick memory (rr_runner.exe --harvest-dump + rr-tape.exe), yields a
-- v5 tape that equals the live agent's tape of the same match (stage 9 offline, agent 0.3.48, clocks 1716..2016 = 301 frames)
-- on every column of every section after the documented live-only classes: rows exact except 6 class-P values, nodes exact
-- except 8 class-P values in two mid-walk frames, anodes matrix/colour/flags/alpha/model 15911/15911 exact, palrows 14448/14448
-- exact, aobjs equal except 3 objects whose vertices the frame regenerates (class A, the 0.3.44 object cache). Render: sprite
-- draws 2114/2114 exact; the browser scene-RT sha is byte-equal 60/60 once the 3 class-A byte strings are swapped.
-- Source doc: mvc-live-skins-quarters/docs/RECEIPT-RUNNER-GATE2.md. Apply with tools/re_kb/apply_seed.py (per statement) after
-- the README export backup. Idempotent: UPSERT for nodes, RELATE with explicit edge ids. No apostrophes inside string literals.
-- Do NOT re-run 07_dedup_edges.surql afterwards.
USE NS re DB kb;

UPSERT source:receipt_runner_gate2_20260903 SET kind='measurement', strength='reproduction', ref='mvc-live-skins-quarters/d3dcap/receipt/runner/{rr_runner.cpp --harvest-dump, runner_tape_gate.py}; RetroReceipts-agent/agent/src/{harvest.rs,runner.rs,bin/rr-tape.rs}; rr-render/tools/gate_tapes.mjs; live tape d3dcap/replay/packs/local_stage9/tape.json.gz; run d3dcap/ttd/runs/receipt-20260903-stage9-anchor; outputs %TEMP%/rrcap_runner/gate2_300 (all gitignored)', note='The agent harvest (read_gs_row, harvest_objs, harvest_anodes, palrows, interning, build_gamestate_record) moved verbatim into a library behind a MemSource trait; the runner view composes per-tick blk + game_state page + exe page 0x142edf300 + the DC-RAM pages that changed since the previous tick (4 KiB granularity, memcmp vs a shadow) at the live addresses (Delta = 0). Master gate: 301 frames, 0 unexplained differences; attributed P 14, A 620, F 1.';

-- globals: the DC-RAM write set of the frame on a REAL stage (stage 9), measured per tick by the runner
UPSERT global:dcram_writeset_stage9 SET addr='DC 0x0CE60000 / 0x0D853000 / 0x0D855000 / effects POL', steam_off='dcram+0xE60000 / +0x1853000 / +0x1855000', type='per-frame regenerated pages', note='Measured over 300 receipt ticks on stage 9 (rr_runner --harvest-dump): 952 changed 4 KiB pages, 3.9 MB total, at most 9 pages per tick. Tick 1: tile buffer 0x0CE60000..0x0CE62000 + two stage-POL pages 0x0D853000 and 0x0D855000 (stage bank 0x0D82D000 + 0x26000..; the animated props, TCW 0xC12 and 0xC1C); later ticks add the effects POL u/v rewrite (TCW 0xC5B). Matches RECEIPT-RUNNER-RE s1.1/1.2 (training stage: tile buffer + effects u/v + HUD TCW) plus the real-stage animated props the training stage does not have. CONFIRMED (byte compare per tick).';

-- findings
UPSERT finding:runner_gate2_tape_equal SET status='confirmed', text='Runner tape == live agent tape, stage 9 offline match, 301 frames (clock 1716..2016): rows 61 columns (6 slots each) exact except sx[1] sx[2] sy[1] sy[2] on frames 1978 and 2013 (class P: the live value equals the runner value one frame earlier); nodes 1032 records x 27 fields exact except 6 fsx + 2 fsy in the same two frames (frame 1978 is provably mid-walk: nodes 1,2 and both fighters still previous-frame while node 0 is current, and fighter slot 2 reads 44.99935 between 45.0 and 44.65829 = caught between the walker writes); anodes 15911 records: matrix, colour, flags, alpha, model, list all exact, obj 15297/15911; palrows 301 x 48 rows + flags exact; pals equal as window sets; envelope equal except seat_map (runner forces {0,1,-1,-1}, contract C2). 0 unexplained.';
UPSERT finding:agent_object_cache_first_sighting SET status='confirmed', text='CLASS A (new): reader.rs 0.3.44 harvest_anodes caches each world object by pointer + its first 0x68 bytes (0x18 object header + first record header), so an object whose VERTICES the frame regenerates (RECEIPT-RUNNER-RE s1.2 animation callbacks: stage props LAB_14064cb20-style, effects FUN_140625920 u/v) is shipped for the whole match with the bytes of its FIRST SIGHTING, on the live agent and on the runner alike. The 3 differing objects: DC 0x0D853158 (TCW 0xC12, 456 B, 90 distinct phases over 300 ticks; the live bytes are the phase the runner reaches at ticks 72 and 144), DC 0x0D855800 (TCW 0xC1C, 512 B, 264 distinct phases; the live bytes are a phase before the anchor), and a list-7 effect object (TCW 0xC5B, 2280 B, u/v only, 12 frames). Both tapes carry NON-frame-exact vertices for animated props; the runner per-tick DC-RAM is frame-exact from tick 1 (regeneration is absolute). Consequence for the renderer: animated props must be posed from keys (node+0x30/+0x32 phase counters, WORKSTREAM s2 Q3) or the cache must key on content, not header.';
UPSERT finding:runner_gate2_pixels SET status='confirmed', text='rr-render emit of 60 frames from the anchor, live tape vs runner tape: sprite draws 2114/2114 exact (--sprites-only), whole emit exact with --no-world (2114/2114), full emit 34619/34979 draws exact with the 360 differing draws = 6 world draws per frame of textures world_00000C12 and world_00000C1C (the class-A props). Browser (player.html wasm feed, scene-RT sha per frame, gate_tapes.mjs): live vs runner 0/60 equal (the props), live vs runner-with-the-3-class-A-byte-strings-swapped 60/60 byte-equal. A receipt (battle anchor + 4 B of inputs per frame) therefore reproduces the live replay pixel for pixel, the only residual being bytes the live tape itself carries stale.';
UPSERT finding:live_read_mid_walk SET status='confirmed', text='The live agent edge read can land INSIDE the sprite walker FUN_140620f10: on frame 1978 of the stage-9 tape the draw-list read holds node 0 with the new placement, nodes 1-2 and both fighters with the previous placement, and fighter slot 2 with an intermediate screen X (44.99935, between the previous 45.0 and the final 44.65829), while the row read a few microseconds earlier still held 45.0 for the same fighter. Class P covers the whole frame; the runner (post-tick read) has no such frames.';
UPSERT finding:runner_tick_writes_seat_words SET status='confirmed', text='The GGPO tick FUN_140118950 writes the injected inputs to the game_state pads G+0x218/+0x21C: the runner tape seat_in and kcode columns equal the live tape on 301/301 frames with no translation, so the inputs a receipt carries are the inputs the tick leaves in game_state.';

-- edges
RELATE finding:runner_gate2_tape_equal->cites->source:receipt_runner_gate2_20260903 SET id=cites:runner_gate2_tape_equal_src;
RELATE finding:agent_object_cache_first_sighting->cites->source:receipt_runner_gate2_20260903 SET id=cites:agent_object_cache_first_sighting_src;
RELATE finding:runner_gate2_pixels->cites->source:receipt_runner_gate2_20260903 SET id=cites:runner_gate2_pixels_src;
RELATE finding:live_read_mid_walk->cites->source:receipt_runner_gate2_20260903 SET id=cites:live_read_mid_walk_src;
RELATE finding:runner_tick_writes_seat_words->cites->source:receipt_runner_gate2_20260903 SET id=cites:runner_tick_writes_seat_words_src;
RELATE global:dcram_writeset_stage9->cites->source:receipt_runner_gate2_20260903 SET id=cites:dcram_writeset_stage9_src;
RELATE finding:agent_object_cache_first_sighting->refines->global:dcram_writeset_stage9 SET id=refines:agent_object_cache_dcram_writeset, note='the differing objects are exactly the per-tick regenerated pages';
