USE NS re DB kb;

UPSERT source:host_frame_decompiles_20260905 SET kind='disasm', strength='code',
  ref='GhidraMCP :8080 decompiles of FUN_140055D40 (host frame, + disassembly), FUN_140054860 (app init), FUN_1402B3A10, FUN_1402B6A50, FUN_1402BCC60, FUN_1402B9780, FUN_1402B3B80, FUN_1402B6E20, FUN_1402B6D30, FUN_1402B6F30, FUN_1402B9850, FUN_140279AE0, FUN_14027A760, FUN_1402BD3F0, FUN_1402C1590, FUN_1401DB1B0, FUN_14006F5E0; exe_image.bin reads of the vtables 0x1408E3520 (uAppUnit), 0x140924C20, 0x14095D030 and the static class registration at 0x1400277F0.',
  note='Read for SUPERGUN Option A increment 2. The dump globals DAT_142EBCFF8 (0x292994C0), DAT_142EBD9E0 (0x29215B10), DAT_142EBC118 (0x27FC01E0) are all host heap pointers, dead in the runner.';

UPSERT finding:ndraw_frame_protocol SET status='inferred', confidence='high', date='2026-09-05',
  contribution_candidate=true,
  title='The game frame is begin FUN_1402B3A10(nDraw) -> subsystem passes -> FUN_1402B6A50(nDraw) = submit + Present + end; nDraw+0x43 is written by begin-frame from +0x42',
  statement='FUN_140055D40(app) is the host frame: FUN_14025ACB0(); vt+0x30 on ~25 subsystem objects (app+0x40050, +0x3FF80, +0x3FF70 vt+0x48, +0x40068 vt+0x48, +0x40020 vt+0x50, ...); FUN_1402B3A10(*(app+0x3FF60) = nDraw) BEGIN; more vt+0x30 calls; on the filter object *(app+0x3FF78): vt+0x30, vt+0x68, vt+0x58 (disassembly 0x140055E54: rcx only, no rdx -> one-arg methods); nDraw vt+0x30 = FUN_1402B9100; if nDraw+0x43 == 0 then (*(app+0x40020))->vt+0x58(); FUN_1402B6A50(nDraw) PRESENT; FUN_1401E4BB0(*(app+0x40020)). FUN_1402B3A10: FUN_14011F3C0(nDraw+0x58) timer; DAT_142EBCFF8->vt+0x48(); if +0x38 == 0: +0x678C4++ (frame counter), DAT_142EBEA80 = counter, DAT_142EBEA84 = (+0x42 != 0) + 1, +0x678C0 ^= 1 (parity), DAT_142EBCFF8->vt+0x50(), +0x38 = 1, +0x43 = +0x42, if +0x42 { ResetEvent(+0x108); SetEvent(+0x100) }, +0x867940 = FUN_1403714B0(+0x867910[counter%3], 3), +0x867948 = FUN_140371A20(+0x867928[counter%3], 3). FUN_1402B6A50: FUN_14011F370(+0x58); frame limiter only if +0x42 && +0x38 && +0x39 (WaitForSingleObject 0x1408DB350 on +0x108); if +0x43 == 0 { FUN_140371620 the two +0x867940/48 buffers; DAT_142EBCFF8->vt+0x58() }; FUN_1402BCC60(nDraw); lock +0x892F08; for each display i < +0x892EF8: (+0x892EA8 + i*0x30)->Present(+0x867990 vsync, 0) [IDXGISwapChain vt+0x40]; unlock; walk +0x88AE90[0..+0x892E90) for nDraw::ExternalRegion objects (FUN_140396710); FUN_1402B6D30. FUN_1402BCC60: return if +0x38 == 0; if +0x43 == 0 { FUN_1402B3B80(nDraw) [timestamp query begin via FUN_140397050 wrapper vt+0xD8/+0xE0]; lock +0x892F08; FUN_1402B6F30(nDraw) [the opcode walker: cases 0..7,0xE, state setters FUN_1402BC2A0/BA6F0/BA920/BAF60, draws via wrapper vt+0x60/+0x68/+0xA0/+0xA8/+0x148, copies vt+0x170/+0x1C8, UAV vt+0x190/+0x1A8]; unlock; FUN_1402B6E20 } else WaitForSingleObject(+0x108, INFINITE); then GetData (wrapper vt+0xE8) busy-loops on the three timestamp queries at +0x867A38+(counter%3)*0x18; +0x38 = 0. The RenderingThread FUN_1402B9780 loops WaitForSingleObject(+0x100) / ResetEvent / if +0x116 break / if +0x8679C4 == 0 { FUN_1402B3B80; lock; FUN_1402B6F30; unlock; FUN_1402B6E20 } SetEvent(+0x108).',
  consequence='For SUPERGUN (nDraw+0x42 = 0 from increment 1) the game itself sets +0x43 = 0 in begin-frame, so FUN_1402BCC60 executes inline on the calling thread and never waits on the RenderingThread event: single-threaded is the game own mode, no poke. The runner frame becomes: sim tick FUN_140118950 -> FUN_1402B3A10(nDraw) -> the compose pass(es) -> FUN_1402B6A50(nDraw). Both begin and present dereference DAT_142EBCFF8 (texture manager) so that object must exist. IAT for this path beyond seed 181: 0x1408DB350 WaitForSingleObject, 0x1408DB3A0 SetEvent, 0x1408DB3A8 ResetEvent (names: sg_native1/iat_map.txt).';

UPSERT finding:host_app_object_graph SET status='inferred', confidence='high', date='2026-09-05',
  contribution_candidate=true,
  title='App init FUN_140054860 enumerates the host object graph by (size, ctor, args); the render closure objects are named here, not discovered by crashing',
  statement='FUN_140054860(app) allocates and constructs, in order (app slot = u64 index): [0x7FF0] resource manager FUN_1402089E0(0x3A1D0, 0x100000) -> writes DAT_142EBC118 (at 0x140208A90); DAT_142EBD870 = FUN_1402B11A0(0x50); [0x7FEF] app+0x3FF78 filter/scene object FUN_1401DB1B0(0x26E440, 0x20, 0x40) -> DAT_142EBBDF0, 0x40 filter slots named from PTR_s_SystemFilter_140A670D0, six 0x67750-byte render contexts initialised by FUN_1403382E0 (the same struct the nDraw ctor initialises at nDraw+0x170), vtable 0x140924C20 (+0x30 FUN_1401DD130, +0x58 FUN_1401DD310, +0x68 FUN_1401DDA50); [0x7FEC] app+0x3FF60 nDraw FUN_1402B22D0(0x892F30, 0x703, 0x600000, 0x200000, 0x200000, 0x80000, 1, 0, 0x23E) (the factory FUN_1402B2250 passes 2, 0x200000, 0x200000, 0x400000, 0x100000, 2, 0, 0x23E instead -- increment 1 used the factory args); [0x8003] FUN_1400539E0(0x660); [0x8002] FUN_14026A420(0x540, {HWND=*(DAT_142EBCD00+0x148), ...}); [0x8001] FUN_1403330C0(0x4888); [0x7FF1] FUN_1401DDE10(0xD80); [0x7FF5] app+0x3FFA8 SHADER PACKAGE FUN_1402BD3F0(0x6F380, "app/shader/AppShaderPackage", 1) -> DAT_142EBD9E0; [0x7FEE] FUN_1402A46F0(0x38, 0x10000); [0x7FF2] FUN_140056560(0xFB0); [0x7FED] FUN_140335500(0x1668); [0x7FFA] FUN_1402B1500(0xD0); [0x7FFB] FUN_1402AFEF0(0xA78); [0x8006] app+0x40030 TEXTURE MANAGER FUN_140279AE0(0x1440, 0x800) -> DAT_142EBCFF8; [0x8004] FUN_1400526C0(0x280) + vt+0x48; [0x7FF8] FUN_140207C60(0x7088); [0x7FF6] FUN_14006AFD0(0x34AB0, 0); DAT_142EBD7F0 = FUN_1402A4CD0(0x238, 0x600000, 0x400000); DAT_142EBE658 = FUN_14032DA90(0x83C0); DAT_142EBE148 = FUN_1402F8220(0x1F30, 0x40); [0x8020] app+0x40100 HOST DEVICE FUN_140047A20(0xDBD48) = *(0x140ACD3A8); [0x8022] FUN_140057360(0x188); [0x8023] FUN_140064DA0(0x104D80); [0x8024] FUN_140063EC0(0x47C8); [0x8025] FUN_14006CD10(0x40); [0x8026] FUN_140043340(0x121D0); then *(DAT_142EBC8B8+0x50/+0x54) = 60.0f, FUN_14025B350(DAT_142EBC8B8, 1), FUN_14026EF00(DAT_142EBCD00, 1), FUN_140055A40(app). Shader package: FUN_1402BD3F0 loads resource type rShader2 (descriptor PTR_PTR_142EBD628, name at 0x14095C298) through DAT_142EBC118->vt+0x60(mgr, desc, path, 1) and FUN_1402C1590(pkg, res) builds the D3D objects from res+0x78[res+0x80] records (type = rec+0x10 & 0x3F: 0 constant buffer via device->CreateBuffer into pkg+0x66370, 2 technique names incl. FOutputEncode*, 3/10/4/5/6/9 shader objects via FUN_1403BC2E0 / FUN_140385D20 / FUN_1403861B0 / FUN_1403BBE10 / FUN_14039D2C0). FUN_14006F5E0 (the compose pass) is vtable slot +0x68 of class uAppUnit: vtable 0x1408E3520, size 0xE8, class-info 0x140BD3D18, parent class-info 0x142EBC240, registered by the static initializer at 0x1400277F0 (lea rdx "uAppUnit", r9d = 0xE8, call FUN_14011EDF0).',
  consequence='Increment 2 stands on: nDraw (done), texture manager FUN_140279AE0 (needs the shader package: FUN_14027F6A0 reads DAT_142EBD9E0+0x308), shader package FUN_1402BD3F0 (needs the resource manager or a hand-built rShader2 resource from the user own install), host device FUN_140047A20 (retires the --host-gfx staging trio), the filter object FUN_1401DB1B0 and its vt+0x68 FUN_1401DDA50 which reaches FUN_14006F5E0(pass, ctx). The exact resolution of pass/ctx and the shader file location are routed to steam-d3d11-capture-expert; the host device closure to supergun-steam-re-expert (seed 182).',
  caveat='UNKNOWN until those return: FUN_1401DDA50 body (pass/ctx source), the rShader2 file location and format, FUN_140047A20 and FUN_14027F990 bodies (GhidraMCP read timeouts at 5 s on both).';

