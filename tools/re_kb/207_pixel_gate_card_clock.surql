-- 207_pixel_gate_card_clock.surql -- why the SUPERGUN pixel gate disagreed with itself over exactly
-- 304 frames. Forward slashes only in ref/note; no apostrophes. 2026-09-07.
USE NS re DB kb;

UPSERT source:pixel_gate_control_20260907 SET kind='capture', strength='reproduction',
  ref='C:/Users/trist/AppData/Local/Temp/rr_play/gate_main and gate_main2 -- two sg_runner --pixel-hash runs of the same build, flags and 4436-tick script rec4/words.txt; hash.txt and runner.log of each, diffed, not re-run.',
  note='hash.txt differs on exactly frames 715..1018 (304). Frame 714 = frame 1019 = frame 1020 = a3de7305b5dda325 in BOTH runs, so the pre-card and post-card picture is identical and only the card interval moves. runner.log line 34 of gate_main reads STATS: me 76561197999665347 . opp - , so the stats lane was enabled and fetching. The RING line gives the host device base 0x2A1DC010, which places hostdev+0xD0500 at 0x2A2AC510 (lazy page 0x2A2A0000) and hostdev+0xDBD08 at 0x2A2B7D18 (lazy page 0x2A2B0000), confirming both lazy-commit log entries.';

UPSERT source:host_texture_release_static_20260907 SET kind='static', strength='code',
  ref='Ghidra dumpproj / mvc_dump.bin base 0x140000000 via GhidraMCP: FUN_140048890, FUN_140843500, FUN_140843580, FUN_1402702C0, FUN_140272920, FUN_1402705F0; xrefs on 0x140048890, 0x140843500, 0x140607E80, 0x140607B40, 0x1402702C0; vtable 0x14092C8A8 slots 0 and 0x28.',
  note='Register correspondence to the runner crash dump closes the chain: RCX 0x791987A8 = this+0x78, RAX 0 = its vtable word, fault CALL [RAX+0x10] at 0x1402703B3.';

UPSERT finding:pixel_gate_nondeterminism_is_the_card_clock SET confidence='high', date='2026-09-07',
  contribution_candidate=true,
  title='The 304-frame pixel-gate window is the SHELL loading card printing a wall clock, not host residue reaching the draw list',
  statement='sg_runner --pixel-hash disagreed with itself over exactly frames 715..1018 on two runs of the same build, flags and script. CAUSE, read from source and from the two runs own logs: main.rs:4188 sets loading = NOT menu::is_open() AND *(G+2)==2 AND *(G+3)<=2 -- the battle-entry chain -- and main.rs:4194 calls build_loading_card, which draws over the whole window (card_set bleed=true, gfx.rs:1150 the card backdrop, the game frame is only its tunnel) and HIDES the game own VS pages tcw 0x811..0x817 (main.rs:4376). build_loading_card passes stats::status() as CardIn.stats_status (main.rs:3390-3396); menu.rs:293 rasterises it as LOADING . versus . {stats_status}; stats.rs:73 sets that string to stats ok . {chrono_hms()} and stats.rs:81-85 chrono_hms() is GetLocalTime formatted HH:MM:SS. Two runs a minute apart therefore paint DIFFERENT TEXT on every frame the card is up and only on those. The artifacts confirm the shape exactly: frame 714 equals frame 1019 equals frame 1020 equals a3de7305b5dda325 in BOTH runs. The async half is the same lane: stats::snapshot() name, rating, record, streak and city arrive on the sg-stats worker thread (stats.rs:65) over the network, so seat text can differ between runs even after the clock is removed.',
  consequence='Fix at the source, do not exclude the window. (1) Run every pixel gate with --stats-off (main.rs:4818), which pins status() to the constant string stats off and both seats to None. (2) Remove the wall clock from the card row -- keep the timestamp in the log, not in a rasterised string. (3) Make the gate log its own argv. No window exclusion, so a real regression inside the entry chain still fails the gate.',
  ref='supergun/docs/PIXEL-GATE-NONDETERMINISM.md; supergun/supersoaker/runner/sg_runner/src/main.rs:3390,4188,4194,4376,4818; src/menu.rs:293; src/stats.rs:65,73,81',
  status='open';

UPSERT finding:host_texture_slot_release_is_not_in_the_picture SET confidence='high', date='2026-09-07',
  contribution_candidate=true,
  title='0x1400488B5 is the host texture-slot RELEASE read; its value cannot reach the draw list, and it is the same object that faults at 0x1402703B3',
  statement='FUN_140048890(idx): if *(hostdev+0xDBD04)==idx it resets that u32 to 0xFFFFFFFF, then 0x1400488B1 LEA RBX,[hostdev+idx*8] and 0x1400488B5 MOV RCX,[RBX+0xD0500] reads the host texture object for slot idx out of the hostdev table named in finding:load_path_host_texture_creation. NULL means nothing happens; otherwise MOV RAX,[RCX] then CALL [RAX+0x28] (release), then the slot is zeroed. The return value is discarded and nothing else consumes it, so the host pointer is structurally incapable of reaching ctx, blk, dcram or the shell draw list. Callers: FUN_140843580(idx) for one slot, via FUN_1408457E0 from FUN_14060AF70 / FUN_14060B230; and FUN_140843500 for ALL 0x1000 slots then 0x100 palette slots via FUN_140048840, reached through two thunks at 0x140607B40 into 0x140607E80 and installed at game_state+0x20 (0x140AC6D60) by the arena carve FUN_140607B50. BOTH callers zero the ctx slot u16 at ctx+0x1E00A0+idx*0x18 UNCONDITIONALLY, so the create gate reopens whether or not a host object existed and the ctx side effect is a pure function of game state. Vtable slot +0x28 of the base vtable 0x14092C8A8 is FUN_140272920 (deferred release) which tail-calls vtable[0] = FUN_1402705F0, which calls FUN_1402702C0, the nDraw::Texture teardown: it releases the array at this+0x60 and the array at this+0x68 (count this+0x70) elementwise through vt+0x28 and then frees both through the allocator descriptor 0x142EBCE38 (FUN_14011EA90 then vt+0x60), then IUnknown::Release (+0x10) on this+0x78, this+0x80 and this+0xA0, then this+0x50 via vt+0x28 or else this+0x48 and this+0x88, then FUN_140396B40. The measured --restore-regions crash is 0x14027039A MOV RCX,[RBX+0x78] with RCX 0x791987A8, 0x1402703B0 MOV RAX,[RCX] with RAX 0, 0x1402703B3 CALL [RAX+0x10] giving AV READ 0x10: the D3D11 child pointer at this+0x78 was restored from the capture but the object it names has a zero vtable word. So 0x1400488B5 and 0x1402703B3 are the SAME object, one call deep.',
  consequence='The tick-718 coincidence between the lazy-commit log line and the pixel window is COMMON CAUSE -- G+2 becoming 2 fires both the texture teardown and the shell loading card -- not causation. Restoring a captured host-object graph is unsound in principle: this+0x78 and its siblings are D3D11 driver objects belonging to a dead device, so a fixed host allocation cannot make the pixel gate reproducible and --restore-regions turns a benign tick into a fatal one. Without the restore the same read returns 0 from a lazily committed zero page and the release is correctly skipped.',
  ref='GhidraMCP mvc_dump.bin; supergun/docs/PIXEL-GATE-NONDETERMINISM.md; runner lazy-commit pages 0x2A2A0000 and 0x2A2B0000 against host device base 0x2A1DC010',
  status='open';

UPSERT finding:pixel_gate_live_input_pollutes_the_log SET confidence='high', date='2026-09-07',
  contribution_candidate=true,
  title='A --script gate run still samples the real keyboard: it cannot reach the sim, but it ruins that run latency and input statistics',
  statement='gate_main logged 63 chords and 227 presses, gate_main2 logged 0, on the same script and build. main.rs:4149 sets inputs.0 = SCRIPT[SCRIPT_POS] unconditionally and main.rs:4162 forces raw_both to 0 whenever SCRIPT is non-empty, so real presses reach NEITHER the seat words NOR the shell menu -- which is why frames 1019..4434 are byte-identical despite the presses, and which independently rules out live input as the cause of the 715..1018 window. But the input worker still measures them, so INPUT STATS, PRESS to SCANOUT, LATENCY BY MODE and the FRAME COST line of a scripted run are contaminated by whatever the operator did at the desk; the two runs also differed in machine load, 24.8 percent versus 20.6 percent of 32 cores.',
  consequence='Never quote latency numbers from a --script gate run. The gate should either not start the input worker or log a loud warning that input was observed during a scripted run.',
  ref='supergun/supersoaker/runner/sg_runner/src/main.rs:4147,4149,4162; gate_main/runner.log versus gate_main2/runner.log',
  status='open';

RELATE finding:pixel_gate_nondeterminism_is_the_card_clock->cites->source:pixel_gate_control_20260907 SET id='e207_c1', note='the 304-frame set and the 714 equals 1019 equals 1020 equality';
RELATE finding:pixel_gate_live_input_pollutes_the_log->cites->source:pixel_gate_control_20260907 SET id='e207_c2', note='63 chords versus 0 on the same script';
RELATE finding:host_texture_slot_release_is_not_in_the_picture->cites->source:host_texture_release_static_20260907 SET id='e207_c3', note='disassembly and vtable walk';
RELATE finding:host_texture_slot_release_is_not_in_the_picture->cites->source:pixel_gate_control_20260907 SET id='e207_c4', note='host device base 0x2A1DC010 places both lazy pages';

-- the schema asserts a cites edge exists before a finding may be confirmed, so promote LAST
UPDATE finding:pixel_gate_nondeterminism_is_the_card_clock SET status='confirmed';
UPDATE finding:host_texture_slot_release_is_not_in_the_picture SET status='confirmed';
UPDATE finding:pixel_gate_live_input_pollutes_the_log SET status='confirmed';
