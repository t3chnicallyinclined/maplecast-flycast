RELATE finding:steam_blackout_gate_g98->cites:f_steam_blackout_gate_g98_stagedoc->source:doc_stage_draw_ghidra;
UPSERT finding:steam_node_alloc_is_insertion SET statement='FUN_14061dbe0(ctx, L, kind) pops the free list, zeroes 0x280 bytes, writes node+3=L and dispatches PTR_caseD_4_140a6e5c8[kind] (kind 1 = append at tail); DC loc_8c044f12/8c044f26 pop 0x8c287a54, node+3=list, ctor table loc_8c045020[kind]. FUN_14061df40 / loc_8c0450c0 unlink and push back on the free list and clear the draw gate (+0x170 / +0x12C).', status='confirmed', confidence='high', date='2026-09-02', note='Read on both builds during the 2026-09-02 Steam<->SH4 function-map crawl; see docs/STEAM-SH4-FUNCTION-MAP.md and docs/STAGE-DRAW-GHIDRA.md.';
RELATE finding:steam_node_alloc_is_insertion->about:f_steam_node_alloc_is_insertion_steam_routine_FUN_14061dbe0->steam_routine:FUN_14061dbe0;
