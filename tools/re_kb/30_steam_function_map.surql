RELATE finding:steam_deck_drawn_by_direct_call->cites:f_steam_deck_drawn_by_direct_call_stagedoc->source:doc_stage_draw_ghidra;
UPSERT finding:steam_blackout_gate_g98 SET statement='Both builds skip the deck and lists 5/6 when *(G+0x98) != 0 (Steam blk+0x3D50; DC 0x8c2682d8 via mov.w 0x98 in loc_8c030858). The dispatcher also tests *(G+0x2E)==1 to tail-call a post-render routine (DC loc_8c031470).', status='confirmed', confidence='high', date='2026-09-02', note='Read on both builds during the 2026-09-02 Steam<->SH4 function-map crawl; see docs/STEAM-SH4-FUNCTION-MAP.md and docs/STAGE-DRAW-GHIDRA.md.';
RELATE finding:steam_blackout_gate_g98->about:f_steam_blackout_gate_g98_steam_routine_FUN_140620960->steam_routine:FUN_140620960;
