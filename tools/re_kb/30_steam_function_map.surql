UPSERT global:blackout_gate SET addr='0x8C2682D8', steam_off='0x3D50', type='u8', note='G+0x98: when non-zero the deck and lists 5/6 are skipped (super blackout). Read by the render dispatcher on both builds (loc_8c030858 mov.w 0x98; FUN_140620960 *(G+0x98)). Set per frame in FUN_14061f030 from DAT_142edf628+0x96 (STAGE-DRAW-GHIDRA).';
RELATE global:blackout_gate->cites:g_blackout_gate_ghidra->source:ghidra_steam_crawl;
UPSERT global:render_mode SET addr='0x8C26A8E4', steam_off='0x6CE4', type='i32', note='render mode: 0 = match (sprite walk, deck, lists 5-8, HUD), 1 = list 9 only, else lists 7/8/9. Getter loc_8c0310f2 == FUN_140619960.';
RELATE global:render_mode->cites:g_render_mode_ghidra->source:ghidra_steam_crawl;
UPSERT global:deck_colour_rgb SET addr='0x8C26A8A8', steam_off='0x6CA8', type='f32[3]', note='stage deck (model 0) vertex colour r/g/b; DC loc_8c030cfc loads 0x8c26a8a4+4/8/C into fr4/5/6, Steam FUN_140849b00(blk+0x6CA8,0x6CAC,0x6CB0); also multiplies nodes with flag 0x800.';
RELATE global:deck_colour_rgb->cites:g_deck_colour_rgb_ghidra->source:ghidra_steam_crawl;
