UPSERT finding:steam_deck_drawn_by_direct_call SET statement='The stage deck (STGxxPOL model 0) is not a System-A list node on Steam: FUN_140620960 draws it by a direct call FUN_140849c10(*(u64*)PTR_DAT_142edf588) after FUN_14061d7e0 camera, FUN_140847950(0) push, FUN_140847ca0 identity, FUN_140849b00 colour; pop FUN_1408478c0(1). The DC build does the identical sequence in loc_8c030cc0 (8c02e1a4, 8c120950(0), 8c121100, 8c030cfc, 8c1235e0(model0), 8c120900(1)).', status='confirmed', confidence='high', date='2026-09-02', note='Read on both builds during the 2026-09-02 Steam<->SH4 function-map crawl; see docs/STEAM-SH4-FUNCTION-MAP.md and docs/STAGE-DRAW-GHIDRA.md.';
RELATE finding:steam_deck_drawn_by_direct_call->about:f_steam_deck_drawn_by_direct_call_steam_routine_FUN_140620960->steam_routine:FUN_140620960;
