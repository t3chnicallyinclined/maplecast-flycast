-- 23: Steam x86-64 <-> SH4 function correspondence map (programmatic crawl, 2026-09-02).
-- Generated by mvc-live-skins-quarters/d3dcap/replay/re_map/report.py from match_result.json.
-- Idempotent: UPSERT for nodes, RELATE with explicit edge ids for edges (re-running updates in place).
-- APPLY WITH tools/re_kb/apply_seed.py (per statement). This file exceeds the server POST body limit: rekb.sh @file returns
-- 'length limit exceeded' and applies nothing (verified 2026-09-02).
-- Evidence classes: recompiles.confidence = confirmed (both sides read) | high | medium | low (fingerprint / call-graph only).
USE NS re DB kb;
DEFINE TABLE IF NOT EXISTS steam_routine SCHEMALESS COMMENT 'Steam x86-64 function (Ghidra); id=FUN_14xxxxxxx; fields: addr, role, note, blk_reads[], blk_writes[], consts[]';
DEFINE TABLE IF NOT EXISTS recompiles SCHEMALESS COMMENT 'steam_routine -> routine: this x86 function is the recompile of this SH4 routine; fields: confidence(confirmed/high/medium/low), method, evidence';
UPSERT source:ghidra_steam_crawl SET kind='ghidra', strength='code', ref='mvc_dump.bin via :8080 bridge', note='Programmatic crawl of every function of the unpacked Steam MvC2 executable (Ghidra project dumpproj, GhidraMCP HTTP bridge): per-function fingerprints (constants, blk offsets, DC addresses, strings, callees) matched against the marvelous2 SH4 banks. Scripts: mvc-live-skins-quarters/d3dcap/replay/re_map/. Map: docs/STEAM-SH4-FUNCTION-MAP.md + docs/steam_sh4_map.csv.';
