UPSERT finding:steam_stage_struct_piecewise_deltas SET statement='The DC stage/camera struct 0x8C26A518..0x8C26AA54 maps onto Steam blk piecewise: camera block delta 0x8C263C10 (eye +0xC -> blk+0x6914, look-at +0x54 -> 0x695C, fov +0x6C -> 0x6974, near/far +0x80/84 -> 0x6988/8C), deck colour and render mode delta 0x8C263C00 (0x8c26a8a8 -> 0x6CA8, 0x8c26a8e4 -> 0x6CE4), STG_ID delta 0x8C263C58 (0x8c26a95c -> 0x6D04), LayerZ table delta 0x8C263C6C (0x8c26a974 -> 0x6D08). Sub-ranges between those anchors are UNKNOWN; do not extrapolate.', status='confirmed', confidence='high', date='2026-09-02', note='Read on both builds during the 2026-09-02 Steam<->SH4 function-map crawl; see docs/STEAM-SH4-FUNCTION-MAP.md and docs/STAGE-DRAW-GHIDRA.md.';
