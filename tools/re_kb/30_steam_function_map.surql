UPSERT finding:steam_stage_model_table_static SET statement='PTR_DAT_142edf588 -> DAT_142edf630 (352 x u64 host pointers, count at +0xB00, texture header list at +0xB08) is a static table filled by FUN_14060c370(1) -> FUN_14060d8f0 from the POL loaded at DC address 0x0D82D000 (host ram + 0x182D000); the stage data is outside blk. TCW = 0xC10 + texIndex is assigned per record by FUN_140844dc0 after FUN_1408458a0(0xC10).', status='confirmed', confidence='high', date='2026-09-02', note='Read on both builds during the 2026-09-02 Steam<->SH4 function-map crawl; see docs/STEAM-SH4-FUNCTION-MAP.md and docs/STAGE-DRAW-GHIDRA.md.';
