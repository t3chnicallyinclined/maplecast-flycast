-- 205_round_timer_hud_objects.surql -- THE ROUND TIMER on the Steam MvC2 recompile: the running clock
-- byte, its per-frame decrementer, and the HUD DIGIT OBJECTS that are built ONCE per round entry from
-- G+0x4d. Answers why toggling G+0x4d (blk+0x3D05) mid-round changes nothing on screen. 2026-09-07.
-- RE METHOD: whole-image byte scans for the displacement constants 0x32540/0x32541/0x32586/0x32587 and
-- for every RIP-relative reference to DAT_142edf580 (G) / DAT_142edf628 (round record), then Ghidra
-- decompile of each site; globals translated through the block map; CONFIRMED vs INFERRED tagged.
-- Extends finding:steam_training_infinite_time_G_0x4d (seed 197) with the DISPLAY half.
USE NS re DB kb;

UPSERT source:round_timer_hud_re_20260907 SET kind='disasm', strength='code',
  ref='Ghidra dumpproj / mvc_dump.bin (base 0x140000000): FUN_140628320 (round-record pump), FUN_140626fe0 (state 4 clock tick, 0x1406270c5-0x140627145), LAB_140626eb0 (round-start re-init, clock at 0x140626f37-0x140626f7b), FUN_1406274f0 (round-record init, clock at 0x140627562-0x140627599), FUN_140653ee0 / FUN_140653f20 / LAB_140653c90 (timer HUD digit objects), FUN_140620670 (round HUD build), FUN_14060efd0, FUN_140607da0, LAB_14060be10 caseD_3 (0x14060be7b writes 3), FUN_14060b440 (0x14060b4f5 from DAT_142edf22a), FUN_14060b550 (0x14060b696 DAT_142edf22a = 2), FUN_140608690 (0x140608839 literal 2), dispatch tables 0x140a6a248 (G+1) and 0x140a6fa10 (round-record state), value tables DAT_140a6fa70 / DAT_140a6fa74.',
  note='Method receipt: the Ghidra xref list for DAT_142edf580 is INCOMPLETE (it misses code in undefined regions - it did not list 0x14060be7b, the only writer of 3). The exhaustive list of G+0x4d sites was obtained by scanning every 4-byte RIP-relative displacement in the image for the target 0x142edf580 and disassembling a window at each with capstone. The same method proved blk+0x32540 has exactly three code sites.';

UPSERT steam_routine:FUN_140628320_pump SET addr=5375304480, role='Round-record pump (per frame in battle, from caseD_7 0x14060ef2c): rcx = blk + 0x324E0 (the round record), eax = record[0], call PTR_FUN_140a6fa10[eax]. Establishes that the param_1 of the state handlers IS blk+0x324E0, so record+0x60 == blk+0x32540 and record+0x61 == blk+0x32541. State 4 = fighting = FUN_140626fe0.';
UPSERT steam_routine:LAB_140653c90 SET addr=5375626896, role='TIMER DIGIT per-frame handler (object+0x18): reads blk+0x32540 (round seconds), divides by 10 (magic 0x66666667 / sar 2), takes the tens digit when object+0x34 == 0 and the ones digit otherwise, and stores the glyph pointer *(PTR_DAT_142edf598 + 0x2a8 + digit*8) into object+0xa0. This is the ONLY per-frame reader of the round clock in the HUD.';
UPSERT steam_routine:FUN_140653ee0 SET addr=5375627488, role='TIMER HUD BUILDER, called once per round entry from FUN_140620670: if (G+0x4d != 3) FUN_140653f20(0) [the TENS digit object]; always FUN_140653f20(1) [the ONES digit object]; then FUN_140653fd0(0)/(1) (per-side round icons).';
UPSERT steam_routine:FUN_140653f20 SET addr=5375627552, role='Builds one timer digit object: FUN_14061dbe0(0,0x0b,1) (HUD pool list 0x0B), object+0x18 = LAB_140653c90, object+0xa0 = *(PTR_DAT_142edf598 + 0x2a8), position from DAT_140a7a530 + side*0xc, object+0xf0 = 0x10801, object+0x34 = param. THEN, iff G+0x4d == 3, it OVERWRITES object+0x18 with 0x140036560 (a bare RET = no per-frame update) and object+0xa0 with *(PTR_DAT_142edf598 + 0x2f8) (a single fixed glyph, INFERRED the infinity symbol).';
UPSERT steam_routine:FUN_140620670 SET addr=5375227504, role='Round HUD build: zeroes blk+0x329d0..0x329d6 then FUN_1406513e0, FUN_1406521b0, FUN_1406529d0, FUN_140653970, FUN_140653ee0 (the timer). Called from caseD_5 0x14060edbc (battle/round entry) and from FUN_14060efd0 0x14060f05e (training reset).';

RELATE finding:steam_timer_hud_digits_are_built_once_per_round->cites->source:round_timer_hud_re_20260907 SET id='e205_hud_s1';
RELATE finding:steam_round_clock_field_and_decrementer->cites->source:round_timer_hud_re_20260907 SET id='e205_clk_s1';
RELATE finding:steam_round_time_is_not_config_fed->cites->source:round_timer_hud_re_20260907 SET id='e205_cfg_s1';
RELATE finding:supergun_time_row_applies_via_training_reset->cites->source:round_timer_hud_re_20260907 SET id='e205_row_s1';

UPSERT finding:steam_round_clock_field_and_decrementer SET status='confirmed', confidence='high', date='2026-09-07',
  title='The visible round clock is blk+0x32540 (round record +0x60); it is written by exactly three code sites and decremented only in FUN_140626fe0',
  statement='A whole-image byte scan for the displacement 0x32540 finds exactly three code sites: 0x140626f5c (write, round-start re-init inside the state handler at 0x140626eb0), 0x140627578 (write, FUN_1406274f0 round-record init) and 0x140653c9a (read, LAB_140653c90 the digit handler). Both writers store DAT_140a6fa70[G+0x4d] = [30,60,99,99] into blk+0x32540 AND blk+0x32586, and DAT_140a6fa74[G+0x46] = [180,120,90,70] into blk+0x32541 AND blk+0x32587. The only decrement is in FUN_140626fe0 (round-record state 4, dispatched by FUN_140628320 with rcx = blk+0x324E0, once per frame): record+0x61 -= 1; when it reaches 0 and record+0x60 != 0, both point fighters +0x631 increment, then IF (G+0x4d != 3 AND record+0x60 > 0) record+0x60 -= 1 (announcer FUN_140609510(0x18) at 20 and at 10), record+0xa6 decrements UNGATED, and record+0x61 = record+0xa7 = DAT_140a6fa74[G+0x46]. There is no dec/sub byte [reg+0x60] anywhere in the image and no other writer via the record pointer 0x142edf628, so the clock cannot be changed by any path except these.',
  consequence='G+0x4d IS read live, once per clock tick, by the sim - it is not a start-of-round-only setting. Flipping it 3 -> 2 mid-round DOES start blk+0x32540 falling. Rate: one displayed unit per DAT_140a6fa74[G+0x46] frames, so with the anchored G+0x46 = 1 that is 120 frames = 2.0 s per unit at 60 Hz (INFERRED: assumes FUN_140628320 runs exactly once per sim tick; DISPROOF: log blk+0x32540 against the frame counter blk+0x3CC8 for 600 ticks and count the frames between changes).';

UPSERT finding:steam_timer_hud_digits_are_built_once_per_round SET status='confirmed', confidence='high', date='2026-09-07',
  title='The on-screen timer is two HUD objects built ONCE per round entry from G+0x4d; infinite mode builds one object with a bare-RET handler, so a mid-round toggle is invisible',
  statement='FUN_140620670 (round HUD build, called from battle entry caseD_5 0x14060edbc and from the training reset FUN_14060efd0 0x14060f05e) calls FUN_140653ee0, which reads G+0x4d ONCE: if G+0x4d != 3 it creates the TENS digit object, and it always creates the ONES digit object. Each object gets the per-frame handler LAB_140653c90 (read blk+0x32540, pick a digit, set the glyph) - EXCEPT that FUN_140653f20 re-reads G+0x4d at 0x140653f9c and, when it is 3, replaces the handler with 0x140036560 (a bare RET, verified: the byte at 0x140036560 is C3) and the glyph with the single fixed sprite *(PTR_DAT_142edf598+0x2f8). So under infinite time the HUD holds one static sprite with NO per-frame update and no tens digit.',
  consequence='OBSERVED 2026-09-07 in the shell: toggling the training TIME row 3 -> 2 mid-round wrote the byte (logged G+0x4d = 2) and the sim honoured it, but the screen did not change - because the digit objects for that round were already built as the static infinite glyph. The value applies to the SIM immediately and to the DISPLAY only at the next round HUD build. FALSIFICATION TEST for this pair of findings: with a training match running, toggle to 2 and watch blk+0x32540 (EvalExpression [blk+0x32540] on a live target, or a runner log line) - it must start decreasing while the screen stays unchanged.';

UPSERT finding:steam_round_time_is_not_config_fed SET status='confirmed', confidence='high', date='2026-09-07',
  title='No config field feeds G+0x4d - the round-time value has exactly three writers, and the only config-fed timer field is G+0x46 (tick rate) from config+0x294',
  statement='Exhaustive scan of every RIP-relative reference to DAT_142edf580 (G) plus a window disassembly finds all the code sites that touch G+0x4d: WRITE 0x140608839 FUN_140608690 = literal 2; WRITE 0x14060b4f5 FUN_14060b440 = the soft-DIP byte DAT_142edf22a (whose only writer is FUN_14060b550 at 0x14060b696, storing 2 at boot); WRITE 0x14060be7b caseD_3 = literal 3 iff config+0x828 != 0 (training); READ 0x140626f45 (round-start re-init at 0x140626eb0); READ 0x140627562 (FUN_1406274f0); READ 0x1406270f0 (FUN_140626fe0 gate); READ 0x140653eeb and 0x140653f9c (HUD build). The Ghidra xref list for DAT_142edf580 MISSES 0x14060be7b because the caseD_3 body is in an undefined region. FUN_14003fa60 (the host settings loader) writes config+0x284..0x2c8 and FUN_140608690 copies config+0x290 -> G+0x1b, +0x294 -> G+0x46, +0x298 -> G+0x49, +0x2a4 -> G+0x28, +0x4dc -> G+0x4f - none of them reaches G+0x4d.',
  consequence='CORRECTS the peer claim that G+0x4d is a host DIP loaded at FUN_14003fa60 and applied at FUN_140608690. The four-value 30/60/99/infinite reading of G+0x4d is CORRECT (DAT_140a6fa70 = [30,60,99,99] with 3 additionally gating the decrement and swapping the HUD glyph), but the plumbing half is wrong: the host cannot set it through config. The host-settable timer field is G+0x46 = config+0x294 = the tick rate index into [180,120,90,70]. In TRAINING the game forces G+0x4d = 3 at mode entry (one shot: caseD_3 also sets G[0] = 1, leaving state 0), so infinite time is the game own training default - but it is NOT re-forced per round or per reset, so a shell write of 2 survives.';

UPSERT finding:supergun_time_row_applies_via_training_reset SET status='inferred', confidence='high', date='2026-09-07',
  title='The training TIME row should write G+0x4d and then run the game own training reset, which is the only path that makes it visible',
  statement='FUN_140607da0 (= *(game_state+0x28), already used by the runner for the three RESET POSITION rows, main.rs training_tick) calls FUN_14060efd0, which calls BOTH FUN_1406274f0 (re-seeds blk+0x32540 / +0x32541 from DAT_140a6fa70[G+0x4d] / DAT_140a6fa74[G+0x46]) AND FUN_140620670 -> FUN_140653ee0 (rebuilds the timer digit objects with the current G+0x4d). Neither FUN_140607da0 nor FUN_14060efd0 writes G+0x4d, so a shell write survives the reset and is then applied by it. With config+0x838 = 1 the reset does no corner repositioning (FUN_140607da0 only repositions when config+0x838 >= 2).',
  consequence='SUPERGUN main.rs training_act case 9 should, after wr8(blk+0x3D05, v), set TRAIN_RESET = 1 so the existing between-ticks reset path runs - the same code the RESET POSITION CENTRE row already uses. Rule 4 applies: this is the game own function, but it changes the simulation, so the change must be logged as a tape event (config and the reset are outside the GGPO save region) and gated on a battle-entry blk comparison, not on it looking right.';

