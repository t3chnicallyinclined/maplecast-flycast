-- 200_cps_boot_closure_and_rom_layout.surql -- closes the two items seed 178 left UNKNOWN:
-- (1) the machine_start / CPS boot import closure, (2) the arc blob to ROM-region layout.
-- Also corrects three details of seed 178. 2026-09-07.
-- Paths use forward slashes: a backslash in a single-quoted SurrealQL string is an invalid escape.
USE NS re DB kb;

UPSERT source:cps_boot_closure_20260907 SET kind='static', strength='code',
  ref='Ghidra dumpproj / mvc_dump.bin base 0x140000000 (file offset == RVA) via the HTTP bridge on 127.0.0.1:8080, PLUS an independent capstone recursive-descent traversal of the same raw image (scratchpad/closure2.py) that does not use Ghidra function definitions, PLUS raw ARC v7 TOC and IBIS header reads of arc/pc/game_NM.arc (scratchpad/ibis_toc.py, header and size metadata only, no payload extracted).',
  note='Two independent closure tools agree exactly on the MvC2 frame set (29 IAT slots), which is the cross-check that validates the capstone tool. The Ghidra-only BFS silently skipped the CPS driver inits because Ghidra has no function defined at 0x1400fb710 / 0x1400fc080 / 0x1400fc920 / 0x1400fd170 / 0x1400fd9a0 / 0x1400f9630 -- they are reached only through driver_desc+0x20. The capstone traversal covers them.';

UPSERT finding:cps_machine_start_import_closure SET confidence='high', date='2026-09-07',
  contribution_candidate=true,
  title='A CPS machine start reaches EXACTLY the same 29 IAT slots as an MvC2 frame -- zero extra imports; the whole boot path adds only KERNEL32!DebugBreak, and there is NO file I/O import anywhere in it',
  statement='Capstone recursive-descent closure over the raw image. Root set C = FUN_140112200 (machine_start) + FUN_1401135e0 (the CPS start entry FUN_14004b600 calls) + every function reachable only indirectly from them: the two machine_config builders (driver_desc+0x18: 0x1400fb5a0 CPS2, 0x1400f94c0 CPS1), all six driver inits (+0x20: 0x1400fb710 xmcota, 0x1400fc080 msh, 0x1400fc920 xmvsf, 0x1400fd170 mshvsf, 0x1400fd9a0 mvsc, 0x1400f9630 punisher), all six third hooks (+0x28), both video_start bodies (machine_config+0x520: 0x1400f8920 CPS2, 0x1400f88f0 CPS1), screen_update FUN_1400f8c40 (machine_config+0x538) and all four device interfaces (0x140110ed0 dummy, 0x1400b1dc0 m68000, 0x1400f46f0 z80, 0x1400e3b40 sh2). Result: 2707 basic blocks, 787 function entries, 29 absolute/rip-relative indirect call targets. Set C IAT MINUS set A IAT (the MvC2 frame closure) = EMPTY. Set A MINUS set C = EMPTY. The same 29 slots, all in 0x1408db000..0x1408dc000. Root set D = the boot/ROM-load path (FUN_140038280 rom loader, FUN_140112450 region placement, FUN_14004e5c0 start-selected-title, FUN_14003fa60 boot-state copy, FUN_140111d10 load state, FUN_140050830 title selector, FUN_140111f30 machine stop): 2522 blocks, 845 function entries, 30 slots. D MINUS A = exactly one slot, 0x1408db398 = KERNEL32 DebugBreak (resolved by same-boot export resolution in a runner iat_map.txt; the dumped value 0x7ffc8aa04e70 and the map value 0x7ffcd4a74e70 share the same offset from their respective KERNEL32 bases). Its single call site is 0x1402093ef inside FUN_1402093b0, guarded by a test that the refcount at arg2+0x4c is below 1 -- an assertion, never taken on a valid object. THE ANSWER IS FILE-I/O-FREE, NOT file-I/O-only: the actual arc read is NOT a direct import at all. FUN_140038280 issues it as a virtual call through the resource-manager object at the pointer global 0x142ebc118, vtable slot +0x60, with arguments (DAT_142ebc118, &PTR_PTR_140ac6cd0, path_string, 2) -- the same shape as the graphics backend 0x142EBD8F0 in finding:supergun_load_host_boundary. A shell that places the ROM regions itself never calls FUN_140038280 and therefore never touches that object.',
  consequence='The existing SUPERGUN host boundary (29 IAT slots, --heaps, --host-gfx, --noop-import 1408db190,1408db108) is sufficient to run a CPS machine start unmodified. Nothing new needs stubbing. The only additions are the pointer global 0x142ebc118 (only if the shell uses the Capcom async loader instead of doing the memcpy itself) and, optionally, 0x1408db398 pointed at a RET.',
  caveat='Closure is over direct calls plus rip-relative indirect calls. Residual register/struct indirect calls in set C are all in-image dispatch: the CPU instance table 0x1410424A0, the save-state item callback list (call qword [rbx+8] at 0x140116585), the driver_desc+0x18 call (call qword [rbx+0x18] at 0x14011225f), the 68000 and Z80 opcode tables, and the allocator vtable call qword [rax+0x40] at 0x14003acad which is FUN_14003ac90 calling vtable+0x40 on DAT_142e12cf8 -- the allocator registry already in the host boundary.';

UPSERT finding:cps_arc_blob_is_ibis_regions_in_driver_order SET confidence='high', date='2026-09-07',
  contribution_candidate=true,
  title='ROM region placement is a PURE function of the driver table, and the arc blob is an IBIS container whose sub-entry i goes to driver region-list entry i -- a shell can do the whole placement itself with no Capcom code',
  statement='FUN_140112450 is called exactly once, from 0x1400382f5 inside FUN_140038280, and it runs BEFORE the blob has arrived (immediately after the load request is issued). It therefore cannot depend on blob contents. It zeroes config+0x84..0xC8 (the region-id order array) to -1 and config+0xd0..0x1a8, then walks drivers[config+0x44]+0x30 laying regions END TO END from base *(config+0x00), and for the i-th entry writes config+0x84+i*4 = region_id, config+0xd0+id*8 = base, config+0x160+id*4 = size, memsetting each region to 0. Placement = (driver index) only. When the blob arrives, the SAME function FUN_140038280 does: n = FUN_140047920(handle) = the u32 at L+4; for i in 0..n-1 it memcpys from L plus the u32 at L+8+i*8, for the u32 length at L+0xc+i*8, into the region base at config + (the region id at config+0x84+i*4)*8 + 0xd0 -- i.e. IBIS sub-entry i is copied to the i-th entry of the DRIVER REGION LIST, positionally, at the SUB-ENTRY size, never the reserved size. L = handle+0x70 = the decompressed blob; the IBIS header is a 4-byte magic IBIS, a u32 count, then count pairs of u32 offset-from-L and u32 size, and the payload starts at 0x40. MEASURED from the arc TOCs: every bin/ROMSET entry inflates to exactly (sum of sub sizes) + 0x40, the first sub offset is 0x40, and the subs are contiguous -- a straight concatenation in region order with a 0x40 header. CPS2 group A (xmcotaj, xmcotau, mshj, mshh, xmvsfj, xmvsfu, xmvsfjr1, xmvsfur1, xmvsfjr2, xmvsfur2; dsize 0x2c50040): 4 subs = 0x800000 to region 0 (reserved 0x1000000), 0x2000000 to region 4 (reserved 0x2000000), 0x50000 to region 1 (0x50000), 0x400000 to region 10 (reserved 0x800000). CPS2 group B (mshvsfj, mshvsfu, mvscj, mvscu; dsize 0x3050040): same but 0x800000 to region 10, filling it. CPS1 punisherj and punisheru (dsize 0xa50040): 0x400000 to region 0, 0x400000 to region 4, 0x50000 to region 1, 0x200000 to region 10. mvsc2 (game_50.arc, dsize 0x6b6b040): count 1, one sub of 0x6b6b000 into region id 12, whose driver region list 0x1408feeb8 is a SINGLE 0x10000000 entry -- that is the 256 MiB SUPERGUN arena, and the AFS therefore lands at arena+0, which is exactly ctx[0]. THE 0x4050000 vs 0x2c50000 vs 0x3050000 DISCREPANCY IS RESOLVED: the CPS2 driver reserves 0x4050000 but the blob only carries 0x2c50000 or 0x3050000, because region 0 is only half filled (0x800000 of 0x1000000), region 10 is half filled in group A, and region 12 (0x800000) gets NO blob data at all -- 0x4050000 minus 0x3050000 = 0x800000 plus 0x800000 exactly, and 0x4050000 minus 0x2c50000 = 0x800000 plus 0x400000 plus 0x800000 exactly. Region 12 is filled by the CPS2 driver init instead: FUN_1400f7f10 (called first thing by every CPS2 driver init) tests config+0x1ec, and if it is 0 memcpys 0x400000 bytes from region(0)+0x400000 into region(12) and sets config+0x1ec = 1, then calls FUN_140113e80(0, region(0), region(12), 0xffffff) which binds the 68000 to rom base plus DECRYPTED-OPCODE base. Capcom ships the decrypted opcodes as the second 4 MiB of region 0; there is NO CPS2 decryption at runtime. FUN_140038280 resets config+0x1ec to 0 on completion, so a shell must also write config+0x1ec = 0 before machine_start or the opcode copy is skipped.',
  consequence='A SUPERGUN shell can build the entire CPS ROM image from the user own arc with zlib plus a 0x40-byte header read plus four memcpys, and place it with a 20-line reimplementation of FUN_140112450 (or by simply calling FUN_140112450 after setting config+0x44). No Capcom loader, no resource manager, no file-I/O import. BYOR holds: the shell reads the user own game_NM.arc.';

UPSERT finding:cps_ready_to_tick_write_set SET confidence='high', date='2026-09-07',
  contribution_candidate=true,
  title='Putting an already-loaded process into CPS title N revision R ready to tick: call FUN_140050830(hostdev) rather than writing config fields, and clear the frame gate config+0x780',
  statement='FUN_140050830(param_1) is called as FUN_140050830(DAT_140acd3a8) from FUN_14003c130 at 0x14003c190 and from FUN_14003c2b0 at 0x14003c387 -- param_1 IS the host device object *(0x140ACD3A8), so hostdev+0x1ac = game index 0..6 and hostdev+0x1b0 = revision index. It writes THIRTEEN config fields, not the six previously listed: +0x08 game, +0x0c rev, +0x30 = per-game table qword [game*10 + rev] current romset name, +0x38 = per-game table qword [game*10] base romset name, +0x40 = byte at table row +0x30 (0 for all six CPS titles, 1 for MvC2 -- and FUN_140038280 selects config+0x30 when +0x40 is 0, config+0x38 otherwise), +0x44 = FUN_1401120f0(config+0x30) driver index by name, +0x48, +0x4c = FUN_140112030(driver index), +0x50, +0x54, +0x5c, +0x4634, and +0x10 = thunk_FUN_140112610 when game is not 5, NULL when it is. Calling it is strictly preferable to writing fields directly because +0x44 comes from a string lookup over the 14-entry driver table and +0x30 and +0x38 from the per-game table 0x140a4e038. THE FRAME GATE: FUN_140113dd0 returns the int at config+0x780 and thunk_FUN_140112610 runs the frame ONLY if it is 0. Fifteen sites in the image set config+0x780 to a non-zero value (menu and pause overlays), so a shell must explicitly write 0. Other required state: config+0x1ec = 0 (so the CPS2 decrypted-opcode copy runs), config+0x280 = 0xFFFFFFFF (FUN_14004b600 sets this immediately before FUN_1401135e0). The state slot is keyed BY NAME: FUN_140110100 formats the string at 0x1408dd5a0 from config+0x30 and the slot number, and FUN_140112d90 takes the TRAILING DIGIT as the slot index into 0x141083FE0 + digit*0x10000C; on a LOAD (mode 0) it returns NULL if the valid-size u32 at 0x141183FE4 + digit*0x10000C is 0, so an empty slot 0 makes FUN_140111d10(0) a silent no-op and the machine simply runs from 68000 reset. The arc shipped states are named state/ROMSET-1 and -2, i.e. SLOTS 1 AND 2; slot 0 is the runtime anchor.',
  consequence='Ordered minimal write set for a cold shell: (1) place ROM regions; (2) config+0x1ec = 0; (3) hostdev+0x1ac = game, hostdev+0x1b0 = rev, plus config+0x2ac = 0..2 for game 2 only; (4) call FUN_140050830(hostdev); (5) config+0x280 = 0xFFFFFFFF; (6) call FUN_1401135e0(); (7) optionally stage a jacksave into a slot and call FUN_140111d10(slot); (8) config+0x780 = 0; (9) tick FUN_140118950.',
  caveat='config+0x48, +0x50, +0x5c and +0x4634 are copied from the per-game table but their consumers have not been traced; they are covered for free by calling FUN_140050830. Whether FUN_140049b50, FUN_140051150 and switchD_1407f358e caseD_88 (the other calls the two real callers make around FUN_140050830) are needed for a headless tick is UNKNOWN.';

UPSERT finding:cps_savestate_cannot_substitute_for_rom SET confidence='high', date='2026-09-07',
  contribution_candidate=true,
  title='A shipped jacksave alone is NOT a boot: the 0.83 MB state cannot contain the 46-50 MB of ROM regions, and region 12 is derived from region 0 by driver init -- so the cheapest smoke test still needs ROM bytes in place',
  statement='The decompressed state entries in the arcs are 848030 bytes (CPS2) and 823442 bytes (CPS1), while the CPS2 ROM regions total 0x4050000 = 67.4 MB reserved and 0x2c50000 to 0x3050000 = 46.5 to 50.7 MB of actual blob. The state therefore cannot carry ROM, and FUN_140111d10 dispatching to FUN_140110100(2, slot) then FUN_1401162f0 and FUN_140116340 only restores registered items. Region 12 (the CPS2 decrypted opcodes the 68000 fetches through) is not in the blob and not in the state: it is produced by FUN_1400f7f10 as a memcpy from region(0)+0x400000 during driver init. Therefore: (a) restoring a jacksave into slot 0 and ticking is a VALID frame IF AND ONLY IF the ROM regions are already placed -- true in a live process where the Capcom loader ran, false in a cold shell; (b) in a cold shell the ROM placement is unavoidable, but it is cheap (zlib plus a 0x40-byte header plus four memcpys, see finding:cps_arc_blob_is_ibis_regions_in_driver_order) and needs no Capcom code; (c) the jacksave itself is OPTIONAL for a first smoke test, because FUN_140112d90 returns NULL on an empty slot and the machine then runs from 68000 reset through the normal CPS2 boot and attract sequence.',
  consequence='Cheapest it-ticked-and-drew-a-frame experiment: place the ROM regions from the user own arc, run the write set, and tick with slot 0 empty. Second cheapest, and closer to existing machinery: capture a live pre/ anchor while a CPS title is running (the regions live inside the same 256 MiB arena at *(config+0x00) the runner already snapshots) plus the CPS statics -- machine 0x141043890 length 0x178, machine_config 0x141043A10 length 0x560, CPU instance table 0x1410424A0 four times 0x78, device-interface copy 0x140F422F0 length 0x1A0, CPU contexts 0x140F42490 plus slot times 0x20000, the CPS state block pointed to by 0x140CD6350, state slots 0x141083FE0 four times 0x10000C, staging 0x141C88B10 -- and the heap-allocated screen bitmaps from FUN_14010eb40.',
  caveat='The claim that a from-reset CPS2 boot reaches a drawn frame without a save state is INFERRED from the code shape (empty slot gives NULL gives no-op restore) and from MAME behaviour on the same drivers; it has not been run. Test: run the write set with slot 0 valid-size 0 and watch the buffer at *(config+0x1a8) become non-blank over a few hundred ticks.';

-- ---- corrections to seed 178 ----
UPSERT finding:collection_driver_table_is_mame_shaped SET
  caveat='CORRECTION 2026-09-07 (seed 200): the mvsc2 and mvsc2u descriptors are NOT fully NULL at +0x30. Their ROM-region list pointer +0x30 = 0x1408feeb8, a single entry of size 0x10000000 and id 12 -- the 256 MiB arena. Only +0x18, +0x20, +0x28 and +0x38 are NULL. Also measured: the per-game table byte at row+0x30 (to config+0x40) is 0 for games 0,1,2,3,4,6 and 1 for game 5 (MvC2); row+0x33 (settings descriptor) is 2,3,4,5,6,7,8 for games 0..6.';
UPSERT finding:collection_ships_boot_anchors_for_cps SET
  caveat='CORRECTIONS 2026-09-07 (seed 200): (a) FUN_14004e5c0 param_1 is the host device *(0x140ACD3A8), and the boot-state record is at *(hostdev+0xd04b8)+0x5a2f0, reached as FUN_14003fa60(hostdev+0xd04b0, game, rev, slotbuf, out) -- not *(hostdev+8)+0x5A2F0. (b) The slot name format string is at 0x1408dd5a0 and is romset-dash-digit, so the arc entries state/ROMSET-1 and -2 are SLOTS 1 AND 2, and slot 0 is the runtime anchor. (c) FUN_140112ee0 and FUN_140112f30 only expose slots 0..3; the 10-slot keying is FUN_140112d90 only. Original caveat retained: 848030 and 823442 are ARC decompressed sizes, not live totals.';

RELATE finding:cps_machine_start_import_closure->cites->source:cps_boot_closure_20260907 SET id='e200_closure';
RELATE finding:cps_arc_blob_is_ibis_regions_in_driver_order->cites->source:cps_boot_closure_20260907 SET id='e200_layout';
RELATE finding:cps_ready_to_tick_write_set->cites->source:cps_boot_closure_20260907 SET id='e200_writeset';
RELATE finding:cps_savestate_cannot_substitute_for_rom->cites->source:cps_boot_closure_20260907 SET id='e200_nosub';
RELATE finding:cps_machine_start_import_closure->refines->finding:cps_frame_import_surface_equals_mvc2 SET id='e200_r1';
RELATE finding:cps_arc_blob_is_ibis_regions_in_driver_order->refines->finding:cps_emulator_core_map SET id='e200_r2';
RELATE finding:cps_ready_to_tick_write_set->refines->finding:collection_per_title_frame_dispatch SET id='e200_r3';
RELATE finding:cps_savestate_cannot_substitute_for_rom->refines->finding:collection_ships_boot_anchors_for_cps SET id='e200_r4';

UPDATE finding:cps_machine_start_import_closure SET status='confirmed';
UPDATE finding:cps_arc_blob_is_ibis_regions_in_driver_order SET status='confirmed';
UPDATE finding:cps_ready_to_tick_write_set SET status='confirmed';
UPDATE finding:cps_savestate_cannot_substitute_for_rom SET status='confirmed';
