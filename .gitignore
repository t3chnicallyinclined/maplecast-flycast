_oracle/*.jsonl
_oracle/*.ndjson
# Disassembly dumps of the game code (marvelous2 raw .asm) are ROM-derived — never commit.
_oracle/*.asm
# Per-(char,sprite_id) anchor sidecars are ROM-derived (computed from ROM exec).
_oracle/anchors_*.json

# Local RE knowledge-graph SurrealDB data
re_kb_data/

# RE-KB ingestion pipeline artifacts (the .py/.surql in tools/re_kb/ingest/ ARE
# committable; these are rebuildable caches + generated output).
#   cache/     = polite crawler page cache (re-fetched from network only if absent)
#   data/      = extracted JSON (rebuilt by the crawler/parser)
#   generated/ = generated .surql applied to the KB (rebuilt by ingest.py)
tools/re_kb/ingest/cache/
tools/re_kb/ingest/data/
tools/re_kb/ingest/generated/

# Node deps (puppeteer for the render-replica headless verification harness)
node_modules/

