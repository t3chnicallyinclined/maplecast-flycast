build/
build-*/
artifact/

# Python tooling bytecode cache (tools/*.py)
__pycache__/
*.pyc

# Claude Code agent memory + projects state — operator-only context that
# accumulates per-session notes about the codebase. Should never be in
# the public repo. The local copy at ~/.claude/projects/... is unaffected.
.claude/

# Local archive of historical workstream docs. These were active during
# development but contain operator-specific paths, home network IPs, and
# stale topology references that aren't worth scrubbing for public consumption.
# Kept on disk for the original author's context; never committed.
docs-archive/

# Local stick binding cache (NOBD identity bindings, not source)
.maplecast/

# Savestates, ROMs, and game saves are NEVER committed.
# Dreamcast/Naomi ROMs are copyrighted — committing them would be a DMCA
# event and pollute git history forever (filter-repo is the only fix).
# *.state catches Flycast savestates regardless of where they sit;
# savestates/ catches the canonical directory wholesale (including
# VMU saves). Disc image extensions cover Dreamcast (.gdi/.cdi/.chd),
# generic optical (.iso/.cue/.nrg/.mdf/.mds/.ccd/.img), and the top-level
# roms/ folder names catch staged ROM directories before they land.
# NOTE: tests/files/test_gdis/ predates this rule and is upstream flycast
# parser test fixtures (dummy bytes, not real ROMs). Leave tracked.
savestates/
*.state
*.sav
*.eeprom
*.nvmem
*.nvmem2
*.gdi
*.cdi
*.chd
*.iso
*.cue
*.nrg
*.mdf
*.mds
*.ccd
*.img
*.DCI
*.dci
*.VMI
*.vmi
# Dreamcast BIOS / flash firmware dumps (copyrighted)
dc_boot.bin
dc_flash.bin
# Copyrighted ROM disc dumps sometimes dropped in the repo root during dev
# (e.g. the MVC2 GD-ROM zip used for sprite-format RE on 2026-06-04).
Marvel vs. Capcom 2*.zip
roms/
ROMs/
rom/

# Never commit SYMLINKS into savestates/ or roms/ either — git stores the
# symlink target as a string, so while it won't leak ROM bytes, it DOES
# bake an absolute host path into history that means nothing to anyone else
# (see web/mvc2.state incident, removed 2026-04-14).

# Extracted game art / cached visual data — these are derived from
# copyrighted ROM content and must not ship in the public repo.
# visual_cache/ holds the per-frame character animation extractions
# (was 2 GB of MVC2 sprite frames at one point).
# web/rend_textures/ and web/textures/ are MVC2 .rgba texture dumps
# (~2400 files combined).
# web/sprites/ holds the MVC2 character roster portrait PNGs (Capcom /
# Marvel character art — copyrighted on multiple axes).
visual_cache/
web/rend_textures/
web/textures/
web/sprites/

# Community RE tools + extracted MVC2 dev/disc files (ROM-derived / copyrighted /
# third-party tool code with unclear license) — used for sprite-format RE, never
# committed. Added 2026-06-05.
dasm_PLDAT/
MVC2 Dev Files/
sh4_asm/
# marvelous2 = full SH4 disassembly of MVC2 DC (github.com/mountainmanjed/marvelous2).
# Its build/ reassembles to the ROM and the whole thing is disassembled copyrighted
# code. Cloned locally as a reference only — NEVER commit. Added 2026-06-05.
marvelous2/
*_HITBOX_*.BIN
PL[0-9A-Fa-f][0-9A-Fa-f]_*.BIN
1ST_READ.BIN
mvc2.webp
*.webp

