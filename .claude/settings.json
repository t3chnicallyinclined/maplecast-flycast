{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep|Read|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONIOENCODING=utf-8 python \"${CLAUDE_PROJECT_DIR:-.}/tools/re_kb/hooks/kb_lookup.py\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "checking re_kb"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONIOENCODING=utf-8 python \"${CLAUDE_PROJECT_DIR:-.}/tools/re_kb/hooks/kb_digest.py\" 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "carrying re_kb facts across compaction"
          }
        ]
      }
    ]
  }
}
