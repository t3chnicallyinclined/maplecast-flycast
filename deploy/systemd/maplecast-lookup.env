# MapleCast Option 6 lookup-renderer sandbox — operator-editable env.
#
# Install location: /etc/maplecast/lookup.env
# Owned by root, readable by the maplecast-lookup user.
#
# This is loaded by maplecast-lookup.service. Any var here overrides the
# in-unit defaults. Deliberately separate file from /etc/maplecast/headless.env
# so editing one never touches the other.

MAPLECAST=1
MAPLECAST_MIRROR_SERVER=1
MAPLECAST_HEADLESS=1

# Ports — offset +50 from production. The lookup mirror WS at 7250 is
# loopback-only by default (no nginx hop, no relay); attach with
# `ssh -L 7250:127.0.0.1:7250 root@nobd.net` for local browser inspection.
MAPLECAST_PORT=7150
MAPLECAST_SERVER_PORT=7250
MAPLECAST_CONTROL_PORT=7251

# ROM path — SHARED with production (read-only). The maplecast-lookup user
# is granted read access via group membership; flycast never writes here.
MAPLECAST_ROM=/opt/maplecast/roms/mvc2.gdi

# Option 6 toggles. Default state for a fresh sandbox: cache recording on,
# scanner off (run manually via systemctl edit override when ready),
# lookup test off (used during Phase 2 verification).
MAPLECAST_VISUAL_CACHE=1
# MAPLECAST_SCAN=1
# MAPLECAST_LOOKUP_TEST=1

# Visual cache writes go to /opt/maplecast-lookup/visual_cache (set as the
# CWD via WorkingDirectory in the unit; flycast init() uses a relative path).
# To grow the cache off-disk, mount a separate volume there.
