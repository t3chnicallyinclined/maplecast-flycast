# MapleCast Option 6 lookup-renderer sandbox — operator-editable env.
#
# Install location: /etc/maplecast/lookup.env
# Owned by root, readable by the maplecast-lookup user.
#
# This is loaded by maplecast-lookup.service. Any var here overrides the
# in-unit defaults. Deliberately separate file from /etc/maplecast/headless.env
# so editing one never touches the other.

MAPLECAST=1
MAPLECAST_MIRROR_SERVER=1
MAPLECAST_HEADLESS=1

# Ports — offset +50 from production. The lookup mirror WS at 7250 is
# loopback-only by default (no nginx hop, no relay); attach with
# `ssh -L 7250:127.0.0.1:7250 root@nobd.net` for local browser inspection.
MAPLECAST_PORT=7150
MAPLECAST_SERVER_PORT=7250
MAPLECAST_CONTROL_PORT=7251
# Tape publisher port. Production uses 7101; sandbox needs its own slot or
# the input-server logs "Address already in use (tape disabled)" at boot.
MAPLECAST_TAPE_PORT=7151

# Per-instance shm name — KEEP DIFFERENT FROM PROD's "/maplecast_mirror".
# openShm() unconditionally shm_unlink()s the name before recreate, so a
# same-name collision could destroy production's shm region. The maplecast-
# lookup user lacks the perms to do that to /dev/shm/maplecast_mirror today,
# but if the sandbox ever runs as a privileged user this is the explicit
# guardrail.
MAPLECAST_SHM_NAME=/maplecast_lookup_mirror

# ROM path — SHARED with production (read-only). The maplecast-lookup user
# is granted read access via group membership; flycast never writes here.
MAPLECAST_ROM=/opt/maplecast/roms/mvc2.gdi

# MVC2 attract-mode SH4 reset crashes flycast at ~75 seconds (DEPLOYMENT.md
# gotcha #11). The fix: drop a savestate at $XDG_DATA_HOME/flycast/mvc2.state
# (which the deploy provisioning step copies from prod) and set this env var
# so the autoloader picks it up at boot. The flycast emu.cfg AutoLoadState
# flag is silently ignored on the headless build, so this env var is the
# only escape hatch.
MAPLECAST_HEADLESS_AUTOLOAD=1

# Headless production stability bypass. Commit 435e44618 fixed three crashes
# that surfaced once flycast started running unattended on the VPS; without
# this flag the SH4 takes a SIGSEGV ~380ms after spawning the emu thread.
# Production has it set; the sandbox needs it too. Keep in sync.
MAPLECAST_HEADLESS_DISABLE_SYS_MISC_1=1

# Option 6 toggles. After the Phase 2 pivot to TA-buffer dedup (Pivot A,
# see docs/OPTION6-MASTER-PLAN.md), the visual_cache state-keyed approach
# is mothballed (0% hit rate, 5.7 GB / 10 min play). The new dedup path
# uses MAPLECAST_TA_DEDUP — server hashes each frame's TA buffer, emits
# REUSE(hash) when the hash matches a recent ring entry instead of
# re-shipping the full TA delta.
#
# MAPLECAST_VISUAL_CACHE intentionally LEFT OFF — the old visual_cache code
# stays compiled in (under MAPLECAST_LOOKUP) but recordFrame() short-circuits
# without disk writes when init() is never called. Don't re-enable.
# MAPLECAST_VISUAL_CACHE=1
# MAPLECAST_SCAN=1
# MAPLECAST_LOOKUP_TEST=1

# Pivot A — TA-buffer dedup. Default OFF in prod (still being validated).
# Sandbox enables it to measure hit rate + bandwidth savings.
MAPLECAST_TA_DEDUP=1

# Visual cache writes go to /opt/maplecast-lookup/visual_cache (set as the
# CWD via WorkingDirectory in the unit; flycast init() uses a relative path).
# To grow the cache off-disk, mount a separate volume there.
